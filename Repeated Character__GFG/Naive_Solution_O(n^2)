
class Solution {
    char firstRep(String S) {
    
        int n = S.length();                         // Store length of string
        
        for(int i=0;i<n;i++){                       // Pick each character one by one
            for(int j=i+1;j<n;j++){                 // Compare with every character ahead
                if(S.charAt(i) == S.charAt(j)){     // Match found — first repeating character
                    return S.charAt(i);             // Return the repeating character
                }
            }
        }
        return '#';                                 // No repeating character found
    }
}

