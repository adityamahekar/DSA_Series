
class Solution {
    char firstRep(String S) {
       
       boolean visit[] = new boolean[256];          // Track visited characters
       char res = '#';                              // Default result if no repeat found
       
       Arrays.fill(visit, false);                   // Initialize all as not visited
       
       for(int i=S.length()-1;i>=0;i--){           // Traverse string from right to left
           
           if(visit[S.charAt(i)]){                  // Character already seen — it's repeating
               res = S.charAt(i);                   // Update res — leftmost repeat from right pass
           }
           
           else{                                    // Character seen for first time
               visit[S.charAt(i)] = true;           // Mark as visited
           }
       }
        return res;                                 // Return first repeating character
    }
}
```

