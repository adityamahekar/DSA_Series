class Solution {
    char firstRep(String S) {
        int ch[] = new int[256];                    // Array to store first index of each character
        int res = Integer.MAX_VALUE;                // Stores minimum first occurrence index
        
        Arrays.fill(ch,-1);                         // Initialize all positions with -1 (not seen)
        
        for(int i=0;i<S.length();i++){              // Traverse string once
            
            int fi = ch[S.charAt(i)];              // Get stored index of current character
            
            if(fi == -1){                           // Character seen for first time
                ch[S.charAt(i)] = i;               // Store its first occurrence index
            }
            else{                                   // Character seen before — it's repeating
                res = Math.min(res, fi);            // Update res with smallest first occurrence
            }
        }
        
        return (res == Integer.MAX_VALUE) ? '#' : S.charAt(res);  // Return first repeating char or '#'
    }
}
