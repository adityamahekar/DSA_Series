
class Solution {
    char firstRep(String S) {
        int count[] = new int[256];                 // Frequency array for all ASCII characters

        for(int i=0;i<S.length();i++){              // First pass — count frequency of each character
            count[S.charAt(i)]++;                   // Increment count for current character
        }

        for(int i=0;i<S.length();i++){              // Second pass — find first repeating character
            if(count[S.charAt(i)] > 1){             // Frequency > 1 means character repeats
                return S.charAt(i);                 // Return first repeating character
            }
        }
        return '#';                                 // No repeating character found
    }
}
```

