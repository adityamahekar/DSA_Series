/*
class Node
{
    int data;
    Node next;
    Node(int d) {
        data = d;
        next = null;
    }
}
*/

class Solution {
    Node sortedMerge(Node head1, Node head2) {

        Node head = null, tail = null;
        
        if (head1 == null) { return head2; }                // Edge case: list1 empty
        if (head2 == null) { return head1; }                // Edge case: list2 empty
        
        // Initialize head and tail with smaller first node
        if (head1.data <= head2.data) {
            head = tail = head1;                            // Pick head1 as start
            head1 = head1.next;                             // Move head1 forward
        } else {
            head = tail = head2;                            // Pick head2 as start
            head2 = head2.next;                             // Move head2 forward
        }
        
        // Merge remaining nodes by comparing values
        while (head1 != null && head2 != null) {
            if (head1.data <= head2.data) {
                tail.next = head1;                          // Attach smaller node (head1)
                tail = head1;                               // Update tail
                head1 = head1.next;                         // Move head1 forward
            } else {
                tail.next = head2;                          // Attach smaller node (head2)
                tail = head2;                               // Update tail
                head2 = head2.next;                         // Move head2 forward
            }
        }
        
                                                            // Attach remaining nodes from non-empty list
        if (head1 == null) { tail.next = head2; }           // List1 has remaining nodes
        else { tail.next = head1; }                         // List2 has remaining nodes
        
        return head;                                        // Return merged list head
    }
}

