class Solution {
    
    static int prec(char c){                    // Returns operator precedence
        if(c == '^') return 3;
        if(c == '*' || c == '/') return 2;      // * / higher than + -
        if(c == '+' || c == '-') return 1;
        return -1;
    }
    
    public static String infixToPostfix(String s) {
       Stack<Character> st = new Stack<>();        // Stack for operators
       StringBuilder  sb = new StringBuilder();    // Result postfix string
       
       for(char c : s.toCharArray()){              // Scan each character
           
           if(c == '(') st.push(c);               // Push opening bracket
           
           else if(c == ')') {                     // Pop till matching '('
               while(!st.isEmpty() && st.peek() != '('){
                   sb.append(st.pop());
               }
               st.pop();                           // Remove '('
           }
           
           else if(Character.isLetterOrDigit(c)) sb.append(c);  // Output operand
           
           else{                                   // Operator case
               while(!st.empty() && st.peek() != '(' && 
                     (prec(c) < prec(st.peek()) ||                 // Lower precedence
                     (prec(c) == prec(st.peek()) && c != '^'))){   // Left associative
                   sb.append(st.pop());
               }
               st.push(c);                         // Push current operator
           }
       }
       
       while(!st.isEmpty()) sb.append(st.pop());   // Pop remaining operators
       
       return sb.toString();
    }
}

