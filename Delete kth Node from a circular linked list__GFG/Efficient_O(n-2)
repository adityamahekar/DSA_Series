//////////////////////// CODE ////////////////////////////////

Node DeleteCLL(Node head, int k) {
    if (head == null) return null;                                // Handle empty list
    if (head.next == head) {                                      // Check single node
        return (k == 1) ? null : head;                            // Delete if k==1, else return same
    }
    Node curr = head;                                             // Start traversal from head
    if (k == 1) {                                                 // Deleting first node?
        int j = curr.data;                                        // Swap: store head's data
        curr.data = curr.next.data;                               // Swap: copy next's data to head
        curr.next.data = j;                                       // Swap: put old head data in next
        curr.next = curr.next.next;                               // Skip the next node (deleted)
    } else {                                                      // Deleting node at position k>1
        for (int i = 0; i < k - 2; i++) {                         // Move to (k-1)th node
            curr = curr.next;                                     // Traverse forward
        }
        curr.next = curr.next.next;                               // Link around k-th node (delete)
    }
    return head;                                                  // Return modified list head
}


