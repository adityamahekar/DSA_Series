Node DeleteCLL(Node head, int k) {
    if (head == null) {                        // if list is empty
        return null;                           // nothing to delete
    }
    if (head.next == null) {                   // if only one node
        return (k == 1) ? null : head;         // k=1 delete it, else return as is
    }
    if (k == 1) {                              // if head needs to be deleted
        Node temp = head;                      // start from head
        while (temp.next != head) {            // traverse to last node
            temp = temp.next;                  // move forward
        }
        temp.next = head.next;                 // last node points to 2nd node
        return head.next;                      // 2nd node becomes new head
    }
    Node curr = head;                          // start from head
    int i = 1;                                 // position counter
    do {
        if (k == i + 1) {                      // if next node is kth node
            int j = curr.data;                 // store curr data
            curr.data = curr.next.data;        // bring next data to curr
            curr.next.data = j;                // push curr data to next
            curr.next = curr.next.next;        // unlink next node
            break;                             // deletion done
        }
        curr = curr.next;                      // move to next node
        i++;                                   // increment position
    } while (curr != head);                    // stop when full circle done
    return head;                               // return updated head
}

