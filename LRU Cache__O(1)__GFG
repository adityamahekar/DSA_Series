class Node {
    int key;
    int value;
    Node next;
    Node prev;
    
    Node(int k, int v) {
        key = k;
        value = v;
        next = null;
        prev = null;
    }
}

class LRUCacheCorrect {
    
    private int capacity;
    private java.util.HashMap<Integer, Node> map;
    private Node head;
    private Node tail;
    
    LRUCacheCorrect(int cap) {
        capacity = cap;
        map = new java.util.HashMap<>();
        
        head = new Node(-1, -1);
        tail = new Node(-1, -1);
        head.next = tail;
        tail.prev = head;
    }
    
    // Remove node from doubly linked list
    private void remove(Node node) {
        node.prev.next = node.next;
        node.next.prev = node.prev;
    }
    
    // Add node right after head (most recently used)
    private void add(Node node) {
        node.next = head.next;
        node.prev = head;
        head.next.prev = node;
        head.next = node;
    }
    
    public int get(int key) {
        
        if (!map.containsKey(key)) {                      // Key not found
            return -1;
        }
        
        Node node = map.get(key);                         // Get node
        
        remove(node);                                     // Remove from current position
        add(node);                                        // Add to front (mark as recently used)
        
        return node.value;                                // Return value
    }
    
    public void put(int key, int value) {
        
        if (map.containsKey(key)) {                       // Key already exists
            Node oldNode = map.get(key);
            remove(oldNode);                              // Remove old node
            map.remove(key);
        }
        
        if (map.size() >= capacity) {                     // Cache is full
            Node lru = tail.prev;                         // Least recently used (before tail)
            remove(lru);                                  // Remove from list
            map.remove(lru.key);                          // Remove from map
        }
        
        Node newNode = new Node(key, value);              // Create new node
        add(newNode);                                     // Add to front
        map.put(key, newNode);                            // Add to map
    }
}

