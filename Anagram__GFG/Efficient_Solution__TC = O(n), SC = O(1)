
class Solution {
    public static boolean areAnagrams(String s1, String s2) {
        int CH = 256;                               // Total ASCII characters
        int count[] = new int[CH];                  // Frequency array of size 256
        
        if(s1.length() != s2.length()){             // Early exit — different lengths can never be anagrams
            return false;
        }
        
        for(int i=0;i<s1.length();i++){             // Traverse both strings simultaneously
            count[s1.charAt(i)]++;                  // Increment count for s1 character
            count[s2.charAt(i)]--;                  // Decrement count for s2 character
        }
        
        for(int i=0;i<CH;i++){                      // Check all 256 frequency values
            if(count[i] != 0){                      // Non-zero means mismatch found
                return false;
            }
        }
        return true;                                // All counts zero — it's an anagram!
    }
}


