class Solution {
    public static boolean areAnagrams(String s1, String s2) {
        
        if(s1.length() != s2.length()){           // Early exit — different lengths can never be anagrams
            return false;
        }
        
        char c1[] = s1.toCharArray();             // Convert s1 into character array
        char c2[] = s2.toCharArray();             // Convert s2 into character array
        
        Arrays.sort(c1);                          // Sort c1 array alphabetically
        Arrays.sort(c2);                          // Sort c2 array alphabetically
        
        s1 = new String(c1);                      // Rebuild s1 from sorted char array
        s2 = new String(c2);                      // Rebuild s2 from sorted char array
        
        return s1.equals(s2);                     // Compare sorted strings — true if anagram
    }
}

