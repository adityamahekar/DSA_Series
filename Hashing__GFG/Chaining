
class Solution {
    public ArrayList<ArrayList<Integer>> separateChaining(int hashSize, int[] arr) {

        ArrayList<ArrayList<Integer>> list = new ArrayList<ArrayList<Integer>>(); // Initialize the main list to hold hash buckets

        int hs = hashSize, n = arr.length;                                        // Store hash size and array length

        for (int i = 0; i < hs; i++) {                                            // Create 'hashSize' empty buckets
            list.add(new ArrayList<>());                                          // Add empty list for each bucket
        }

        for (int i = 0; i < n; i++) {                                             // Iterate through each element in arr
            int idx = arr[i] % hs;                                                // Compute hash index using modulo
            list.get(idx).add(arr[i]);                                            // Insert element into corresponding bucket
        }

        return list;                                                               // Return the complete hash table
    }
}

