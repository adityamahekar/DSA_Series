import java.util.*;

class Solution {
    public ArrayList<Integer> bellmanFord(int V, int[][] edges, int src) {
        final int INF = 100000000;                                           // treat as infinity
        int[] dist = new int[V];
        Arrays.fill(dist, INF);                                              // all nodes unreachable at start
        dist[src] = 0;                                                       // distance to source is 0

        for (int i = 1; i < V; i++) {                                        // relax all edges V-1 times
            boolean updated = false;
            for (int[] e : edges) {
                int u = e[0], v = e[1], w = e[2];
                if (dist[u] != INF && dist[u] + w < dist[v]) {
                    dist[v] = dist[u] + w;                                   // shorter path found
                    updated = true;
                }
            }
            if (!updated) break;                                             // nothing changed, stop early
        }

        for (int[] e : edges) {                                              // extra pass: catch negative cycle
            int u = e[0], v = e[1], w = e[2];
            if (dist[u] != INF && dist[u] + w < dist[v]) {
                return new ArrayList<>(List.of(-1));                         // negative cycle found
            }
        }

        ArrayList<Integer> result = new ArrayList<>();
        for (int d : dist) result.add(d);
        return result;
    }
}

