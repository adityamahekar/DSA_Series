//////////////////////// CODE ////////////////////////////////

class Solution {

    class Node {
        int freq;                          // Stores frequency
        int idx;                           // Stores original character index
        Node left, right;                  // Left and right child nodes

        Node(int freq, int idx) {
            this.freq = freq;              // Initialize frequency
            this.idx = idx;                // Initialize index
        }
    }

    public ArrayList<String> huffmanCodes(String s, int f[]) {

        PriorityQueue<Node> pq = new PriorityQueue<>((a, b) -> {
            if (a.freq != b.freq)
                return a.freq - b.freq;     // Sort by frequency
            return a.idx - b.idx;           // Earlier character first
        });

        for (int i = 0; i < s.length(); i++) {
            pq.add(new Node(f[i], i));      // Insert character nodes
        }

        while (pq.size() > 1) {             // Merge until one node remains

            Node a = pq.poll();             // Remove smallest node
            Node b = pq.poll();             // Remove second smallest node

            Node parent = new Node(a.freq + b.freq,
                    Math.min(a.idx, b.idx)); // Create parent node

            parent.left = a;                // Assign left child
            parent.right = b;               // Assign right child

            pq.add(parent);                 // Insert merged node
        }

        ArrayList<String> res = new ArrayList<>(); // Store Huffman codes

        preorder(pq.poll(), "", res);       // Generate codes using preorder

        return res;                         // Return all Huffman codes
    }

    void preorder(Node root, String code, ArrayList<String> res) {

        if (root == null)
            return;                         // Base case

        if (root.left == null && root.right == null) { // Check leaf node
            res.add(code.isEmpty() ? "0" : code); // Store generated code
            return;                         // Stop recursion
        }

        preorder(root.left, code + "0", res);  // Left subtree gets 0
        preorder(root.right, code + "1", res); // Right subtree gets 1
    }
}

