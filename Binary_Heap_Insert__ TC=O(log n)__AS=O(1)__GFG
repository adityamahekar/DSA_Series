void insert(int x) {                                                     // insert x into the min-heap
    if (size == capacity) { return; }                                  // heap full, nothing to do

    size++;                                                          // increase size
    arr[size - 1] = x;                                               // place x at the last position

    for (int i = size - 1; i != 0 && arr[parent(i)] > arr[i]; ) {   // while parent is bigger
        swap(arr[parent(i)], arr[i]);                               // swap child with parent
        i = parent(i);                                             // move up to the parent
    }
}

