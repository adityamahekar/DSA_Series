
class Solution {
    public ArrayList<Integer> frequencyCount(int[] arr) {

        ArrayList<Integer> list = new ArrayList<>();        // stores frequency results
        int n                   = arr.length;               // total number of elements
        int flag[]              = new int[n];               // tracks visited elements
        Arrays.fill(flag, -1);                              // -1 = unvisited, 1 = visited

        for (int i = 0; i < n; i++) {

            if (flag[i] != -1) { continue; }               // skip already counted duplicates

            int count = 1;                                  // count self as first occurrence
            flag[i]   = 1;                                  // mark current element as visited

            for (int j = i + 1; j < n; j++) {              // scan all elements after i

                if (arr[i] == arr[j] && flag[j] == -1) {   // found unvisited duplicate
                    flag[j] = 1;                            // mark duplicate as visited
                    count++;                                // increment frequency count
                }
            }

            list.add(count);                                // add final frequency to result
        }

        return list;                                        // return frequencies in order
    }
}

