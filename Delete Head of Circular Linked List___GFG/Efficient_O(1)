//////////////////////// CODE ////////////////////////////////

/*
class Node {
    int data;
    Node next;
    Node(int x) {
        data = x;
        next = null;
    }
}
*/

class Solution {
    Node deleteNode(Node head, int key) {

        if (head == null || head.next == null) {    // empty or single node
            return null;
        }

        head.data = head.next.data;                 // copy next node's data into head
        head.next = head.next.next;                 // skip next node (delete it)

        return head;                                // head unchanged, return it
    }
}


