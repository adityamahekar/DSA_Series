class Solution {
    static int kruskalsMST(int V, int[][] edges) {
        Arrays.sort(edges, (a, b) -> a[2] - b[2]); // Sort by weight

        int[] parent = new int[V];                 // Parent array
        int[] rank = new int[V];                   // Rank array

        for (int i = 0; i < V; i++) {
            parent[i] = i;                         // Initialize parent
        }

        int sum = 0;                               // MST weight
        int count = 0;                             // Selected edges

        for (int[] edge : edges) {
            int u = edge[0];                       // First vertex
            int v = edge[1];                       // Second vertex
            int w = edge[2];                       // Edge weight

            int pu = find(parent, u);              // Find parent of u
            int pv = find(parent, v);              // Find parent of v

            if (pu != pv) {                        // Check for cycle
                sum += w;                          // Add edge weight
                union(parent, rank, pu, pv);       // Merge both sets
                count++;                           // Increment edge count

                if (count == V - 1) break;         // Stop after MST
            }
        }

        return sum;                                // Return MST weight
    }

    static int find(int[] parent, int x) {
        if (parent[x] != x) {
            parent[x] = find(parent, parent[x]);   // Path compression
        }
        return parent[x];                         // Return root
    }

    static void union(int[] parent, int[] rank, int u, int v) {
        if (rank[u] < rank[v]) {
            parent[u] = v;                        // Attach u to v
        }
        else if (rank[u] > rank[v]) {
            parent[v] = u;                        // Attach v to u
        }
        else {
            parent[v] = u;                        // Merge both sets
            rank[u]++;                            // Increase rank
        }
    }
}

