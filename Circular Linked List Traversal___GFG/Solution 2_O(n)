/* Node of a linked list
 class Node{
    int data;
    Node next;
    Node(int x){
        data = x;
        next = null;
    }
}
*/

class Solution {
    void printList(Node head) {                                 // Function to print circular linked list

        if(head == null){                                       // Edge case: empty list
            return;                                             // Nothing to print, exit
        }

        Node curr = head;                                       // Start from head

        System.out.print(curr.data + " ");                      // Print head node first (before loop)

        for(curr = head.next; curr != head; curr = curr.next){  // Start from head.next, loop until back at head
            System.out.print(curr.data + " ");                  // Print each remaining node
        }
    }
}


