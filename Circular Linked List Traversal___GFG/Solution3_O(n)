/* Node of a linked list
 class Node{
    int data;
    Node next;
    Node(int x){
        data = x;
        next = null;
    }
}
*/

class Solution {
    void printList(Node head) {

        if(head == null){                           // Edge case: empty list
            return;                                 // Nothing to print, exit
        }

        Node cur = head;                            // Start from head

        do{                                         // do-while: runs body FIRST, checks condition AFTER
            System.out.print(cur.data + " ");       // Print current node's data
            cur = cur.next;                         // Move to next node
        }while(cur != head);                        // Stop when we loop back to head
    }
}

