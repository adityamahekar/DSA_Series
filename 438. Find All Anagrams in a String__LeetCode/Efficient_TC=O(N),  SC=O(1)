class Solution {

    boolean same(int cs[], int cp[]) {
        for (int i = 0; i < 256; i++) {
            if (cs[i] != cp[i]) return false;                     // freq mismatch → not anagram
        }
        return true;                                               // all freqs match → anagram
    }

    public List<Integer> findAnagrams(String s, String p) {
        ArrayList<Integer> list = new ArrayList<>();

        int cs[] = new int[256];                                   // freq array for current window
        int cp[] = new int[256];                                   // freq array for pattern

        for (int i = 0; i < p.length(); i++) {
            cs[s.charAt(i)]++;                                     // build first window of size m
            cp[p.charAt(i)]++;                                     // build pattern freq array
        }

        if (same(cs, cp)) list.add(0);                            // check first window

        for (int j = p.length(); j < s.length(); j++) {
            cs[s.charAt(j)]++;                                     // add new char entering window
            cs[s.charAt(j - p.length())]--;                       // remove old char leaving window

            if (same(cs, cp)) list.add(j - p.length() + 1);      // anagram found → store index
        }

        return list;                                               // return all start indices
    }
}

