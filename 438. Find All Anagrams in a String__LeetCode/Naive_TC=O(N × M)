class Solution {

    boolean present(String s, String p, int i) {
        int n = s.length();
        int m = p.length();
        int Ch = 256;
        int count[] = new int[Ch];              // frequency array for ASCII chars

        for (int j = 0; j < m; j++) {
            count[p.charAt(j)]++;               // increment for pattern char
            count[s.charAt(i + j)]--;           // decrement for window char
        }

        for (int j = 0; j < Ch; j++) {
            if (count[j] != 0) return false;    // freq mismatch → not anagram
        }
        return true;                            // all freqs zero → anagram found
    }

    public List<Integer> findAnagrams(String s, String p) {
        ArrayList<Integer> list = new ArrayList<>();

        int n = s.length();
        int m = p.length();

        for (int i = 0; i <= n - m; i++) {     // slide window across s
            if (present(s, p, i)) {
                list.add(i);                    // store start index of anagram
            }
        }

        return list;                            // return all anagram indices
    }
}

