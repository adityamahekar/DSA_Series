class Solution {

    static int largestHist(int arr[], int m) {
        int res = 0;                                                           // Max area
        int curr;                                                              // Current area
        ArrayDeque<Integer> st = new ArrayDeque<>();                           // Stack of indices

        for(int i = 0; i < m; i++){                                           // Traverse histogram
            while(!st.isEmpty() && arr[st.peek()] >= arr[i]){                 // Pop taller bars
                int tp = st.pop();                                             // Popped bar
                curr = arr[tp] * (st.isEmpty() ? i : (i - st.peek() - 1));   // Area = height x width
                res = Math.max(res, curr);                                     // Update max
            }
            st.push(i);                                                        // Push current index
        }

        while(!st.isEmpty()){                                                  // Remaining bars
            int tp = st.pop();                                                 // Pop bar
            curr = arr[tp] * (st.isEmpty() ? m : (m - st.peek() - 1));       // Area to end
            res = Math.max(res, curr);                                         // Update max
        }
        return res;                                                            // Return max area
    }


    static int maxArea(int mat[][]) {
        int n = mat.length;                                                    // Rows
        int m = mat[0].length;                                                 // Cols

        int max = largestHist(mat[0], m);                                     // First row as histogram

        for(int i = 1; i < n; i++){                                           // Each row
            for(int j = 0; j < m; j++){                                       // Each col
                if(mat[i][j] == 1){                                           // If cell is 1
                    mat[i][j] += mat[i-1][j];                                 // Add height from above
                }
            }
            max = Math.max(max, largestHist(mat[i], m));                      // Max area this row
        }

        return max;                                                            // Return overall max
    }
}

