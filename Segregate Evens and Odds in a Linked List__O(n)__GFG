class Solution {
    Node divide(Node head) {
        
        Node es = null, ee = null;      // Even Start, Even End
        Node os = null, oe = null;      // Odd Start, Odd End

        // Traverse the list and separate nodes into even and odd lists
        for (Node curr = head; curr != null; curr = curr.next) {
            
            if (curr.data % 2 == 0) {   // Even node
                if (es == null) {       // First even node
                    es = ee = curr;
                } else {                // Append to even list
                    ee.next = curr;
                    ee = ee.next;
                }
            } else {                    // Odd node
                if (os == null) {       // First odd node
                    os = oe = curr;
                } else {                // Append to odd list
                    oe.next = curr;
                    oe = oe.next;
                }
            }
        }
        
        // Edge case: if either list is empty, return original head
        if (os == null || es == null) {
            return head;
        }
        
        // Connect even list to odd list
        ee.next = os;
        
        // Terminate the combined list
        oe.next = null;
        
        // Return new head (start of even list)
        return es;
    }
}

