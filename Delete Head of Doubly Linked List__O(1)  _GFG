class Solution {
    public static Node deleteHead(Node head) {

        if (head == null) {             // edge case: empty list
            return null;
        }

        if (head.next == null) {        // edge case: single node
            return null;
        }

        head = head.next;               // move head to next node
        head.prev = null;               // remove link to old head

        return head;                    // return new head
    }
}


//////////////////////// DRY RUN /////////////////////////////

    List  :  1 <-> 2 <-> 3 <-> NULL
    Goal  :  delete [1], return [2] as new head

    INITIAL:
        [null|-1-|2] <-> [1|-2-|3] <-> [2|-3-|null]
         head

    STEP 1: head = head.next
        [null|-1-|2] <-> [1|-2-|3] <-> [2|-3-|null]
                          head

    STEP 2: head.prev = null
        [null|-1-|2]     [null|-2-|3] <-> [2|-3-|null]
                           head

    STEP 3: return head

        FINAL: [null|-2-|3] <-> [2|-3-|null]
                2 <-> 3 <-> NULL  ✅


    EDGE CASE 1: empty list
        head == null -> return null  ✅

    EDGE CASE 2: single node
        [null|-1-|null]
         head
        head.next == null -> return null  ✅


