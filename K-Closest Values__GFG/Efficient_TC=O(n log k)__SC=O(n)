(Note: the heap never holds more than k elements, so each of the n elements costs O(log k), not O(log n). The sorted list takes O(n) space.)

//////////////////////// CODE ////////////////////////////////

class Solution {

    void inorder(Node root, ArrayList<Integer> arr) {
        if (root == null)                                         // base case
            return;

        inorder(root.left, arr);                                  // visit left
        arr.add(root.data);                                       // sorted order
        inorder(root.right, arr);                                 // visit right
    }

    class Pair {
        int diff;                                                 // distance from target
        int index;                                                // index in sorted list

        Pair(int diff, int index) {
            this.diff = diff;
            this.index = index;
        }
    }

    public ArrayList<Integer> getKClosest(Node root, int target, int k) {

        ArrayList<Integer> arr = new ArrayList<>();

        inorder(root, arr);                                       // BST to sorted list

        int n = arr.size();

        PriorityQueue<Pair> pq = new PriorityQueue<>(             // max heap on diff
            (a, b) -> b.diff - a.diff
        );

        for (int i = 0; i < k; i++) {                             // fill first k
            pq.add(new Pair(
                Math.abs(arr.get(i) - target), i
            ));
        }

        for (int i = k; i < n; i++) {                             // check the rest

            int diff = Math.abs(arr.get(i) - target);

            if (pq.peek().diff > diff) {                          // strict > keeps smaller on tie
                pq.poll();                                        // drop farthest
                pq.add(new Pair(diff, i));                        // add closer one
            }
        }

        ArrayList<Integer> result = new ArrayList<>();

        while (!pq.isEmpty()) {                                   // collect k closest
            result.add(arr.get(pq.poll().index));
        }

        return result;
    }
}

