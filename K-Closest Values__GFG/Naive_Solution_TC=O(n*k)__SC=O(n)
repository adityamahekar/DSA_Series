class Solution {

    void inorder(Node root, ArrayList<Integer> arr) {
        if (root == null)                                         // base case
            return;

        inorder(root.left, arr);                                  // visit left
        arr.add(root.data);                                       // sorted order
        inorder(root.right, arr);                                 // visit right
    }

    public ArrayList<Integer> getKClosest(Node root, int target, int k) {

        ArrayList<Integer> arr = new ArrayList<>();

        inorder(root, arr);                                       // BST to sorted list

        int n = arr.size();

        boolean[] visited = new boolean[n];                       // picked marker

        ArrayList<Integer> list = new ArrayList<>();

        for (int i = 0; i < k; i++) {                             // pick k values

            int minDiff = Integer.MAX_VALUE;                      // best diff so far
            int minDiff_Idx = -1;                                 // best index

            for (int j = 0; j < n; j++) {

                if (!visited[j] &&                                // skip picked
                    Math.abs(arr.get(j) - target) < minDiff) {    // strict < keeps smaller on tie

                    minDiff = Math.abs(arr.get(j) - target);      // update diff
                    minDiff_Idx = j;                              // update index
                }
            }

            list.add(arr.get(minDiff_Idx));                       // add closest
            visited[minDiff_Idx] = true;                          // mark picked
        }

        return list;
    }
}

