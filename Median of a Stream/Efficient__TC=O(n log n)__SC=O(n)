class Solution {
    public ArrayList<Double> getMedian(int[] arr) {

        ArrayList<Double> res = new ArrayList<>();

        PriorityQueue<Integer> maxHeap =                          // smaller half
            new PriorityQueue<>(Collections.reverseOrder());

        PriorityQueue<Integer> minHeap = new PriorityQueue<>();   // larger half

        for (int x : arr) {                                       // read stream one by one

            if (maxHeap.isEmpty() || x <= maxHeap.peek())         // belongs to smaller half
                maxHeap.add(x);
            else                                                  // belongs to larger half
                minHeap.add(x);

            if (maxHeap.size() > minHeap.size() + 1)              // left too big
                minHeap.add(maxHeap.poll());                      // move top to right

            else if (minHeap.size() > maxHeap.size())             // right too big
                maxHeap.add(minHeap.poll());                      // move top to left

            if (maxHeap.size() > minHeap.size())                  // odd count
                res.add((double) maxHeap.peek());                 // middle element

            else                                                  // even count
                res.add((maxHeap.peek() + minHeap.peek()) / 2.0); // average of two middle
        }

        return res;
    }
}

