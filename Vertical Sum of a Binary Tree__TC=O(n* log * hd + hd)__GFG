void vSumR(Node root, int hd, TreeMap<Integer, Integer> mp){
    if(root == null) return;                                       // base case

    vSumR(root.left, hd-1, mp);                                     // go left, hd-1
    int pSum = (mp.get(hd) == null) ? 0 : mp.get(hd);                // old sum at hd
    mp.put(hd, pSum + root.data);                                    // add node data
    vSumR(root.right, hd+1, mp);                                    // go right, hd+1
}

void vSum(Node root){
    TreeMap<Integer, Integer> mp = new TreeMap<Integer, Integer>();  // hd -> sum

    vSumR(root, 0, mp);                                             // build map
    for(Map.Entry sum: mp.entrySet()){                              // sorted by hd
        System.out.print(mp.getValue() + " ");                      // print sum
    }
}

