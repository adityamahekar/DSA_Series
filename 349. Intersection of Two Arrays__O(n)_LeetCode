

class Solution {
    public int[] intersection(int[] nums1, int[] nums2) {

        ArrayList<Integer> al = new ArrayList<Integer>();  // stores unique result
        HashSet<Integer>   hs = new HashSet<>();           // stores nums1 elements

        for(int i : nums1){
            hs.add(i);                                     // add nums1 to hashset
        }

        for(int j : nums2){
            if(hs.contains(j) && !al.contains(j)){        // found and not duplicate
                al.add(j);                                 // add to result
            }
        }

        int a[] = new int[al.size()];                      // result array

        for(int i = 0; i < al.size(); i++){
            a[i] = al.get(i);                              // fill array from list
        }

        return a;                                          // [2] ✅
    }
}

