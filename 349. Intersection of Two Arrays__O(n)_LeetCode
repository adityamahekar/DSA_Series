//  nums1 = [ 1,  2,  2,  1 ]
//  nums2 = [ 2,  2 ]

// ── PASS 1 : nums1 → hs ──────────────
//  i=1  hs = { 1 }
//  i=2  hs = { 1, 2 }
//  i=2  hs = { 1, 2 }  duplicate ignored
//  i=1  hs = { 1, 2 }  duplicate ignored

// ── PASS 2 : nums2 check ─────────────
//  j=2  hs has 2 ✅  al empty ✅  al = [ 2 ]
//  j=2  hs has 2 ✅  al has 2 ❌  skip

// ── PASS 3 : al → a ──────────────────
//  a  = new int[1]
//  i=0  a[0] = al.get(0) = 2

// ─────────────────────────────────────
//  hs = { 1,  2 }
//  al = [ 2 ]
//  a  = [ 2 ]  ✅

