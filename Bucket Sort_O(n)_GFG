
void bucketSort(int arr[], int n, int k){

    int max_v = arr[0];                                   // initialize max value

    for(int i = 1; i < n; i++){
        max_v = Math.max(max_v, arr[i]);                   // find maximum element
    }

    max_v++;                                               // increase max to avoid division issue

    ArrayList<ArrayList<Integer>> bkt =
        new ArrayList<ArrayList<Integer>>();               // create bucket list

    for(int i = 0; i < k; i++){
        bkt.add(new ArrayList<Integer>());                 // initialize k empty buckets
    }

    for(int i = 0; i < n; i++){
        int bi = (k * arr[i]) / max_v;                     // compute bucket index
        bkt.get(bi).add(arr[i]);                           // add element to bucket
    }

    for(int i = 0; i < k; i++){
        Collections.sort(bkt.get(i));                      // sort each bucket
    }

    int idx = 0;                                           // index for original array

    for(int i = 0; i < k; i++){
        for(int j = 0; j < bkt.get(i).size(); j++){
            arr[idx++] = bkt.get(i).get(j);                // copy elements back to array
        }
    }
}

