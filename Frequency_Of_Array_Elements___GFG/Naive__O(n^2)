
void printFreq(int arr[], int n){

    for(int i = 0; i < n; i++){

        boolean flag = false;                             // reset for each element

        for(int j = 0; j < i; j++){                      // check if arr[i] seen before
            if(arr[i] == arr[j]){                        // duplicate found
                flag = true;                             // mark as seen
                break;                                   // stop searching
            }
        }

        if(flag){ continue; }                            // skip already printed element

        int freq = 1;                                    // count self as first occurrence

        for(int j = i + 1; j < n; j++){                 // count remaining duplicates
            if(arr[i] == arr[j]){                        // match found
                freq++;                                  // increment frequency
            }
        }

        System.out.println(arr[i] + " " + freq);        // print element and its frequency
    }
}

