
void countFreq(int arr[], int n){

    HashMap<Integer, Integer> hm = new HashMap<>();           // stores element → frequency

    for(int x : arr){
        hm.put(x, hm.getOrDefault(x, 0) + 1);                // increment freq of x
    }

    for(Map.Entry<Integer, Integer> e : hm.entrySet()){       // iterate each entry
        System.out.println(e.getKey() + " " + e.getValue());  // print key and freq
    }
}

