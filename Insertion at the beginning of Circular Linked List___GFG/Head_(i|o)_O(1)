/*
class Node {
    int data;
    Node next;
    Node(int x) {
        data = x;
        next = null;
    }
}
*/

class Solution {
    public Node insertAtBeginning(Node head, int key) {

        Node temp = new Node(key);              // Create new node with given key

        if (head == null) {                     // CASE 1: List is empty
            temp.next = temp;                   // New node points to itself (circular)
            return temp;                        // New node is now the head, return it
        }

         else{
              temp.next = head.next;
              head.next = temp;
int t = head.data;
head.data = temp.data;
temp.data = t;

return head;
          }
    }
}


