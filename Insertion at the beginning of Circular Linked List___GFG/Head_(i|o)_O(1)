/*
class Node {
    int data;
    Node next;
    Node(int x) {
        data = x;
        next = null;
    }
}
*/

class Solution {
    public Node insertAtBeginning(Node head, int key) {

        Node temp = new Node(key);              // Create new node with given key

        if (head == null) {                     // CASE 1: List is empty
            temp.next = temp;                   // New node points to itself (circular)
            return temp;                        // New node is the head, return it
        }

        else {
            temp.next = head.next;              // temp points to node after head
            head.next = temp;                   // head points to temp (insert after head)
            int t = head.data;                  // Store head's data in t (swap begins)
            head.data = temp.data;              // head gets temp's data (key)
            temp.data = t;                      // temp gets old head's data
            return head;                        // head now has key, return it as new head
        }
    }
}


