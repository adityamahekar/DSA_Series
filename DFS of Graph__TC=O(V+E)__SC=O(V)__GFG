class Solution {
    
    ArrayList<Integer> list = new ArrayList<Integer>();                      // stores DFS order
            
    void DFS(ArrayList<ArrayList<Integer>> adj,int s,boolean visit[]){
        
        visit[s] = true;                                                     // mark node visited
        
        list.add(s);                                                         // add node to answer
        
        for(int u: adj.get(s)){                                              // neighbors in given order
            if(!visit[u]){                                                   // only unvisited nodes
            
                DFS(adj,u,visit);                                            // go deeper
            }
        }
        
        
    }
    
    public ArrayList<Integer> dfs(ArrayList<ArrayList<Integer>> adj) {
        
        list = new ArrayList<>();                                            // reset list
        
        boolean visit[] = new boolean[adj.size()];                           // visited array
        
        DFS(adj,0,visit);                                                    // start from vertex 0
        
        return list;
    }
}

