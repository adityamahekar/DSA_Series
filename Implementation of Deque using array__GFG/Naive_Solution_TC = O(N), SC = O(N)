class myDeque {
    int cap, size;              // cap: capacity, size: current elements
    int arr[];                  // array to store deque elements

    public myDeque(int n) {
        cap = n;                // set capacity
        size = 0;               // initialize size to 0
        arr = new int[cap];     // create array of size n
    }

    boolean full() {
        return size == cap;     // full if size equals capacity
    }
    
    boolean empty() {
        return size == 0;       // empty if size is 0
    }
    
    public void insertFront(int x) {
        if (full()) return;     // do nothing if full
        
        for (int i = size - 1; i >= 0; i--) {
            arr[i + 1] = arr[i]; // shift all elements right
        }
        arr[0] = x;             // insert at front
        size++;                 // increment size
    }

    public void insertRear(int x) {
        if (full()) return;     // do nothing if full
        arr[size++] = x;        // insert at rear, increment size
    }

    public void deleteFront() {
        if (empty()) return;    // do nothing if empty
        
        for (int i = 0; i < size - 1; i++) {
            arr[i] = arr[i + 1]; // shift all elements left
        }
        size--;                 // decrement size
    }

    public void deleteRear() {
        if (empty()) return;    // do nothing if empty
        size--;                 // just decrement size
    }

    public int frontEle() {
        if (empty()) return -1; // return -1 if empty
        return arr[0];          // return front element
    }

    public int rearEle() {
        if (empty()) return -1; // return -1 if empty
        return arr[size - 1];   // return rear element
    }
}

