class myDeque {
    int cap, size;              // cap: capacity, size: current element count
    int arr[];                  // circular array for deque storage
    int front;                  // index pointing to front element

    public myDeque(int n) {
        cap = n;                // set capacity to n
        size = 0;               // initialize size to 0
        arr = new int[cap];     // allocate array of size cap
        front = 0;              // initialize front index to 0
    }

    boolean full() {
        return size == cap;     // return true if deque is full
    }
    
    boolean empty() {
        return size == 0;       // return true if deque is empty
    }
    
    public void insertFront(int x) {
        if (full()) return;     // return if deque is full
        
        front = (front - 1 + cap) % cap;  // move front backward (circular)
        arr[front] = x;         // place x at new front position
        size++;                 // increment element count
    }

    public void insertRear(int x) {
        if (full()) return;     // return if deque is full
        arr[(front + size) % cap] = x;   // place x at rear position
        size++;                 // increment element count
    }

    public void deleteFront() {
        if (empty()) return;    // return if deque is empty
        front = (front + 1) % cap;       // move front forward (circular)
        size--;                 // decrement element count
    }

    public void deleteRear() {
        if (empty()) return;    // return if deque is empty
        size--;                 // decrement element count (no index change)
    }

    public int frontEle() {
        if (empty()) return -1; // return -1 if deque is empty
        return arr[front];      // return element at front index
    }

    public int rearEle() {
        if (empty()) return -1; // return -1 if deque is empty
        return arr[(front + size - 1) % cap];  // return element at rear index
    }
}

