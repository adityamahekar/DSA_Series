
class Solution {
    public boolean isSorted(int[] arr) {
        for(int i = 1; i < arr.length; i++){   // start from index 1
            if(arr[i-1] > arr[i]){             // prev > curr → not sorted
                return false;                  // return false
            }
        }
        return true;                           // no issue → sorted
    }
}

