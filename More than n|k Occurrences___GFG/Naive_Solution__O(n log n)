
class Solution {
    public int countOccurence(int[] arr, int k) {
        Arrays.sort(arr);                          // sort array so duplicates are adjacent
        
        int i = 1, count = 1, n = arr.length;      // i = current index, count = frequency of current element
        
        while (i < n) {                            // loop through entire array
            while (i < n && arr[i] == arr[i-1]) {           // count consecutive duplicate elements
                count++;                           // increment count for each duplicate
                i++;                               // move to next element
            }
            
            if (count > n / k) {                   // check if frequency exceeds n/k threshold
                return arr[i-1];                   // return the majority element
            }
            i++;                                   // move to next distinct element
            count = 1;                             // reset count for new element
        }
        return -1;                                 // no majority element found
    }
}

