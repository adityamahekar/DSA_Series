
class Solution {
    public int countOccurence(int[] arr, int k) {
    
        HashMap<Integer,Integer> map = new HashMap<>();        // key=element, value=frequency
        int n = arr.length;                                    // total elements
        
        for(int i = 0; i < n; i++){                           // STEP 1: fill map
            map.put(arr[i], map.getOrDefault(arr[i], 0) + 1); // add/update frequency
        }                                                      // map={3=3, 1=2, 2=3}
        
        int count = 0;                                         // STEP 2: count qualifying
        for(Map.Entry<Integer, Integer> e : map.entrySet()){   // loop each entry
            if(e.getValue() > n / k){                          // frequency > threshold?
                count++;                                       // yes → increment
            }                                                  // n/k = 8/4 = 2
        }
        
        return count;                                          // return total found
    }
}

