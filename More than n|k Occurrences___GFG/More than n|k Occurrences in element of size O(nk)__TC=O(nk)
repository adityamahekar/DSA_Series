
import java.util.*;
class Solution {
    public int countOccurence(int[] arr, int k) {
        int n = arr.length;                                    // n = total elements

        // STEP 1: FIND CANDIDATES (Boyer-Moore Voting)
        HashMap<Integer, Integer> map = new HashMap<>();       // {candidate : count}
        for(int num : arr){                                    // loop each element
            if(map.containsKey(num)){                          // already a candidate?
                map.put(num, map.get(num) + 1);                // yes → increment
            }
            else if(map.size() < k - 1){                       // space for new candidate?
                map.put(num, 1);                               // yes → add new
            }
            else{                                              // no space → reduce all
                ArrayList<Integer> removeList = new ArrayList<>();
                for(Map.Entry<Integer,Integer> e : map.entrySet()){
                    map.put(e.getKey(), e.getValue() - 1);     // decrement all counts
                    if(map.get(e.getKey()) == 0){              // count reached 0?
                        removeList.add(e.getKey());            // mark for removal
                    }
                }
                for(int key : removeList){
                    map.remove(key);                           // remove zero candidates
                }
            }
        }

        // STEP 2: VERIFY ACTUAL FREQUENCY
        int count = 0;                                         // qualifying elements
        for(int key : map.keySet()){                           // loop candidates
            int freq = 0;                                      // actual frequency
            for(int num : arr){                                // count in array
                if(num == key) freq++;                         // match → increment
            }
            if(freq > n/k){                                    // frequency > threshold?
                count++;                                       // yes → count++
            }
        }
        return count;                                          // total qualifying
    }
}

////////////////////////////////////////////////////////////////////////////////

More than n/k Occurrences
Given an array arr and an element k. The task is to find the count of elements in the array that appear more than n/k times and n is length of arr.

Examples :

Input: arr = [3, 1, 2, 2, 1, 2, 3, 3], k = 4
Output: 2
Explanation: In the given array, 3 and 2 are the only elements that appears more than n/k times.

Input: arr = [2, 3, 3, 2], k = 3
Output: 2
Explanation: In the given array, 3 and 2 are the only elements that appears more than n/k times. So the count of elements are 2.

Input: arr = [1, 4, 7, 7], k = 2
Output: 0
Explanation: In the given array, no element appears more than n/k times.

Constraints:
1 <= arr.size() <= 106
0 <= arr[i] <= 108
1 <= k <= arr.size()
