class Solution {
    public ArrayList<ArrayList<Integer>> levelOrder(Node root) {

        ArrayList<ArrayList<Integer>> list = new ArrayList<>();               // Initialize result list of lists
        if(root == null){ return list; }                                      // Base case: empty tree

        Queue<Node> q = new LinkedList<>();                                   // Queue for BFS traversal

        q.add(root);                                                          // Enqueue root
        q.add(null);                                                          // Add null as level separator

        ArrayList<Integer> level = new ArrayList<>();                         // List to store current level nodes

        while(!q.isEmpty()){                                                  // Process until queue empty
            Node cur = q.remove();                                            // Dequeue current node
            
            if(cur == null){                                                  // Level separator reached
                list.add(level);                                              // Add current level to result
                level = new ArrayList<>();                                    // Create new level list
                if (!q.isEmpty()) q.add(null);                                // Add separator if nodes remain
                continue;
            }
            
            level.add(cur.data);                                              // Add current node to level list
        
            if(cur.left != null){ q.add(cur.left); }                          // Enqueue left child if exists
            if(cur.right != null){ q.add(cur.right); }                        // Enqueue right child if exists
        }
        
        return list;                                                          // Return level order traversal
    }
}

