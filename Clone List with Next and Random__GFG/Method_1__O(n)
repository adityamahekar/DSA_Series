/*
class Node {
    int data;
    Node next;
    Node random;

    Node(int x) {
        data = x;
        next = null;
        random = null;
    }
}
*/

class Solution {
    public Node cloneLinkedList(Node head) {
        
        if (head == null) { return null; }                    // Edge case: empty list
        
        HashMap<Node, Node> map = new HashMap<>();            // Map: original -> clone
        Node curr = head;
        
        // Step 1: Create all new nodes and store in map
        while (curr != null) {
            map.put(curr, new Node(curr.data));               // Clone node with same data
            curr = curr.next;
        }
        
        // Step 2: Connect next and random pointers of cloned nodes
        curr = head;
        while (curr != null) {
            Node clone = map.get(curr);                       // Get cloned node
            clone.next = map.get(curr.next);                  // Set next pointer
            clone.random = map.get(curr.random);              // Set random pointer
            curr = curr.next;
        }
        
        return map.get(head);                                 // Return head of cloned list
    }
}

