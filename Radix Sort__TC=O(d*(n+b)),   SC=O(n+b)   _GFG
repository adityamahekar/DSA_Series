

// User function Template for Java

class Solution {
    
    static void counting(int arr[], int n, int ex){
        int output[] = new int[n];
        int count[] = new int[10];
        
        for(int i=0;i<10;i++){ count[i] = 0;}
        for(int i=0;i<n;i++){ count[(arr[i]/ex)%10]++;}
        for(int i=1;i<10;i++){ count[i] = count[i] + count[i-1];}
        for(int i=n-1;i>=0;i--){
             output[count[(arr[i]/ex) %10] - 1] = arr[i];
             count[(arr[i]/ex) %10]--;
        }
        for(int i=0;i<n;i++){
            arr[i] = output[i];
        }
    }
    static void radixSort(int arr[], int n) {
        int mx = arr[0];
        
        for(int i=1;i<n;i++){
            if(arr[i] > mx){
                mx = arr[i];
            }
        }
        
        for(int ex=1;mx/ex > 0;ex++){
            counting(arr,n,ex);
        }
        
    }
    
    
}



