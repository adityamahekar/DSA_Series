
class Solution {
    public int maxLen(int[] arr) {
        int n = arr.length, res = 0;                       // res=maxLen

        for(int i=0;i<n;i++){
            int c0 = 0, c1 = 0;                           // reset counts for each start index
            for(int j=i;j<n;j++){
                if(arr[j] == 0){
                    c0++;                                  // count zeros
                }
                else{
                    c1++;                                  // count ones
                }

                if(c0 == c1){                             // equal 0s and 1s found
                    res = Math.max(res, c0+c1);           // update max length
                }
            }
        }

        return res;                                       // return longest length
    }
}

