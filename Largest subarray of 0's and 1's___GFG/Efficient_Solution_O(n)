
class Solution {
    public int maxLen(int[] arr) {
        HashMap<Integer,Integer> hm = new HashMap<>();
        hm.put(0,-1);                                      // base case: sum 0 at index -1

        int res=0, n = arr.length, sum=0;                  // res=maxLen, sum=prefixSum

        for(int i=0;i<n;i++){
            if(arr[i] == 0){
                arr[i] = -1;                               // treat 0 as -1
            }
        }

        for(int x=0;x<n;x++){
            sum += arr[x];                                 // update prefixSum

            if(sum == 0){                                  // equal 0s and 1s from index 0
                res = Math.max(res, x - hm.get(0));        // update maxLen
            }

            if(!hm.containsKey(sum)){                      // store first occurrence only
                hm.put(sum,x);
            }
            else{
                res = Math.max(res, x-hm.get(sum));        // same sum seen before, update maxLen
            }
        }

        return res;                                        // return longest length
    }
}

