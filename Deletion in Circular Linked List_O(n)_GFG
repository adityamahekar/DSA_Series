/*
class Node {
    int data;
    Node next;
    Node(int x) {
        data = x;
        next = null;
    }
}
*/

class Solution {
    Node deleteNode(Node head, int key) {

        if (head == null) {                         // empty list
            return head;
        }

        if (head.data == key) {                     // key is at head
            head = head.next;                       // move head forward
        }

        Node curr = head;

        while (curr.next != head) {                 // traverse till last node
            if (curr.next.data == key) {            // key found
                curr.next = curr.next.next;         // skip key node
                return head;
            }
            curr = curr.next;
        }

        return head;
    }
}


