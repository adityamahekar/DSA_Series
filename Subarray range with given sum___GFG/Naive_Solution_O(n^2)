
class Solution {
    static int subArraySum(int arr[], int tar) {

        int n     = arr.length;                           // array length
        int sum   = 0;                                    // current subarray sum
        int count = 0;                                    // count of subarrays

        for(int i = 0; i < n; i++){                      // start index of subarray
            sum = 0;                                      // reset sum for each start

            for(int j = i; j < n; j++){                  // end index of subarray
                sum += arr[j];                           // expand subarray by one

                if(sum == tar){                          // sum matches target
                    count++;                             // increment count
                }
            }
        }

        return count;                                     // total matching subarrays ✅
    }
}

/////////////////////////////////////////////////////////////////

Subarray range with given sum
Given an unsorted array of integers arr[], and a target tar, determine the number of subarrays whose elements sum up to the target value.

Examples:

Input: arr[] = [10, 2, -2, -20, 10] , tar = -10
Output: 3
Explanation: Subarrays with sum -10 are: [10, 2, -2, -20], [2, -2, -20, 10] and [-20, 10].

Input: arr[] = [1, 4, 20, 3, 10, 5] , tar = 33
Output: 1
Explanation: Subarray with sum 33 is: [20,3,10].

Constraints:
1 <= arr.size() <= 106
-105 <= arr[i] <= 105
-105 <= tar <= 105

