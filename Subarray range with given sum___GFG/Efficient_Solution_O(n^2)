class Solution {
    static int subArraySum(int arr[], int tar) {

        HashSet<Integer> hs = new HashSet<>();            // stores prefix sums seen so far
        int count = 0;                                    // matching subarray count ✅
        int sum   = 0;                                    // running prefix sum

        hs.add(0);                                        // base case: empty subarray prefix

        for(int x : arr){
            sum += x;                                     // update prefix sum

            if(hs.contains(sum - tar)){                  // ✅ sum-tar seen → subarray==tar exists
                count++;                                  // increment count
            }

            hs.add(sum);                                  // store current prefix sum
        }

        return count;                                     // ✅
    }
}

