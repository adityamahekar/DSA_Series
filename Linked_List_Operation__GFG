Problems with Arrays:

>> Insertion / Deletion at the beginning / middle is costly.
>> Either size is fixed and pre-allocated.
>> Implementation of data structure like queue and deque is complex with arrays.

--------------------------------------------------------------------------------
    Head
      ↓
    [10 | next] → [20 | next] → [30 | next] → [40 | null]
--------------------------------------------------------------------------------



class Node{
    int data;
    Node next;
    Node(int x){
        data = x;
        next = null;
    }
}

class Test{
    public static void main(String []args){
        Node head = new Node(10);
        Node temp1 = new Node(20);
        Node temp2 = new Node(30);
        head.next = temp1;
        temp1.next = temp2;

    }
}
