import java.util.ArrayDeque;
import java.util.Deque;

public class ArrayDequeExample {
    public static void main(String[] args) {
        // Declare and initialize
        Deque<Integer> deque = new ArrayDeque<>();

        // Add elements
        deque.add(1);           // at the back
        deque.addFirst(0);      // at the front
        deque.addLast(2);       // at the back
        boolean added = deque.offer(3);  // adds at tail, returns true if success
        deque.push(4);           // pushes at front (same as addFirst)

        // Remove elements
        int first = deque.removeFirst(); // removes from front
        int last = deque.removeLast();   // removes from back
        int popped = deque.pop();        // pops from front (same as removeFirst)

        // Peek (view without removing)
        int head = deque.peekFirst();    // views front, null if empty
        int tail = deque.peekLast();     // views back, null if empty
        int peekHead = deque.peek();     // same as peekFirst()
        int elementHead = deque.element(); // same as getFirst(), throws if empty

        // poll() - retrieve and remove head (same as pollFirst(), returns null if empty)
        Integer polled = deque.poll();   // removes from front safely

        System.out.println(deque);
        System.out.println("offer result: " + added);
        System.out.println("popped: " + popped);
        System.out.println("peekHead: " + peekHead);
        System.out.println("elementHead: " + elementHead);
        System.out.println("polled: " + polled);
    }
}

