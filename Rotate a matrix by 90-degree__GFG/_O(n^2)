 
class Solution {
    public void rotateMatrix(int[][] mat) {
        
        int n = mat.length;                    // size of square matrix
        
        int temp[][] = new int[n][n];          // temporary matrix to store rotated values
        
        for(int i = 0; i < n; i++){            // traverse rows
            for(int j = 0; j < n; j++){        // traverse columns
                temp[n - j - 1][i] = mat[i][j]; // place element in rotated position
            }
        }
         
        for(int i = 0; i < n; i++){            // copy rotated matrix back
            for(int j = 0; j < n; j++){
                mat[i][j] = temp[i][j];        // update original matrix
            }
        }
    }
}

