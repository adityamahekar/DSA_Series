class Solution {
    Node sortedInsert(Node head, int key) {
        Node temp = new Node(key);               // Create new node with key

        if (head == null) {                      // Case 1: Empty list
            temp.next = temp;                    // Self-loop for circular property
            return temp;                         // Return new node as head
        }

        Node curr = head;

        if (key <= head.data) {                  // Case 2: Insert before head
            Node last = head;                    // Find last node
            while (last.next != head) {          // Traverse to end
                last = last.next;
            }
            temp.next = head;                    // New node → head
            last.next = temp;                    // Last → new node
            return temp;                         // New node becomes head
        }

        // Case 3: Insert in middle or end
        while (curr.next != head && curr.next.data < key) {  // Find position
            curr = curr.next;
        }
        temp.next = curr.next;                   // New node → curr's next
        curr.next = temp;                        // Curr → new node
        return head;                             // Head unchanged
    }
}


//////////////////////// DRY RUN ////////////////////

List: 25 → 36 → 47 → 58 → 69 → 80 (circular), key = 19

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

CASE 1: Insert at Beginning (key = 19)

INITIAL:
        (head)
          │
          ▼
    [25|•] → [36|•] → [47|•] → [58|•] → [69|•] → [80|•]
      ▲                                                      │
      └──────────────────────────────────────────────────────┘

STEP 1: key(19) ≤ head.data(25) → find last node
  last = 80 (last.next = head)

STEP 2: temp.next = head (19 → 25)
STEP 3: last.next = temp (80 → 19)

FINAL:
        (new head)
            │
            ▼
    [19|•] → [25|•] → [36|•] → [47|•] → [58|•] → [69|•] → [80|•]
      ▲                                                              │
      └──────────────────────────────────────────────────────────────┘

Result: 19 → 25 → 36 → 47 → 58 → 69 → 80 (circular)


━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

CASE 2: Insert in Middle (key = 75)

List: 50 → 100 (circular), key = 75

INITIAL:
        (head)
          │
          ▼
    [50|•] → [100|•]
      ▲              │
      └──────────────┘

STEP 1: key(75) > head.data(50), skip Case 2

STEP 2: Traverse while curr.next.data < key
  curr = 50: curr.next.data(100) ≥ 75 → stop at 50

STEP 3: temp.next = curr.next (75 → 100)
STEP 4: curr.next = temp (50 → 75)

FINAL:
        (head)
          │
          ▼
    [50|•] → [75|•] → [100|•]
      ▲                  │
      └──────────────────┘

Result: 50 → 75 → 100 (circular)


━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

CASE 3: Insert at End (key = 90)

List: 10 → 20 → 30 (circular), key = 90

INITIAL:
    [10|•] → [20|•] → [30|•]
      ▲               │
      └───────────────┘

STEP: Traverse while curr.next != head && curr.next.data < 90
  curr stops at 30 (curr.next = head)

STEP: temp.next = head, curr.next = temp

FINAL:
    [10|•] → [20|•] → [30|•] → [90|•]
      ▲                          │
      └──────────────────────────┘

Result: 10 → 20 → 30 → 90 (circular)


