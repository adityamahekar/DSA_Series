
class Solution {

    boolean subSeq(String s1, String s2, int n, int m){

        if(n == 0)                                      // all characters of s1 matched
            return true;

        if(m == 0)                                      // s2 finished but s1 still left
            return false;

        if(s1.charAt(n-1) == s2.charAt(m-1))             // characters match
            return subSeq(s1, s2, n-1, m-1);             // move in both strings

        else
            return subSeq(s1, s2, n, m-1);               // move only in s2
    }

    public boolean isSubSeq(String s1, String s2) {

        int n = s1.length(), m = s2.length();            // lengths of both strings

        return subSeq(s1, s2, n, m);                     // start recursion
    }
}

