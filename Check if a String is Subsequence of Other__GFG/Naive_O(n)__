
class Solution {

    public boolean isSubSeq(String s1, String s2) {

        int n = s1.length(), m = s2.length();     // lengths of both strings
        int j = 0;                                // pointer for s1

        for (int i = 0; i < m && j < n; i++) {    // traverse s2

            if (s2.charAt(i) == s1.charAt(j)) {   // characters match
                j++;                              // move pointer in s1
            }

        }

        return (j == n);                          // if all chars of s1 matched
    }
}

