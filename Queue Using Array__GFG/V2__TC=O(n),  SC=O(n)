class myQueue {
    int q[];                    // Array storage
    int f, r, c, n;               // front,rear,count,capacity
    
                                 // Constructor
    public myQueue(int n) {
        this.n = n;                   // Set capacity
        q = new int[n];
        f = 0;                      // Front pointer
        r = -1;                         // Rear pointer
        c = 0;                          // Element count
    }

    public boolean isEmpty() {      // Empty check
        return c == 0;
    }

    public boolean isFull() {       // Full check
        return c == n;
    }

    public void enqueue(int x) {            // Linear enqueue
        if(isFull()) return;
        q[++r] = x;                     // Increment rear
        c++;
    }
             
    public void dequeue() {                          // Linear dequeue O(n)
        if(isEmpty()) return;
        for(int i = 0; i < c-1; i++){                     // Shift elements
            q[i] = q[i+1];
        }
        r--;                                  // Decrement rear
        c--;
    }

    public int getFront() {         // Front element
        if(isEmpty()) return -1;
        return q[f];
    }

    public int getRear() {          // Rear element
        if(isEmpty()) return -1;
        return q[r];
    }
}

