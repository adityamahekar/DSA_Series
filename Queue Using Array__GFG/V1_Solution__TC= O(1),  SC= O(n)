class myQueue {
    int q[];                            // Array to store elements
    int f, r, c, n;                                 // front, rear, count, capacity
    
                                              // Constructor
    public myQueue(int n) {                    // Initialize queue
        this.n = n;
        q = new int[n];
        f = 0;                                     // Front starts at 0
        r = -1;                    // Rear initially empty
        c = 0;                             // Count of elements
    }

    public boolean isEmpty() {                // Check if empty
        return c == 0;
    }

    public boolean isFull() {             // Check if full
        return c == n;
    }

    public void enqueue(int x) {                                // Add to rear
        if(isFull()) return;
        r = (r + 1) % n;                                // Circular increment
        q[r] = x;
        c++;                                // Increment count
    }

    public void dequeue() {                      // Remove from front
        if(isEmpty()) return;
        f = (f + 1) % n;                    // Circular increment
        c--;                                // Decrement count
    }    

    public int getFront() {                    // Get front element
        if(isEmpty()) return -1;
        return q[f];
    }

    public int getRear() {                       // Get rear element
        if(isEmpty()) return -1;
        return q[r];
    }
}

