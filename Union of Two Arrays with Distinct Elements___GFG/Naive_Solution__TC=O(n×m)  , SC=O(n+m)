
class Solution {
    ArrayList<Integer> findUnion(int[] a, int[] b) {

        ArrayList<Integer> list = new ArrayList<>();      // stores union result

        for(int i = 0; i < a.length; i++){
            list.add(a[i]);                               // add all elements of a
        }

        for(int j = 0; j < b.length; j++){
            if(!list.contains(b[j])){                     // check if b[j] not in list
                list.add(b[j]);                           // add only if not duplicate
            }
        }

        Collections.sort(list);                           // sort ascending

        return list;                                      // sorted union ✅
    }
}

