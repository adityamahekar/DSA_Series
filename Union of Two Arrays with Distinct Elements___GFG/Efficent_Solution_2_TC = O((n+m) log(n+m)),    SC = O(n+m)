class Solution {
    ArrayList<Integer> findUnion(int[] a, int[] b) {

        HashSet<Integer> set = new HashSet<>();           // stores unique elements

        for(int e : a){ set.add(e); }                    // add all elements of a
        for(int f : b){ set.add(f); }                    // add all elements of b
                                                          // duplicates auto ignored
        ArrayList<Integer> list = new ArrayList<>(set);  // HashSet → ArrayList
        Collections.sort(list);                           // sort ascending

        return list;                                      // sorted union ✅
    }
}
