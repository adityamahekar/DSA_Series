a  = [ 1,  2,  3,  4,  5 ]
b  = [ 3,  4,  5,  6,  7 ]

// ── PASS 1 : a → hs ──────────────
e=1  hs = { 1 }
e=2  hs = { 1, 2 }
e=3  hs = { 1, 2, 3 }
e=4  hs = { 1, 2, 3, 4 }
e=5  hs = { 1, 2, 3, 4, 5 }

// ── PASS 2 : b → hs ──────────────
f=3  hs = { 1, 2, 3, 4, 5 }     duplicate ignored
f=4  hs = { 1, 2, 3, 4, 5 }     duplicate ignored
f=5  hs = { 1, 2, 3, 4, 5 }     duplicate ignored
f=6  hs = { 1, 2, 3, 4, 5, 6 }
f=7  hs = { 1, 2, 3, 4, 5, 6, 7 }

// ── hs → al → sort ───────────────
al  = [ 1,  2,  3,  4,  5,  6,  7 ]  ✅

