
class Solution {
    ArrayList<Integer> findUnion(int[] a, int[] b) {

        HashSet<Integer> hs = new HashSet<Integer>();     // stores unique elements

        for(int e : a){
            hs.add(e);                                    // add all elements of a
        }

        for(int f : b){
            hs.add(f);                                    // add all elements of b
        }

        ArrayList<Integer> al = new ArrayList<Integer>(hs); // HashSet → ArrayList
        Collections.sort(al);                               // sort ascending

        return al;                                           // sorted union ✅
    }
}


