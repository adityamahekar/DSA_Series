class Solution {
    public Node reverseKGroup(Node head, int k) {
        
        if (head == null || k == 1) { return head; }    // Base cases: empty list or k=1
        
        Node curr = head, prev = null, next = null;
        int count = 0;
        
        
        // Step 1: Check if at least k nodes exist
        Node temp = head;
        int len = 0;
        while (temp != null && len < k) {
            temp = temp.next;
            len++;
        }
        
        if (len < k) { return head; }                   // Less than k nodes, return as-is
        
        
        // Step 2: Reverse first k nodes
        while (curr != null && count < k) {
            next = curr.next;                           // Save next node
            curr.next = prev;                           // Reverse link
            prev = curr;                                // Move prev forward
            curr = next;                                // Move curr forward
            count++;
        }
        
        
        // Step 3: Recursively reverse rest of the list
        if (curr != null) {
            Node rest_head = reverseKGroup(curr, k);    // Recurse on remaining list
            head.next = rest_head;                      // Connect current tail to rest
        }
        
        
        return prev;                                    // prev is new head of this group
    }
}

