/*
class Node
{
    int data;
    Node next;
}
*/

class Solution {
    public static void removeLoop(Node head) {
        
        if (head == null || head.next == null) { return; }    // Base case: empty or single node
        
        Node slow = head, fast = head;
        
        
        // Step 1: Detect loop using Floyd's Cycle Detection
        while (fast != null && fast.next != null) {
            slow = slow.next;                       // Move slow by 1 step
            fast = fast.next.next;                  // Move fast by 2 steps
            
            if (slow == fast) {                     // Loop detected
                break;
            }
        }
        
        
        // Step 2: Check if loop actually exists
        if (fast != slow) {                         // No loop found
            return;
        }
        
        
        // Step 3: Find the start of the loop
        slow = head;                                // Reset slow to head
        
        
        // Special case: loop starts at head (slow == fast at head)
        if (slow == fast) {
            while (fast.next != slow) {
                fast = fast.next;                   // Find last node in loop
            }
        }
        else {
            // Move both until their next pointers meet
            while (slow.next != fast.next) {
                slow = slow.next;                   // Move from head
                fast = fast.next;                   // Move from meeting point
            }
        }
        
        
        // Step 4: Remove the loop
        fast.next = null;                           // Break the loop at last node
    }
}

