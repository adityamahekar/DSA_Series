
class Solution {
	public ArrayList<Integer> spirallyTraverse(int[][] mat) {

		ArrayList<Integer> list = new ArrayList<>();                     // store spiral order
		
		int r = mat.length, c = mat[0].length;
		int top = 0, left = 0, bottom = r - 1, right = c - 1;            // boundaries
		
		while (left <= right && top <= bottom) {

			for (int i = left; i <= right; i++) {
				list.add(mat[top][i]);                                  // left → right
			}
			top++;                                                      // move top boundary down

			for (int j = top; j <= bottom; j++) {
				list.add(mat[j][right]);                                // top → bottom
			}
			right--;                                                    // move right boundary left

			if (top <= bottom) {
				for (int k = right; k >= left; k--) {
					list.add(mat[bottom][k]);                           // right → left
				}
				bottom--;                                               // move bottom boundary up
			}

			if (left <= right) {
				for (int l = bottom; l >= top; l--) {
					list.add(mat[l][left]);                             // bottom → top
				}
				left++;                                                 // move left boundary right
			}
		}

		return list;                                                    // spiral traversal result
	}
}


