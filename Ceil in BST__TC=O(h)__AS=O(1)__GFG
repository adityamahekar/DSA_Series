class Solution {
    int findCeil(Node root, int x) {

        int res = -1;                          // stores ceil candidate

        while(root != null){

            if(root.data == x){                // exact match found
                return root.data;
            }

            if(root.data < x){                  // go right, need bigger
                root = root.right;
            }

            else if(root.data > x){             // possible ceil
                res = root.data;                // update res
                root = root.left;               // search smaller ceil
            }
        }

        return res;                             // return ceil or -1
    }
}

