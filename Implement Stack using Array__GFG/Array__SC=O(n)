class myStack {
    int arr[];                                              // Array to store stack elements
    int cap;                                                // Maximum capacity of stack
    int top;                                                // Index of top element
    
    public myStack(int n) {
        // Define Data Structures
        top = -1;                                           // Initialize top as -1 (empty)
        cap = n;                                            // Set capacity to n
        arr = new int[cap];                                 // Allocate array of size n
    }

    public boolean isEmpty() {
        // Check if the stack is empty
        if (top == -1) {                                    // Top is -1 means no elements
            return true;                                    // Stack is empty
        }
        return false;                                       // Stack has elements
    }

    public boolean isFull() {
        // Check if the stack is full
        if ((top + 1) == cap) {                             // Top reached last index
            return true;                                    // Stack is full
        }
        return false;                                       // Stack has space
    }

    public void push(int x) {
        // Inserts x at the top of the stack
        if (top == (cap - 1)) { return; }                   // Check overflow, return if full
        
        top++;                                              // Increment top index
        arr[top] = x;                                       // Store x at new top
    }

    public void pop() {
        // Removes an element from the top of the stack
        if (top == -1) { return; }                          // Check underflow, return if empty
        top--;                                              // Decrement top (element removed)
    }

    public int peek() {
        // Returns the top element of the stack
        if (top != -1) {                                    // Check stack not empty
            return arr[top];                                // Return element at top index
        }
        return -1;                                          // Return -1 if empty
    }
}

