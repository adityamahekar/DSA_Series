import java.util.ArrayList;

class myStack {
    ArrayList<Integer> list;                              // Dynamic list to store elements
    int cap;                                              // Maximum capacity of stack

    public myStack(int n) {
        // Define Data Structures
        cap = n;                                          // Set capacity to n
        list = new ArrayList<>(cap);                      // Initialize ArrayList with capacity
    }

    public boolean isEmpty() {
        // Check if the stack is empty
        return list.isEmpty();                            // Returns true if size is 0
    }

    public boolean isFull() {
        // Check if the stack is full
        return (list.size() == cap);                      // Returns true if size equals capacity
    }

    public void push(int x) {
        // Inserts x at the top of the stack
        if (!isFull()) {                                  // Check if not full before pushing
            list.add(x);                                  // Add x to end (top of stack)
        }
    }

    public void pop() {
        // Removes an element from the top of the stack
        if (list.isEmpty()) { return; }                   // Return if empty (underflow)
        
        list.remove(list.size() - 1);                     // Remove last element (top)
    }

    public int peek() {
        // Returns the top element of the stack
        if (list.isEmpty()) { return -1; }                // Return -1 if empty
        
        return list.get(list.size() - 1);                 // Return last element (top)
    }
}

