/*
Definition for Node
class Node {
    int data;
    Node left;
    Node right;
    Node(int data) {
        this.data = data;
        left = right = null;
    }
} */

class Solution {
    int res=0;                                                      // Stores max diameter (node count)
    
    int height(Node root){
          if(root == null){ return 0; }                             // Base case: null has height 0
          
          int lh = height(root.left);                               // Left subtree height
          int rh = height(root.right);                              // Right subtree height
          
          
          res = Math.max(res, lh+rh+1);                             // Update max diameter (nodes through this node)
          return Math.max(lh,rh)+1;                                 // Return height of current subtree
    }
    
    public int diameter(Node root) {

        if(root == null){ return 0; }                               // Base case: empty tree
        
        int h = height(root.left) + height(root.right);             // Diameter through root (edges)
        
        int l = diameter(root.left);                                // Diameter in left subtree
        
        int r = diameter(root.right);                               // Diameter in right subtree
        
        int max = Math.max(Math.max(l,r),h);                        // Max of left, right, and through root
        
        return max;                                                 // Return diameter (edges)
    }
}

//////////////////////// DRY RUN /////////////////////////////

Example 1: root = [1, 2, 3]

      1
     / \
    2   3

diameter(1):
  height(2): lh=0, rh=0 → res=max(0,1)=1, returns 1
  height(3): lh=0, rh=0 → res=max(1,1)=1, returns 1
  h = 1 + 1 = 2
  l = diameter(2) = 0 (leaf)
  r = diameter(3) = 0 (leaf)
  max = max(0, 0, 2) = 2

Output: 2

Example 2: root = [5, 8, 6, 3, 7, 9]

        5
       / \
      8   6
     / \   \
    3  7    9

Longest path: 3 → 8 → 5 → 6 → 9 (4 edges)

height(8) = 2, height(6) = 2
h = 2 + 2 = 4
Output: 4

//////////////////////// QUESTION ////////////////////////////

Diameter of a Binary Tree
Given the root of a binary tree, find the diameter.
The diameter (width) is the number of edges on the longest path between any two leaf nodes.
This path may or may not pass through the root.

Examples:

Input: root = [1, 2, 3]

      1
     / \
    2   3

Output: 2
Explanation: Longest path: 2 → 1 → 3 (2 edges)

Input: root = [5, 8, 6, 3, 7, 9]

        5
       / \
      8   6
     / \   \
    3  7    9

Output: 4
Explanation: Longest path: 3 → 8 → 5 → 6 → 9 (4 edges)

Constraints:
• 1 ≤ number of nodes ≤ 10^3
• 0 ≤ node->data ≤ 10^5
