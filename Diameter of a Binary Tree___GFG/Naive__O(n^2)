/*
Definition for Node
class Node {
    int data;
    Node left;
    Node right;
    Node(int data) {
        this.data = data;
        left = right = null;
    }
} */

class Solution {
    
    int height(Node root){
          if(root == null){ return 0; }                                       // Base case: null node has height 0
          
          return Math.max(height(root.left),height(root.right)) + 1;          // Height = max(left, right) + 1
    }
    
    public int diameter(Node root) {

        if(root == null){ return 0; }                                         // Base case: empty tree
        
        int h = height(root.left) + height(root.right);                       // Diameter through root
        
        int l = diameter(root.left);                                          // Diameter in left subtree
        
        int r = diameter(root.right);                                         // Diameter in right subtree
        
        int max = Math.max(Math.max(l,r),h);                                  // Max of left, right, and through root
        
        return max;                                                           // Return diameter
    }
}

//////////////////////// DRY RUN /////////////////////////////

Example: root = [1, 2, 3]

      1
     / \
    2   3

diameter(1):
  h = height(2) + height(3) = 1 + 1 = 2
  l = diameter(2) = 0 (leaf)
  r = diameter(3) = 0 (leaf)
  max = max(0, 0, 2) = 2
Output: 2

Example: root = [5, 8, 6, 3, 7, 9]

        5
       / \
      8   6
     / \   \
    3  7    9

Longest path: 3 → 8 → 5 → 6 → 9 (4 edges)
Output: 4

//////////////////////// QUESTION ////////////////////////////

Diameter of a Binary Tree
Given the root of a binary tree, find the diameter.
The diameter (width) is the number of edges on the longest path between any two leaf nodes.
This path may or may not pass through the root.

Examples:
------------------------------------------------------------------------------------
Input: root = [1, 2, 3]

      1
     / \
    2   3

Output: 2
Explanation: Longest path: 2 → 1 → 3 (2 edges)
--------------------------------------------------------------------------------
Input: root = [5, 8, 6, 3, 7, 9]

        5
       / \
      8   6
     / \   \
    3  7    9

Output: 4
Explanation: Longest path: 3 → 8 → 5 → 6 → 9 (4 edges)
-----------------------------------------------------------------------------
Constraints:
• 1 ≤ number of nodes ≤ 10^3
• 0 ≤ node->data ≤ 10^5
