class Solution {
    public static int getMaxArea(int arr[]) {
        int n = arr.length;
        ArrayDeque<Integer> st = new ArrayDeque<>();         // Stack stores indices of bars
        int res = 0;                                          // Maximum area found
        int curr;                                             // Current area

        for(int i = 0; i < n; i++){                          // Go through each bar
            while(!st.isEmpty() && arr[st.peek()] >= arr[i]){ // Current bar shorter than stack top
                int tp = st.pop();                            // Pop taller bar
                curr = arr[tp] * (st.isEmpty() ? i : (i - st.peek() - 1));     // Area = height x width
                res = Math.max(res, curr);                    // Update max
            }
            st.push(i);                                       // Push current index
        }

        while(!st.isEmpty()){                                 // Process remaining bars
            int tp = st.pop();                                // Pop bar
            curr = arr[tp] * (st.isEmpty() ? n : (n - st.peek() - 1)); // Area to end
            res = Math.max(res, curr);                        // Update max
        }

        return res;                                           // Return largest area
    }
}

