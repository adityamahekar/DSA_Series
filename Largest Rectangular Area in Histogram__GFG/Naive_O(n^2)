class Solution {
    public static int getMaxArea(int arr[]) {

        int n = arr.length;
        int res = 0;
        
        
        for(int i = 0; i < n; i++){            // Iterate through each bar in the histogram
            int curr = arr[i];                    // Start with current bar's height as area (width=1 initially)
            
            
            for(int j = i - 1; j >= 0; j--){
                if(arr[j] >= arr[i]){
                    curr += arr[i];                        // Add current bar's height for each valid left bar
                }
                else{
                    break;                              // Stop when we find a smaller bar
                }
            }
            
                                                          // Expand rightwards while bars are >= current bar's height
            for(int k = i + 1; k < n; k++){
                if(arr[k] >= arr[i]){
                    curr += arr[i];                          // Add current bar's height for each valid right bar
                }
                else{
                    break;                                // Stop when we find a smaller bar
                }
            }
            
            res = Math.max(res, curr);                    // Update maximum area found so far
        }        
        
        return res;
    }
}

