    class Solution {
        public List<List<Integer>> printGraph(int V, int edges[][]) {

            List<List<Integer>> adj = new ArrayList<>(V);                // adjacency list for V nodes

            for(int i=0;i<V;i++){                                        // visit every node
                adj.add(new ArrayList<Integer>());                       // empty list for node i
            }

            for(int edge[]: edges){                                      // visit every edge
                int u = edge[0];                                         // first end
                int v = edge[1];                                         // second end

                adj.get(u).add(v);                                       // u -> v
                adj.get(v).add(u);                                       // v -> u (undirected)
            }

            return adj;                                                  // final adjacency list
        }
    }

