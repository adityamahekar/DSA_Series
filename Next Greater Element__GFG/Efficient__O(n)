class Solution {
    public ArrayList<Integer> nextLargerElement(int[] arr) {

        ArrayList<Integer> list = new ArrayList<>();
        ArrayDeque<Integer> st = new ArrayDeque<>();
        
        int n = arr.length;
        
        list.add(-1);                        // Last element has no NGE
        st.push(arr[n-1]);                   // Push last element to stack
        
        for(int i = n - 2; i >= 0; i--){     // Traverse from right to left
            while(!st.isEmpty() && st.peek() <= arr[i]){
                st.pop();                    // Pop smaller/equal elements
            }
            
            int gN = st.isEmpty() ? -1 : st.peek();  // Get NGE or -1
            list.add(gN);
            
            st.push(arr[i]);                 // Push current element
        }
        
        Collections.reverse(list);           // Reverse to match original order
        return list;
    }
}

