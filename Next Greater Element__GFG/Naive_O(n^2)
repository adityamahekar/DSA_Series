class Solution {
    public ArrayList<Integer> nextLargerElement(int[] arr) {

        ArrayList<Integer> list = new ArrayList<>();          // Result list to store Next Greater Element for each element
        
        int n = arr.length;                                 // Get array size
        
                                                                  // Iterate through each element in the array
        for(int i = 0; i < n; i++){
            int j;
                                                                            // Search for next greater element on the right side (starting from i+1)
            for(j = i + 1; j < n; j++){
                if(arr[j] > arr[i]){                  // Found first element greater than current
                    list.add(arr[j]);                 // Add it to result
                    break;                            // Stop searching (first greater only)
                }
            }
                                                      // If loop completed without finding greater element (j reached n)
            if(j == n){
                list.add(-1);                         // Add -1 for no next greater element
            }
        }
        
        return list;                                  // Return all Next Greater Elements
    }
}

