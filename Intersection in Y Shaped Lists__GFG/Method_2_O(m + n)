/*
class Node {
    int data;
    Node next;

    Node(int d) {
        data = d;
        next = null;
    }
}
*/

class Solution {
    public Node intersectPoint(Node head1, Node head2) {

        HashSet<Node> set = new HashSet<>();                // Store node references from list1
        Node curr = head1;
        
        while (curr != null) {                              // Traverse list1
            set.add(curr);                                  // Add node reference to set
            curr = curr.next;
        }
        
        Node cur2 = head2;
        
        while (cur2 != null) {                              // Traverse list2
            if (set.contains(cur2)) {                       // Same node reference found?
                return cur2;                                // Return intersection node
            }
            cur2 = cur2.next;
        }
        
        return null;                                        // No intersection (won't happen per problem)
    }
}

