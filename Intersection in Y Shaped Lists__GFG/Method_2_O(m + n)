/*
class Node {
    int data;
    Node next;

    Node(int d) {
        data = d;
        next = null;
    }
}
*/

class Solution {
    public Node intersectPoint(Node head1, Node head2) {

        Node cur1 = head1, cur2 = head2;
        
        int count1 = 0, count2 = 0;
        
        while (cur1 != null) { count1++; cur1 = cur1.next; }            // Count nodes in list1
        while (cur2 != null) { count2++; cur2 = cur2.next; }            // Count nodes in list2
        
        Node ncur1 = head1, ncur2 = head2;
        int diff = Math.abs(count1 - count2);
        int i = 0;
        
        if (count1 > count2) {                                          // List1 is longer, advance ncur1
            while (i < diff) { ncur1 = ncur1.next; i++; }
        } else {                                                        // List2 is longer, advance ncur2
            while (i < diff) { ncur2 = ncur2.next; i++; }
        }
        
        while (ncur1 != null) {                                         // Move both until match
            if (ncur1 == ncur2) { return ncur1; }                       // Same node reference found
            ncur1 = ncur1.next;
            ncur2 = ncur2.next;
        }
        
        return null;                                                    // No intersection (won't reach here)
    }
}

