                                                            // Stack class
class myStack {

    Node head;                                              // Head points to top of stack
    int count;                                              // Track size for O(1) access

    public myStack() {
                                                            // Initialize your data members
        head = null;                                        // Empty stack
        count = 0;                                          // Zero elements
    }

    public boolean isEmpty() {
                                                            // Check if the stack is empty
        return (head == null);                              // True if no nodes
    }

    public void push(int x) {
                                                            // Insert x at the top of the stack
        Node temp = new Node(x);                            // Create new node
        temp.next = head;                                   // Link new node to current head
        head = temp;                                        // Update head to new node
        count++;                                            // Increment size
    }

    public void pop() {
                                                              // Remove the top element from the stack
        if (head == null) { return; }                       // Underflow check
        
        head = head.next;                                   // Move head to next node
        count--;                                            // Decrement size
    }

    public int peek() {
                                                            // Return the top element of the stack
        if (head == null) {                                 // Empty check
            return -1;                                      // Return -1 if empty
        }
        
        return head.data;                                   // Return data at head
    }

    public int size() {
                                                            // Return the current size of the stack
        return count;                                       // O(1) return
    }
}

