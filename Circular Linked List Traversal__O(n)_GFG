/* Node of a linked list
 class Node{
    int data;
    Node next;

    Node(int x){
        data = x;
        next = null;
    }
}
*/

class Solution {
    void printList(Node head) {                     // Function to print circular linked list

        Node curr = head;                           // Start traversal from head

        while(curr.next != head){                   // Loop until last node (whose next = head)
            System.out.print(curr.data + " ");      // Print current node's data
            curr = curr.next;                       // Move to next node
        }
        System.out.print(curr.data + " ");          // Print last node (outside loop)
    }
}

