
class Solution {
    public List<Integer> frequencyCount(int[] arr) {

        ArrayList<Integer> list   = new ArrayList<>();        // stores result
        int                n      = arr.length;               // array size
        int[]              freq   = new int[n + 1];           // freq[0..n] = 0

        for(int i = 0; i < n; i++){
            freq[arr[i]]++;                                   // increment freq of arr[i]
        }

        for(int f = 1; f < freq.length; f++){
            list.add(freq[f]);                                // add freq of each 1..n
        }

        return list;                                          // [0,2,2,0,1] ✅
    }
}

