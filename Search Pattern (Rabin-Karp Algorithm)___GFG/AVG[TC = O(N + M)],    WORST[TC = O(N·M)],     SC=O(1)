class Solution {
    public ArrayList<Integer> rabinKarp(String text, String pattern) {

        int M = pattern.length();                                  // pattern length
        int N = text.length();                                     // text length

        ArrayList<Integer> list = new ArrayList<>();

---------------------| Compute |----------------------------

        int h = 1, d = 256, q = 101;                              // d=alphabet  q=prime  h=d^(M-1)%q

        for (int i = 0; i < M - 1; i++) {
            h = (h * d) % q;                                       // h = d^(M-1)%q  weight of leftmost char
        }

---------------------| Compute p and t_0 |----------------------------

        int p = 0, t = 0;                                         // p=pattern hash  t=first window hash
        for (int i = 0; i < M; i++) {
            p = (p * d + pattern.charAt(i)) % q;                  // hash = (hash*d + char)%q  builds a·d²+b·d+c
            t = (t * d + text.charAt(i)) % q;                     // same formula for first window
        }

        for (int i = 0; i <= N - M; i++) {

---------------------| Check for spurious hit |----------------------------

            if (p == t) {                                          // hash match → verify (collision possible)
                boolean flag = true;
                for (int j = 0; j < M; j++) {
                    if (text.charAt(i + j) != pattern.charAt(j)) {
                        flag = false;                              // mismatch → not a real match
                        break;
                    }
                }
                if (flag) {
                    list.add(i);                                   // confirmed match → store index
                }
            }

-----------------------| Compute t_{i+1}  using t_i |----------------------------

            if (i < N - M) {
                t = ((d * (t - text.charAt(i) * h)
                        + text.charAt(i + M)) % q);               // roll: -txt[i]*h drops left  +txt[i+M] adds right
                if (t < 0) { t = t + q; }                         // java mod can be negative → fix with +q
            }
        }                                                          // O(N+M) avg  O(N*M) worst (all collisions)

        return list;
    }
}

