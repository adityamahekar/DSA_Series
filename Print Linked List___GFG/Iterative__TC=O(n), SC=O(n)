/*
class Node {
    int data;                                     // Stores integer value
    Node next;                                    // Pointer to next node
    Node(int x) {                                 // Constructor
        data = x;                                 // Initialize data
        next = null;                              // Next is null by default
    }
}*/
class Solution {
    public ArrayList<Integer> printList(Node head) {        // Takes head node as input
        ArrayList<Integer> list = new ArrayList<>();        // Result list
        Node curr = head;                                   // Start from head
        
        while(curr != null){                               // Traverse till end
            list.add(curr.data);                           // Add data to list
            curr = curr.next;                              // Move to next node
        }
        return list;                                       // Return final list
    }
}

//////////////////////// DRY RUN /////////////////////////////

Linked List:

  [1] → [2] → [3] → null

            ↓ printList()

ArrayList:
  ┌───┬───┬───┐
  │ 1 │ 2 │ 3 │
  └───┴───┴───┘
   [0] [1] [2]

-----------------------------------------------------

Step-by-Step Traversal:


curr                      ArrayList
  ─────────────────────────────────────────
  [1] → [2] → [3] → null   add(1) → [1]
   ↑

  [1] → [2] → [3] → null   add(2) → [1, 2]
         ↑

  [1] → [2] → [3] → null   add(3) → [1, 2, 3]
               ↑

  [1] → [2] → [3] → null   STOP ✅
                     ↑
  ─────────────────────────────────────────
  return [1, 2, 3]


