/*
class Node {
    int data;
    Node next;
    Node(int x) {
        data = x;
        next = null;
    }
}*/

class Solution {
    public ArrayList<Integer> printList(Node head) {
        ArrayList<Integer> list = new ArrayList<Integer>();

        if (head == null) return list;              // base case: end of list, return empty

        list.add(head.data);                        // add current node's value
        list.addAll(printList(head.next));          // recursively add remaining nodes

        return list;                                // return collected values
    }
}

