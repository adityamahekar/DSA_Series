class Solution {
    void fill(String pat, int lps[]) {
        int len = 0;                          // length of prev longest prefix suffix
        int i = 1;
        
        lps[0] = 0;                           // first value always 0
        
        while (i < pat.length()) {
            if (pat.charAt(i) == pat.charAt(len)) {  // characters match
                len++;
                lps[i] = len;                 // store length
                i++;
            } else {
                if (len != 0) {
                    len = lps[len - 1];       // fall back using lps itself
                } else {
                    lps[i] = 0;              // no prefix suffix, set 0
                    i++;
                }
            }
        }
    }

    ArrayList<Integer> search(String pat, String txt) {
        ArrayList<Integer> list = new ArrayList<>();

        int N = txt.length();                 // length of text
        int M = pat.length();                 // length of pattern
        int i = 0, j = 0;                    // i → txt pointer, j → pat pointer

        int lps[] = new int[M];

        fill(pat, lps);                       // precompute lps array

        while (i < N) {
            if (pat.charAt(j) == txt.charAt(i)) {  // characters match, move both
                i++; j++;
            }

            if (j == M) {                    // full pattern matched
                list.add(i - j);             // store start index
                j = lps[j - 1];             // look for next match using lps
            }

            else if (i < N && pat.charAt(j) != txt.charAt(i)) {  // mismatch
                if (j == 0) {
                    i++;                     // no prefix to fall back, move txt
                } else {
                    j = lps[j - 1];         // fall back j using lps
                }
            }
        }

        return list;                         // return all match start indices
    }
}

