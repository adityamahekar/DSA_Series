class Solution {
    
    static int prec(char c){                                // Get operator precedence
        if(c == '^') return 3;
        if(c == '*' || c == '/') return 2;
        if(c == '+' || c == '-') return 1;
        return -1;
    }
    
    public String infixToPrefix(String s) { 
        
        s = new StringBuilder(s).reverse().toString();                      // Reverse string
        
        char arr[] = s.toCharArray();                              // Convert to char array
        
        for(int i = 0; i < arr.length; i++){                              // Swap parentheses
            if(arr[i] == '(') arr[i] = ')';
            else if(arr[i] == ')') arr[i] = '(';
        }
        
       Stack<Character> st = new Stack<>();                                  // Operator stack
       StringBuilder sb = new StringBuilder();                                // Output buffer
       
       for(char c : arr){                                                        // Process each character
           
           if(c == '(') st.push(c);                                              // Push opening parenthesis
           else if(c == ')') {                                                // Pop until matching parenthesis
               while(!st.isEmpty() && st.peek() != '('){
                   sb.append(st.pop());
               }
               st.pop();
           }
           else if(Character.isLetterOrDigit(c)) sb.append(c);                    // Output operand
           
           else{                                                                    // Handle operator precedence
               while(!st.isEmpty() && st.peek() != '(' && 
                     (prec(c) < prec(st.peek()) ||
                     (prec(c) == prec(st.peek()) && c == '^'))){
                   sb.append(st.pop());                                          // Pop higher precedence operators
               }
               st.push(c);                                                  // Push current operator
           }
       }
       
        while(!st.isEmpty()) sb.append(st.pop());                            // Empty remaining stack
        
        return sb.reverse().toString();                                  // Final reverse gives prefix
    }
}

