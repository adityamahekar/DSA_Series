/* Structure of a Binary Search Tree node
class Node {
    public int data;
    public Node left;
    public Node right;
    public Node(int val) {
        data = val;
        left = right = null;
    }
}; */
class Solution {
    
    Node getSucc(Node root){
        Node cur = root.right;
        while(cur != null && cur.left != null){
            cur = cur.left;                                     // go to leftmost node
        }
        return cur;                                              // smallest in right subtree
        
    }
    public Node delNode(Node root, int x) {
        
        if(root == null){ return null; }                         // not found
        
        if(root.data < x){
            root.right = delNode(root.right,x);                  // go right
        }
        else if(root.data > x){
            root.left = delNode(root.left,x);                    // go left
        }
        
        else{
            if(root.left == null){ return root.right; }           // no left child
            
            else if(root.right == null){ return root.left; }      // no right child
            
            else{
                Node succ = getSucc(root);                        // find inorder successor
                root.data = succ.data;                            // copy value
                root.right = delNode(root.right,succ.data);       // delete successor
            }
            
           
        }
         return root;
    }
}

