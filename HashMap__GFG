import java.util.*;

class Test {
    public static void main(String args[]) {
        HashMap<String, Integer> hm = new HashMap<>();        // create empty HashMap
        hm.put("One",   10);                                  // adds "One"   -> 10
        hm.put("Two",   20);                                  // adds "Two"   -> 20
        hm.put("Three", 30);                                  // adds "Three" -> 30

        System.out.println(hm);                               // output => {One=10, Two=20, Three=30}
        System.out.println(hm.size());                        // output => 3

        for (Map.Entry<String, Integer> e : hm.entrySet()) {  // fixed: Map.Entry, entrySet()
            System.out.println(e.getValue() + " " + e.getKey()); // output => 10 One
        }                                                        //        => 20 Two
                                                                 //        => 30 Three

        if (hm.containsKey("One")) {                          // fixed: ternary -> if block
            System.out.println("Yes");                        // output => Yes
        } else {
            System.out.println("No");
        }

        if (hm.containsValue(20)) {                           // fixed: ternary -> if block
            System.out.println("Yes");                        // output => Yes
        } else {
            System.out.println("No");
        }

        System.out.println(hm.get("Three"));                  // output => 30
        System.out.println(hm.get("Zero"));                   // output => null
        hm.remove("Two");                                     // removes "Two" -> 20 from map
    }
}


