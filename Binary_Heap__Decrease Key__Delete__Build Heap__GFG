====================== Decrease Key ===========================

int arr[];
int size, capacity;

void decreaseKey(int i, int x){
    arr[i] = x;                                     // set new smaller value

    while(i != 0 && arr[parent(i)] > arr[i]){         // violates min heap
        swap(arr[parent(i)], arr[i]);                 // move value up
        i = parent(i);                                // move to parent index
    }
}

====================== Delete ===========================

void deleteKey(int i){
    decreaseKey(i, INT_MIN);                          // push value to root
    extractMin();                                     // remove it from heap
}

====================== Build Heap ===========================
TC=O(n)

Maximum number of nodes at height h: ⌈ n / 2^(h+1) ⌉

void buildHeap(){
    for(int i = (size-2)/2; i >= 0; i--){              // start from last internal node
        minHeapify(i);                                 // fix heap at each node
    }
}

