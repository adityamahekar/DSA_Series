class Solution {
    public int activitySelection(int[] start, int[] finish) {

        int n = start.length;

        Integer[] idx = new Integer[n];

        for(int i=0;i<n;i++)
            idx[i] = i;

        Arrays.sort(idx, (a,b) -> Integer.compare(finish[a], finish[b]));

        int count = 0;
        int lastFinish = -1;

        for(int i : idx){
            if(start[i] > lastFinish){
                count++;
                lastFinish = finish[i];
            }
        }

        return count;
    }
}


