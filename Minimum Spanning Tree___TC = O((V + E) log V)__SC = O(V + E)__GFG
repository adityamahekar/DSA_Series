class Solution {
    public int spanningTree(int V, int[][] edges) {
        ArrayList<ArrayList<int[]>> adj = new ArrayList<>();                   // adjacency list
        for (int i = 0; i < V; i++)                                            // empty rows
            adj.add(new ArrayList<>());
        for (int[] e : edges) {
            adj.get(e[0]).add(new int[]{e[1], e[2]});                          // u -> v
            adj.get(e[1]).add(new int[]{e[0], e[2]});                          // v -> u (undirected)
        }

        boolean[] vis = new boolean[V];                                        // in MST ?
        PriorityQueue<int[]> pq = new PriorityQueue<>((a, b) -> a[1] - b[1]);  // min-heap by wt
        pq.add(new int[]{0, 0});                                               // start node 0
        int sum = 0;                                                           // MST weight
        while (!pq.isEmpty()) {
            int[] cur = pq.poll();                                             // cheapest edge
            int u = cur[0], wt = cur[1];
            if (vis[u]) continue;                                              // already taken
            vis[u] = true;                                                     // add to MST
            sum += wt;                                                         // add its weight
            for (int[] e : adj.get(u))                                         // push neighbours
                if (!vis[e[0]])
                    pq.add(new int[]{e[0], e[1]});
        }
        return sum;                                                            // answer
    }
}

//////////////////////// DRY RUN /////////////////////////////

Example 1:  V = 3,  edges = [[0,1,5], [1,2,3], [0,2,1]]

   (0) ---5--- (1)
     \         /
      1       3
       \     /
         (2)

   pq {v, wt}      vis          sum
   {0,0}           -            0
   {1,5} {2,1}     0            0
   {1,3}           0,2          1
   -               0,2,1        4

   MST edges : 0-2 (1), 2-1 (3)
   answer    : 4

