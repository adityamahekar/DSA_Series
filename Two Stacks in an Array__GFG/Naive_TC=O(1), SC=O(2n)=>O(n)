//////////////////////// CODE ////////////////////////////////

class twoStacks {
    
    int top1;                                               // Top index for stack1
    int top2;                                               // Top index for stack2
    int size;                                               // Capacity of each stack
    int arr1[];                                             // Array for stack1
    int arr2[];                                             // Array for stack2
    
    twoStacks() {
        size = 200;                                         // Default capacity
        
        arr1 = new int[size];                               // Allocate array for stack1
        arr2 = new int[size];                               // Allocate array for stack2

        top1 = -1;                                          // Stack1 empty
        top2 = -1;                                          // Stack2 empty
    }

                                                            // Function to push an integer into stack1
    void push1(int x) {
        top1++;                                             // Increment top1
        arr1[top1] = x;                                     // Store x in arr1
    }

                                                            // Function to push an integer into stack2
    void push2(int x) {
        top2++;                                             // Increment top2
        arr2[top2] = x;                                     // Store x in arr2
    }

                                                             // Function to remove an element from stack1
    int pop1() {
        if (top1 == -1) {                                   // Check underflow
            return -1;                                      // Stack1 empty
        }
        int val = arr1[top1];                               // Get top value
        top1--;                                             // Decrement top1
        return val;                                         // Return popped value
    }

                                                            // Function to remove an element from stack2
    int pop2() {
        if (top2 == -1) {                                   // Check underflow
            return -1;                                      // Stack2 empty
        }
        int val = arr2[top2];                               // Get top value
        top2--;                                             // Decrement top2
        return val;                                         // Return popped value
    }
}

//////////////////////// DRY RUN /////////////////////////////

Example: push1(2), push1(3), push2(4), pop1(), pop2(), pop2()

