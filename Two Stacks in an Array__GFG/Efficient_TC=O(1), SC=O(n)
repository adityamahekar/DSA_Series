class twoStacks {
    
    int top1;                                               // Top index for stack1 (grows from left)
    int top2;                                               // Top index for stack2 (grows from right)
    int size;                                               // Total capacity of array
    int arr[];                                              // Single array for both stacks
    
    twoStacks() {
        size = 200;                                         // Default capacity
        
        arr = new int[size];                                // Allocate single array
        top1 = -1;                                          // Stack1 starts from left (empty)
        top2 = size;                                        // Stack2 starts from right (empty)
    }

                                                            // Function to push an integer into stack1
    void push1(int x) {
        top1++;                                             // Increment top1 (move right)
        arr[top1] = x;                                      // Store x at new top1
    }

                                                            // Function to push an integer into stack2
    void push2(int x) {
        top2--;                                             // Decrement top2 (move left)
        arr[top2] = x;                                      // Store x at new top2
    }

                                                            // Function to remove an element from stack1
    int pop1() {
        if (top1 == -1) {                                   // Check underflow
            return -1;                                      // Stack1 empty
        }
        int val = arr[top1];                                // Get top value
        top1--;                                             // Decrement top1
        return val;                                         // Return popped value
    }

                                                            // Function to remove an element from stack2
    int pop2() {
        if (top2 == size) {                                 // Check underflow
            return -1;                                      // Stack2 empty
        }
        int val = arr[top2];                                // Get top value
        top2++;                                             // Increment top2
        return val;                                         // Return popped value
    }
}

