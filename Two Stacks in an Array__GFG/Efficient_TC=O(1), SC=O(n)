             Else                   Ignore (overflow)
push2(x)     top1+1 < top2          top2--, arr[top2]=x         O(1)
             Else                   Ignore (overflow)
pop1()       top1 == -1             Return -1                   O(1)
             Else                   val=arr[top1], top1--
pop2()       top2 == size           Return -1                   O(1)
             Else                   val=arr[top2], top2++


