Min Heap

class Test{
  public static void main(String args[]){
      PriorityQueue<Integer> pq = new PriorityQueue<Integer>();       // min heap by default

      pq.add(10);                                                     // insert 10
      pq.add(20);                                                     // insert 20
      pq.add(15);                                                     // insert 15

      System.out.println(pq.peek());                                  // smallest element, no removal
      System.out.println(pq.poll());                                  // remove and return smallest
      System.out.println(pq.peek());                                  // new smallest element

  }
}

