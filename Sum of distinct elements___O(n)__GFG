
class Solution {
    int findSum(int arr[]) {
        int sum = 0;                           // stores final sum
        HashSet<Integer> set = new HashSet<>();// stores unique elements

        for(int x : arr){
            set.add(x);                        // duplicates auto ignored
        }

        for(int l : set){
            sum += l;                          // add each unique element
        }

        return sum;                            // return sum of unique
    }
}

