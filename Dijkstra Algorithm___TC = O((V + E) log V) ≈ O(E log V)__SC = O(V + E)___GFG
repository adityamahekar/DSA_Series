import java.util.*;

class Solution {

    static class Pair implements Comparable<Pair> {
        int node, dist;

        Pair(int node, int dist) {
            this.node = node;
            this.dist = dist;
        }

        public int compareTo(Pair other) {
            return Integer.compare(this.dist, other.dist);
        }
    }

    public ArrayList<Integer> dijkstra(
        ArrayList<ArrayList<ArrayList<Integer>>> adj, int src) {

        int V = adj.size();
        int[] dist = new int[V];
        Arrays.fill(dist, Integer.MAX_VALUE);          // Initialize distances

        dist[src] = 0;                                 // Source distance
        PriorityQueue<Pair> pq = new PriorityQueue<>();
        pq.add(new Pair(src, 0));                       // Add source

        while (!pq.isEmpty()) {

            Pair cur = pq.poll();
            int u = cur.node, d = cur.dist;

            if (d > dist[u]) continue;                  // Skip outdated entry

            for (ArrayList<Integer> edge : adj.get(u)) {

                int v = edge.get(0);
                int wt = edge.get(1);

                if (dist[u] + wt < dist[v]) {           // Relax edge

                    dist[v] = dist[u] + wt;             // Update distance
                    pq.add(new Pair(v, dist[v]));        // Add updated pair
                }
            }
        }

        ArrayList<Integer> res = new ArrayList<>(V);

        for (int d : dist) res.add(d);                  // Store distances

        return res;
    }
}


