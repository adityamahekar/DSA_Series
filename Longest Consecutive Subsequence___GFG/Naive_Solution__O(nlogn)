
class Solution {
    public int longestConsecutive(int[] arr) {
    
        int n = arr.length, curr = 1, res=1;
        
        Arrays.sort(arr);                          // sort to bring consecutive elements together
        
        for(int i=1;i<n;i++){
            if(arr[i] == arr[i-1]+1){             // next consecutive element found
                curr++;                            // extend current streak
            }
            else if(arr[i] == arr[i-1]){          // duplicate element
                continue;                          // skip, don't reset streak
            }
            else{                                  // streak broken
                res = Math.max(res,curr);          // update max before reset
                curr=1;                            // reset current streak
            }
        }
        
        return Math.max(res,curr);                 // handle last streak
    }
}

