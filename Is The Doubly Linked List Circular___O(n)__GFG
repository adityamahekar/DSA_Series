class Solution {
    public static boolean isCircular(Node head) {
        if (head == null) {                // Empty list is considered circular
            return true;
        }
        Node curr = head;                  // Start from head
        while (curr.next != head) {        // Traverse until we reach head again
            if (curr.next == null) {       // If we hit null, not circular
                return false;
            }
            curr = curr.next;              // Move to next node
        }
        return true;                       // Reached head → circular
    }
}


