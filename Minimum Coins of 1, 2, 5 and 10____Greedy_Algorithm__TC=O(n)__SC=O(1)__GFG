//////////////////////// CODE ////////////////////////////////

class Solution {
    public int findMin(int n) {
        int[] arr = {10, 5, 2, 1};
        int p = n;
        int res = 0;

        for(int i = 0; i < arr.length; i++) {       // Traverse denominations
            if(arr[i] <= p) {                       // Check coin value
                int c = p / arr[i];                 // Count coins
                res = res + c;                      // Add to result
                p %= arr[i];                        // Update remaining value
            }

            if(p == 0) {                            // Check completion
                break;
            }
        }
        return res;                                 // Return minimum coins
    }
}


