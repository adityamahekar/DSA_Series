class Solution {
    public boolean isBridge(int V, int[][] edges, int c, int d) {
        List<int[]>[] adj = new ArrayList[V];                                     // adj list holds (neighbour, edge id)
        for (int i = 0; i < V; i++) adj[i] = new ArrayList<>();                   // create every bucket
        int targetEdge = -1;                                                      // id of the edge c-d
        for (int i = 0; i < edges.length; i++) {                                  // one pass over all edges
            int u = edges[i][0], v = edges[i][1];                                 // endpoints of edge i
            adj[u].add(new int[]{v, i});                                          // store neighbour + edge id
            adj[v].add(new int[]{u, i});                                          // same edge, other side
            if (targetEdge == -1 && ((u == c && v == d) || (u == d && v == c))) { // found c-d edge
                targetEdge = i;                                                   // remember its index
            }
        }
        if (targetEdge == -1) return false;                                       // edge does not exist
        boolean[] visited = new boolean[V];                                       // DFS visited array
        Deque<Integer> stack = new ArrayDeque<>();                                // iterative DFS stack
        visited[c] = true;                                                        // start DFS from c
        stack.push(c);                                                            // push source
        while (!stack.isEmpty()) {                                                // keep going till stack empty
            int u = stack.pop();                                                  // take next vertex
            for (int[] e : adj[u]) {                                              // walk all neighbours of u
                int v = e[0], id = e[1];                                          // neighbour and its edge id
                if (id == targetEdge) continue;                                   // pretend c-d is deleted
                if (!visited[v]) {                                                // only unvisited ones
                    visited[v] = true;                                            // mark before pushing
                    stack.push(v);                                                // push it
                }
            }
        }
        return !visited[d];                                                       // d unreachable => it is a bridge
    }
}

