
class Solution {
    public int equalSumSpan(int[] a1, int[] a2) {
        HashMap<Integer, Integer> hm = new HashMap<>();
        hm.put(0,-1);                                 // base case: sum 0 seen at index -1
        
        int n = a1.length, sum=0,res=0;
        
        int temp[] = new int[n];
        
        for(int i=0;i<n;i++){
            temp[i] = a1[i] - a2[i];                 // difference array trick
        }
        
        for(int j=0;j<n;j++){
            
            sum += temp[j];                           // prefix sum of difference array
            
            if(sum == 0){                             // whole subarray from start has equal sum
                res = Math.max(res, j-hm.get(0));     // span = j - (-1) = j+1
            }
            
            if(!hm.containsKey(sum)){                 // first occurrence of this sum
                hm.put(sum,j);                        // store index for future use
            }
            else{                                     // sum seen before
                res = Math.max(res,j-hm.get(sum));    // update max span length
            }
        }
        return res;                                   // return longest equal sum span
    }
}

////////////////////////////////////////////////////////////////

Idea:
* Compute difference array a1[i]-a2[i], problem reduces to longest subarray with sum = 0.
* Use HashMap to store first occurrence of prefix sum; same prefix sum twice means zero-sum subarray between those indices.
