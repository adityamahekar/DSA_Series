
class Solution {
    public int equalSumSpan(int[] a1, int[] a2) {
        int res=0;                                    // stores the maximum span length
        for(int i=0;i<a1.length;i++){
            int sum1=0, sum2=0;                       // reset sums for each new start
            
            for(int j=i;j<a1.length;j++){
                sum1 += a1[j];                        // prefix sum of array 1
                sum2 += a2[j];                        // prefix sum of array 2
                
                if(sum1 == sum2){                     // equal sums, update max span
                    res = Math.max(res, j-i+1);       // update result
                }
            }
        }
        return res;                                   // return longest equal sum span
    }
}

