class Solution {
    static ArrayList<Integer> preGreaterEle(int[] arr) {
        
        ArrayList<Integer> list = new ArrayList<>();                   // Result list to store Previous Greater Element for each position
        int n = arr.length;
        
        ArrayDeque<Integer> st = new ArrayDeque<>();                // Stack to keep track of potential Previous Greater Elements          // Elements in stack are in decreasing order from bottom to top
        
        for(int i = 0; i < n; i++){                                      // Traverse array from left to right (i = 0 to n-1)
            while(!st.isEmpty() && st.peek() <= arr[i]){                // Pop elements <= current element (they can't be PGE for current or future)
                st.pop();
            }

            list.add(st.isEmpty() ? -1 : st.peek());                              // If stack empty → no greater element to left → add -1        // Else → top of stack is the nearest greater element to left

            st.push(arr[i]);                                                   // Push current element onto stack for future comparisons
        }
        
        return list;
    }
}

