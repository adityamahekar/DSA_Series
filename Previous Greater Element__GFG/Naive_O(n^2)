class Solution {
    static ArrayList<Integer> preGreaterEle(int[] arr) {

        ArrayList<Integer> list = new ArrayList<>();  // Result list to store PGE for each element
        int n = arr.length;                           // Get array size
        
                                                      // Iterate through each element in the array
        for(int i = 0; i < n; i++){
            int j;
            boolean found = false;                    // Flag to track if PGE is found

                                                      // Scan leftwards from current element (i-1 down to 0)
            for(j = i - 1; j >= 0; j--){
                if(arr[i] < arr[j]){                  // Found first element strictly greater than current
                    list.add(arr[j]);                 // Add PGE to result
                    break;                            // Stop scanning (first greater only)
                }
            }
            
                                                      // If loop completed without break (j became -1)
            if(j == -1){
                list.add(-1);                         // Add -1 for no PGE
            }
        }
        
        return list;                                  // Return all PGEs
    }
}

