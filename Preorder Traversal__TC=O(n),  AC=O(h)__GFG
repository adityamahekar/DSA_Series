        left = null;
        right = null;
    }
}
*/

class Solution {
    public ArrayList<Integer> preOrder(Node root) {

        ArrayList<Integer> list = new ArrayList<>();           // Creates list to store traversal result
        
        preOrder(root,list);                                   // Calls helper method to fill the list
        
        return list;                                           // Returns the final preorder traversal
    }
    
    void preOrder(Node root, ArrayList<Integer> list){         // Recursive helper for preorder traversal
        
        if(root != null){                                      // Base case: stop if node is null
            list.add(root.data);                               // Add current node's data to list first
            preOrder(root.left,list);                          // Recursively visit left subtree next
            preOrder(root.right,list);                         // Recursively visit right subtree last
        }
    }
}

