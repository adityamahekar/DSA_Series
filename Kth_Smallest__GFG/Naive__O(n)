class Solution {
int count=0;                                      // Count visited nodes


public int kthSmallest(Node root, int k) {
    
        if(root == null){                            // If node is null
            return -1;                               // Element not found
        }
        
        int left = kthSmallest(root.left,k);         // Check left subtree
        if(left != -1){                              // If answer found
            return left;                             // Return answer
        }
        
        count++;                                     // Count current node
        
        if(count == k){                              // If kth node
            return root.data;                        // Return its value
        }
        
        return kthSmallest(root.right,k);             // Check right subtree
    }


}

