class Solution {
    static ArrayList<Integer> articulationPoints(int V, int[][] edges) {
        ArrayList<ArrayList<Integer>> adj = new ArrayList<>();    // adjacency list
        for (int i = 0; i < V; i++) adj.add(new ArrayList<>());
        for (int[] e : edges) {
            adj.get(e[0]).add(e[1]);
            adj.get(e[1]).add(e[0]);                              // undirected
        }
        int[] disc = new int[V];                                  // discovery time
        int[] low = new int[V];                                   // lowest reachable disc
        boolean[] isAP = new boolean[V];
        int[] timer = {0};                                        // shared clock
        Arrays.fill(disc, -1);                                    // -1 = unvisited
        for (int i = 0; i < V; i++) {                             // graph may be disconnected
            if (disc[i] == -1) {
                dfs(i, -1, adj, disc, low, isAP, timer);          // fresh root per component
            }
        }
        ArrayList<Integer> res = new ArrayList<>();
        for (int i = 0; i < V; i++) {
            if (isAP[i]) res.add(i);
        }
        if (res.isEmpty()) res.add(-1);                           // no cut vertex
        return res;
    }

    private static void dfs(int u, int parent,
                            ArrayList<ArrayList<Integer>> adj, int[] disc,
                            int[] low, boolean[] isAP, int[] timer) {
        disc[u] = low[u] = timer[0]++;                            // entry time
        int children = 0;                                         // DFS tree children
        for (int v : adj.get(u)) {
            if (v == parent) continue;                            // never go back to parent
            if (disc[v] == -1) {                                  // tree edge
                children++;
                dfs(v, u, adj, disc, low, isAP, timer);
                low[u] = Math.min(low[u], low[v]);                // pull up child low
                if (parent != -1 && low[v] >= disc[u]) {          // no back edge escapes subtree
                    isAP[u] = true;
                }
            } else {                                              // back edge
                low[u] = Math.min(low[u], disc[v]);               // use disc of v, not low
            }
        }
        if (parent == -1 && children > 1) {                       // root rule
            isAP[u] = true;
        }
    }
}

