
class Solution {
    static boolean findsum(int arr[]) {

        HashSet<Integer> hs = new HashSet<>();            // stores prefix sums seen so far
        int psum = 0;                                     // running prefix sum

        for(int i = 0; i < arr.length; i++){

            psum += arr[i];                               // add current element to prefix sum

            if(hs.contains(psum) || psum == 0){          // psum seen before → zero sum subarray exists
                return true;                             // OR psum==0 → subarray from index 0
            }

            hs.add(psum);                                 // store prefix sum for future checks
        }

        return false;                                     // no zero sum subarray found ❌
    }
}

/////////////////////////////////////////////////////////////////////////////////////

// ── WHY hs.contains(psum) works ───────────────────────────────────────

// if same prefix sum appears twice
// elements between those two indices sum to 0

arr  = [ 3,  4,  -7,  5,  1 ]

i=0  psum = 0+3  = 3    hs = {}       contains(3)? ❌   hs = {3}
i=1  psum = 3+4  = 7    hs = {3}      contains(7)? ❌   hs = {3,7}
i=2  psum = 7-7  = 0    hs = {3,7}    psum==0 ✅  return true

// ── another example ───────────────────────────────────────────────────

arr  = [ 1,  2,  -3,  4,  -3 ]

i=0  psum = 1    hs = {}           contains(1)? ❌   hs = {1}
i=1  psum = 3    hs = {1}          contains(3)? ❌   hs = {1,3}
i=2  psum = 0    hs = {1,3}        psum==0 ✅  return true

// ── example where contains() triggers ─────────────────────────────────

arr  = [ 1,  2,  3,  -3,  1 ]

i=0  psum = 1    hs = {}           contains(1)? ❌   hs = {1}
i=1  psum = 3    hs = {1}          contains(3)? ❌   hs = {1,3}
i=2  psum = 6    hs = {1,3}        contains(6)? ❌   hs = {1,3,6}
i=3  psum = 3    hs = {1,3,6}      contains(3)? ✅  return true

//  psum[3] = 3  was seen at i=1
//  subarray between i=2 and i=3 → [3, -3] sums to 0 ✅

// ── KEY INSIGHT ───────────────────────────────────────────────────────

// psum[j] == psum[i]  means
// sum of arr[i+1 .. j] == 0

┌─────────────────────────────────────────────────────┐
│  psum repeated  →  zero sum subarray between        │
│  psum == 0      →  zero sum subarray from index 0   │
└─────────────────────────────────────────────────────┘

