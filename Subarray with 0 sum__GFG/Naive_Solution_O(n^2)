
class Solution {
    static boolean findsum(int arr[]) {

        int n = arr.length;                               // store array length

        for(int i = 0; i < n; i++){                      // start index of subarray
            int csum = 0;                                 // reset sum every outer loop

            for(int j = i; j < n; j++){                  // end index of subarray
                csum += arr[j];                          // add element to current sum

                if(csum == 0){                           // subarray sum == 0
                    return true;                         // found ✅
                }
            }
        }

        return false;                                     // no zero sum subarray ❌
    }
}

