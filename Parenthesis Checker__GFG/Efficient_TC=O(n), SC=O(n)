class Solution {
    
                                                       // Helper: Check if two brackets match
    boolean matching(char a, char b) {                // a = opening, b = closing
        if ((a == '[' && b == ']') ||                 // Square brackets match
            (a == '{' && b == '}') ||                 // Curly brackets match
            (a == '(' && b == ')')) {                 // Round brackets match
            return true;                              // Valid pair
        }
        return false;                                 // Mismatch
    }
    
    public boolean isBalanced(String s) {
        ArrayDeque<Character> deq = new ArrayDeque<>();       // Stack for opening brackets

        for (char c : s.toCharArray()) {                      // Traverse each character
            if (c == '(' || c == '{' || c == '[') {           // Opening bracket
                deq.push(c);                                  // Push to stack
            } else {                                          // Closing bracket
                if (deq.isEmpty()) {                          // No opening to match
                    return false;                             // Unbalanced
                }
                
                char top = deq.peek();                        // Get top without removing
                
                if (matching(top, c)) {                       // Check if pair matches
                    deq.pop();                                // Match found, pop opening
                } else {
                    return false;                             // Mismatch type
                }
            }
        }
        
        return deq.isEmpty();                                 // True if all matched
    }
}

