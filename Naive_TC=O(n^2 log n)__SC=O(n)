class Solution {
    public ArrayList<Double> getMedian(int[] arr) {

       ArrayList<Double> finRes = new ArrayList<Double>();

       int n = arr.length;

       float res[] = new float[n];                                           // stores elements read so far

       for(int i=0;i<n;i++){                                                // read stream one by one

           res[i] = arr[i];                                                  // add new element
 
           Arrays.sort(res, 0, i + 1);                                       // sort till current element

            int s = i+1;                                                     // current size

            if(s%2 != 0)                                                      // odd count
                finRes.add((double)res[s/2]);                                // middle element

            else                                                             // even count
                finRes.add((double)((res[s/2] + res[(s-1)/2])/2));          // average of two middle

       }

       return finRes;
    }
}


