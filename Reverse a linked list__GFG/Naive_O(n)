class Solution {
    Node reverseList(Node head) {
        ArrayList<Integer> list = new ArrayList<>();                   // Store node values
        
        for(Node curr = head; curr != null; curr = curr.next){         // Pass 1: Collect values
            list.add(curr.data);
        }
        
        for(Node curr = head; curr != null; curr = curr.next){         // Pass 2: Assign reversed
            curr.data = list.remove(list.size()-1);
        }
        
        return head;                                                   // Return original head
    }
}

