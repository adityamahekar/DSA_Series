/*
class Node
{
    int data;
    Node next;
    Node(int data)
    {
        this.data = data;
        this.next = null;
    }
}
*/

class gfg {
    static Node insert_at_end(Node head, int x) {

        Node temp = new Node(x);                // new node

        if (head == null) {                     // empty list
            temp.next = temp;                   // point to itself
            return temp;
        }

        else {
            temp.next = head.next;              // temp → head.next
            head.next = temp;                   // head → temp (insert after head)

            int t = head.data;                  // swap start: save head data
            head.data = temp.data;              // head gets x
            temp.data = t;                      // temp gets old head data
        }

        return temp;                            // temp is now the last node, return it
    }
}


