class gfg {
    static Node insert_at_end(Node head, int x) {

        Node temp = new Node(x);                // new node

        if (head == null) {                     // empty list
            temp.next = temp;                   // point to itself
            return temp;
        }

        Node curr = head;

        while (curr.next != head) {             // reach last node
            curr = curr.next;
        }

        curr.next = temp;                       // last → new node
        temp.next = head;                       // new node → head

        return head;
    }
}


