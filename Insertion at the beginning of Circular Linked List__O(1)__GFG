/*
class Node {
    int data;
    Node next;
    Node(int x) {
        data = x;
        next = null;
    }
}
*/

class Solution {
    public Node insertAtBeginning(Node tail, int key) {
        Node temp = new Node(key);              // Create new node with given key

        if (tail == null) {                     // CASE 1: List is empty
            temp.next = temp;                   // New node points to itself (circular)
        }
        else {                                  // CASE 2: List has existing nodes
            temp.next = tail.next;              // New node points to current head
            tail.next = temp;                   // Tail now points to new node (new head)
        }

        return tail;                            // Return tail (tail does not change)
    }
}

