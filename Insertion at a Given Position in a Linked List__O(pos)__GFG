/*
class Node {
    int data;
    Node next;

    Node(int x) {
        data = x;
        next = null;
    }
}
*/


class Solution {
    public Node insertPos(Node head, int pos, int val) {
        Node temp = new Node(val);          // create new node
        Node curr = head;                   // traversal pointer

        if (pos == 1) {                     // insert at front
            temp.next = head;               // new node points to old head
            return temp;                    // new node is new head
        }

        for (int i = 1; i < pos-1; i++) {  // traverse to node just before pos
            curr = curr.next;               // move forward
        }

        if (curr == null) return head;      // pos out of range

        temp.next = curr.next;              // new node points to next
        curr.next = temp;                   // prev node points to new node

        return head;                        // head unchanged
    }
}
