/*
class Node {
    int data;
    Node next;

    Node(int x) {
        data = x;
        next = null;
    }
}
*/

class Solution {
    public boolean detectLoop(Node head) {
        
        if (head == null) { return false; }         // Base case: empty list has no loop
        
        Node slow = head, fast = head;              // Both start at head (Tortoise & Hare)
        
        
        while (fast != null && fast.next != null) { // Ensure fast can move 2 steps
            slow = slow.next;                       // Move slow by 1 step
            fast = fast.next.next;                  // Move fast by 2 steps
            
            if (slow == fast) {                     // Pointers met → LOOP EXISTS
                return true;
            }
        }
        
        
        return false;                               // Fast reached null → NO LOOP
    }
}

