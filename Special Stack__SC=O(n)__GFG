class GfG {

    ArrayDeque<Integer> st = new ArrayDeque<>();                           // Min tracking stack

    public void push(int a, Stack<Integer> s) {
        s.push(a);                                                          // Push to main stack
        if(st.isEmpty() || st.peek() >= a){                                // Push to min stack if smaller or equal
            st.push(a);
        }
    }

    public int pop(Stack<Integer> s) {
        if(s.isEmpty()){ return -1; }                                       // Empty check
        int tp = s.pop();                                                    // Pop main stack
        if(tp == st.peek()){                                                 // If popped was min
            st.pop();                                                        // Remove from min stack too
        }
        return tp;                                                           // Return popped value
    }

    public int min(Stack<Integer> s) {
        return st.peek();                                                    // Top of min stack is min
    }

    public boolean isFull(Stack<Integer> s, int n) {
        boolean full = (s.size() == n) ? true : false;                     // Compare size with capacity
        return full;                                                         // Return result
    }

    public boolean isEmpty(Stack<Integer> s) {
        return s.isEmpty();                                                  // Check if empty
    }
}

