import java.util.Stack;

class myStack {
                                                            // Define your stack
    Stack<Integer> st = new Stack<>();                      // Initialize built-in Stack

    public void push(int x) {
                                                            // Insert x into stack
        st.push(x);                                         // Add x to top of stack
    }

    public void pop() {
                                                            // Remove top element from stack
        if (!st.isEmpty()) {                                // Check stack not empty
            st.pop();                                       // Remove top element
        }
    }

    public int peek() {
                                                            // Return top of stack
        if (!st.isEmpty()) {                                // Check stack not empty
            return st.peek();                               // Return top element
        }
        return -1;                                          // Return -1 if empty
    }

    public int getSize() {
                                                            // Return current size of stack
        return st.size();                                   // Return element count
    }

    public boolean isEmpty() {
                                                            // Check whether stack is empty
        return st.isEmpty();                                // Return true if size is 0
    }
}

