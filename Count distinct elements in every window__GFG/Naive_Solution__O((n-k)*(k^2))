
class Solution {
    ArrayList<Integer> countDistinct(int arr[], int k) {
        int n = arr.length;

        ArrayList<Integer> list = new ArrayList<>();

        for (int i = 0; i <= n - k; i++) {                    // slide window: i = start index, runs n-k+1 times
            int count = 0;                                     // reset distinct count for each new window

            for (int j = i; j < i + k; j++) {                 // j = current element in window [i, i+k)
                boolean flag = true;                           // assume arr[j] is distinct until proven otherwise

                for (int o = i; o < j; o++) {                  // o = look-back index, scans arr[i..j-1]
                    if (arr[o] == arr[j]) {                    // duplicate found: arr[j] seen before in window
                        flag = false;                          // mark as duplicate
                        break;                                 // no need to check further
                    }
                }

                if (flag) {                                    // no duplicate found → arr[j] is distinct
                    count++;                                   // increment distinct count
                }
            }

            list.add(count);                                   // store distinct count for this window
        }

        return list;                                           // return all window counts
    }
}

