
class Solution {
    int missingNum(int arr[]) {
        int n = arr.length;                // n = total elements
        Arrays.sort(arr);                  // sort array
        int k = 1;                         // expected number starts at 1
        for(int i = 0; i < n; i++){        // loop each element
            if(arr[i] != k){               // mismatch found?
                return k;                  // yes → k is missing
            }
            k++;                           // move to next expected
        }
        return n + 1;                      // no gap → missing is n+1
    }
}

