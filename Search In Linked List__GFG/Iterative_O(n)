/*
class Node
{
    int data;
    Node next;
    Node(int data)
    {
        this.data = data;
        this.next = null;
    }
}
*/

class Solution {
    public static boolean searchLinkedList(Node head, int x) {
        Node curr = head;                    // start at head

        while (curr != null) {               // ✅ check all nodes including last
            if (curr.data == x) {            // if data matches
                return true;                 // found → return true
            }
            curr = curr.next;                // move to next node
        }

        return false;                        // x not found → return false
    }
}

