/*
class Node
{
    int data;
    Node next;
    Node(int data)
    {
        this.data = data;
        this.next = null;
    }
}
*/
class Solution {
    public static boolean searchLinkedList(Node head, int x) {

        if (head == null)      return false;       // base case → list ended, x not found

        if (head.data == x)    return true;        // found x → return true

        return searchLinkedList(head.next, x);     // recurse on next node
    }
}

