{
    int data;
    Node next;
    Node(int data)
    {
        this.data = data;
        this.next = null;
    }
}
*/

class Solution {
    public static int searchLinkedList(Node head, int x) {  

        if (head == null)     return -1;                    // base case → x not found

        if (head.data == x)   return 1;                     // found → position 1

        int res = searchLinkedList(head.next, x);           // recurse on next node

        if (res == -1)        return -1;                    // x not found in rest
        else                  return res + 1;               // add 1 to position
    }
}

//////////////////////// DRY RUN /////////////////////////////

Dry Run:

Recursive Call Stack:
Input: 1 -> 2 -> 3 -> null, x = 3
        searchLinkedList([1], 3)
        │
        ├── 1 == 3? No
        │
        └── searchLinkedList([2], 3)
            │
            ├── 2 == 3? No
            │
            └── searchLinkedList([3], 3)
                │
                ├── 3 == 3? Yes
                │
                └── return 1
                
            res = 1 → return 1+1 = 2
            
        res = 2 → return 2+1 = 3

        Final Answer: 3

----------------------------------------------------------------

Input: 1 -> 2 -> 3 -> null, x = 5
        searchLinkedList([1], 5)
        │
        ├── 1 == 5? No
        │
        └── searchLinkedList([2], 5)
            │
            ├── 2 == 5? No
            │
            └── searchLinkedList([3], 5)
                │
                ├── 3 == 5? No
                │
                └── searchLinkedList(null, 5)
                    │
                    └── head == null → return -1

                res = -1 → return -1

            res = -1 → return -1

        res = -1 → return -1

        Final Answer: -1

