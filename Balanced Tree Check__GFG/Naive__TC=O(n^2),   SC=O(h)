/*
class Node {
    int data;
    Node left, right;

    Node(int d)
    {
        data = d;
        left = right = null;
    }
}
*/

class Solution {
    
    int height(Node root){
        if(root == null){ return -1; }                                      // Base case: null node has height -1
        
        return Math.max(height(root.left), height(root.right))+1;           // Height = max(left, right) + 1
    }
    
    public boolean isBalanced(Node root) {

        if(root == null){ return true; }                                    // Empty tree is balanced
        
        int l = height(root.left);                                          // Get height of left subtree
        int r = height(root.right);                                         // Get height of right subtree
        
        return Math.abs(r-l) <= 1 && isBalanced(root.left) && isBalanced(root.right); // Check diff ≤ 1 and recurse
    }
}

//////////////////////// DRY RUN /////////////////////////////

Example 1: Balanced Tree [10, 20, 30, 40, 60]

       10
      /  \
     20   30
    / \
   40  60

isBalanced(10):
  h(left)=1, h(right)=0, |1-0|=1 ✓
  ├─ isBalanced(20): h(40)=0, h(60)=0, |0-0|=1 ✓
  │   ├─ isBalanced(40): leaf → true
  │   └─ isBalanced(60): leaf → true
  └─ isBalanced(30): leaf → true
Output: true

