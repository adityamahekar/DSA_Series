/*
class Node {
    int data;
    Node left, right;

    Node(int d)
    {
        data = d;
        left = right = null;
    }
}
*/

class Solution {
    
    int balance(Node root){
        if(root == null) return 0;                                    // Base case: null node has height 0
        
        int l = balance(root.left);                                   // Get left subtree height
        if(l == -1) return -1;                                        // If left unbalanced, propagate -1
        
        int r = balance(root.right);                                  // Get right subtree height
        if(r == -1) return -1;                                        // If right unbalanced, propagate -1
        
        
        return  Math.abs(r-l) <= 1 ? Math.max(l,r)+1 : -1;            // If diff ≤ 1 return height, else -1
    }
    
    public boolean isBalanced(Node root) {
            
        return balance(root) != -1;                                   // Returns true if not unbalanced
        
    }
}

//////////////////////// DRY RUN /////////////////////////////
Example 1: Balanced Tree [10, 20, 30, 40, 60]

       10
      /  \
     20   30
    / \
   40  60

balance(10):
  balance(20):
    balance(40): leaf → 0, returns max(0,0)+1 = 1
    balance(60): leaf → 0, returns max(0,0)+1 = 1
    |1-1|=1 ✓ → returns max(1,1)+1 = 2
  balance(30): leaf → 0, returns 1
  |2-1|=1 ✓ → returns max(2,1)+1 = 3
Output: true (3 ≠ -1)

Example 2: Unbalanced Tree [1, 2, 3, 4, N, N, N, 5]

      1
     / \
    2   3
   /
  4
 /
5

balance(1):
  balance(2):
    balance(4):
      balance(5): leaf → 0, returns 1
      returns 1 (left is leaf)
    |1-0|=1 ✓ → returns 2
  balance(3): leaf → 0, returns 1
  |2-1|=1 ✓ → returns 3... but wait, node 4 has child 5 so height differs
Output: false

//////////////////////// QUESTION ////////////////////////////
Balanced Tree Check
Given the root of a binary tree, determine if it is height-balanced or not.
A binary tree is height-balanced if the absolute difference in heights of the left and right subtrees is at most 1 for every node in the tree.

Examples:

Input: root = [10, 20, 30, 40, 60]

       10
      /  \
     20   30
    / \
   40  60

Output: true
Explanation: Height difference ≤ 1 at all nodes

Input: root = [1, 2, 3, 4, N, N, N, 5]

      1
     / \
    2   3
   /
  4
 /
5

Output: false
Explanation: Node 2 has height difference 2 (exceeds 1)

Constraints:
• 1 ≤ number of nodes ≤ 1000
• 1 ≤ node->data ≤ 10^4
