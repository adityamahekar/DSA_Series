class Tree {
    
    void knode(Node root, int k, ArrayList<Integer> list) {
        
        if(root == null){ return; }                                         // Base case: null node, return immediately
        
        if(k == 0){ list.add(root.data); }                                  // k=0: current node is at target distance, add to list
        
        knode(root.left, k-1, list);                                        // Recurse left with k-1
        knode(root.right, k-1, list);                                       // Recurse right with k-1
    }
    
    ArrayList<Integer> Kdistance(Node root, int k) {
        
        ArrayList<Integer> list = new ArrayList<>();                        // Initialize result list
        
        knode(root, k, list);                                               // Call helper to find all nodes at distance k
        
        return list;                                                        // Return list of nodes
    }
}

