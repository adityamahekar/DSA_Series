int arr[];                                         // heap stored as array
int size, capacity;                                // current size, max size

void minHeapify(int i){
    int lt = left(i), rt = right(i);               // get children indices
    int smallest = i;                              // assume root is smallest

    if(lt < size && arr[lt] < arr[smallest])       smallest = lt;    // left smaller
    if(rt < size && arr[rt] < arr[smallest])       smallest = rt;    // right smaller

    if(smallest != i){                             // root not smallest
        swap(arr[i], arr[smallest]);               // fix violation
        minHeapify(smallest);                      // recurse down
    }
}

int extractMin(){
    if(size == 0)  return INT_MAX;                 // empty heap case
    if(size == 1){ size--; return arr[0]; }        // single element case

    swap(arr[0], arr[size-1]);                     // move min to end
    size--;                                        // shrink heap size
    minHeapify(0);                                 // restore heap order
    return arr[size];                              // return old min
}

