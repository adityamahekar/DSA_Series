class Main {
    void printFirstN(int n){
        Queue<String> q = new LinkedList<>();   // Queue for BFS generation
        
        q.add("5");                             // Start with "5"
        q.add("6");                             // Add "6"
  
        for(int i=0; i<n; i++){
            String curr = q.remove();           // Remove front element
            
            q.add(curr + "5");                  // Append '5' and enqueue
            q.add(curr + "6");                  // Append '6' and enqueue
        }
    }
}

