void heapify(int arr[], int n, int i) {
    int largest = i;                                // assume root is largest
    int left = 2 * i + 1;                           // left child index
    int right = 2 * i + 2;                          // right child index

    if (left < n && arr[left] > arr[largest])       // left child bigger?
        largest = left;                             // update largest

    if (right < n && arr[right] > arr[largest])     // right child bigger?
        largest = right;                            // update largest

    if (largest != i) {                             // root is not largest
        int temp = arr[i];                          // swap root with largest
        arr[i] = arr[largest];                      // move child up
        arr[largest] = temp;                        // move root down

        heapify(arr, n, largest);                   // fix affected subtree
    }
}

void heapSort(int arr[], int n) {
    for (int i = n / 2 - 1; i >= 0; i--)            // build max heap
        heapify(arr, n, i);                         // heapify each parent

    for (int i = n - 1; i > 0; i--) {               // extract one by one
        int temp = arr[0];                          // swap max with last
        arr[0] = arr[i];                            // last goes to root
        arr[i] = temp;                              // max placed at end

        heapify(arr, i, 0);                         // fix reduced heap
    }
}

