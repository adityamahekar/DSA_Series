class Node {
    int data;
    Node left;
    Node right;
    Node(int val) {
        data = val;
        left = right = null;
    }
};

class Solution {
    public ArrayList<Integer> inOrder(Node root) {

        ArrayList<Integer> ans = new ArrayList<>();

        Stack<Node> st = new Stack<>();

        Node cur = root;

        while(cur != null || !st.isEmpty()){
            while(cur != null){
                st.push(cur);                                  // push current node
                cur = cur.left;                                // move to left child
            }

            cur = st.pop();                                    // pop top node

            ans.add(cur.data);                                 // visit node

            cur = cur.right;                                   // move to right child
        }
        return ans;
    }
}

