class Node {
    int data;
    Node left, right;

    Node(int val) {
        this.data = val;
        this.left = null;
        this.right = null;
    }
}

class Pair {
    Node node;
    int hd;

    Pair(Node n, int h) {
        node = n;
        hd = h;
    }
}

class Solution {
    public ArrayList<Integer> topView(Node root) {
        ArrayList<Integer> ans = new ArrayList<>();
        if (root == null) return ans;

        Queue<Pair> q = new LinkedList<>();
        Map<Integer, Integer> mp = new TreeMap<>();

        q.add(new Pair(root, 0));

        while (!q.isEmpty()) {
            Pair p = q.poll();
            Node curr = p.node;
            int hd = p.hd;

            if (!mp.containsKey(hd)) mp.put(hd, curr.data);                // store first node only

            if (curr.left != null) q.add(new Pair(curr.left, hd - 1));     // go left
            if (curr.right != null) q.add(new Pair(curr.right, hd + 1));   // go right
        }

        ans.addAll(mp.values());                                          // sorted by hd
        return ans;
    }
}

