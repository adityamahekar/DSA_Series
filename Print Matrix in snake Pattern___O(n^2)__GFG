class Solution {
    
                                                                    // Function to return elements in snake pattern
    static ArrayList<Integer> snakePattern(int matrix[][]) {

        ArrayList<Integer> list = new ArrayList<Integer>();        // store result
        
        for(int i = 0; i < matrix.length; i++){                    // traverse rows
            
            if(i % 2 != 0){                                        // odd row → right to left
                for(int j = matrix[i].length - 1; j >= 0; j--){
                    list.add(matrix[i][j]);                         // add element
                }
            }
            else{                                                   // even row → left to right
                for(int j = 0; j < matrix[i].length; j++){
                    list.add(matrix[i][j]);                         // add element
                }
            }
        }
        
        return list;                                                // return result
    }
}
