class Solution {
    public int evaluatePostfix(String[] arr) {
       
        Stack<Integer> st = new Stack<>();                          // Stack for operands
        
        for(String s : arr){                                            // Left to right scan
            
            if(s.equals("^") || 
               s.equals("*") || s.equals("/") ||
               s.equals("+") || s.equals("-") ){                                     // Operator: pop 2 operands
                
                int b = st.pop();                                            // Operand2 (right)
                int a = st.pop();                                                         // Operand1 (left)
                
                switch(s){                                                  // Apply operation (a op b)
                    case "*": st.push(a * b); break;                     // Multiply
                    case "+": st.push(a + b); break;                    // Add
                    case "-": st.push(a - b); break;                        // Subtract
                    case "^": st.push((int) Math.pow(a, b)); break;                      // Power
                    case "/": st.push((int) Math.floor((double) a / b)); break;      // Floor division    // a = -5 , b = 3   =>   (double)a/b → -5.0 / 3 = -1.666...   =>   Math.floor(-1.666...) → -2.0   =>    (int)-2.0 → -2    
                }
            }
            else{                                               // Operand: push to stack
                st.push(Integer.parseInt(s));
            }
        }
        return st.pop();                                     // Single result left
    }
}

