class Node {
    int data;
    Node left, right;
    Node(int item){
        data = item;
        left = right = null;
    }
}

class Solution {
    ArrayList<Integer> preOrder(Node root) {
        Stack<Node> st = new Stack<>();                     // stack to hold right children
        ArrayList<Integer> list = new ArrayList<>();         // stores preorder result

        Node cur = root;                                     // current pointer

        while(cur != null || !st.isEmpty()){                 // loop till tree fully traversed

            while(cur != null){                               // go left, visiting nodes
                list.add(cur.data);                           // visit node first (Root)

                if(cur.right != null){ st.push(cur.right); }  // save right for later

                cur = cur.left;                                // move to left child
            }

            if(!st.isEmpty()){                                // backtrack using stack
                cur = st.pop();                                // pick last saved right child
            }
        }
        return list;                                          // final preorder list
    }
}

