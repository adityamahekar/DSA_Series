String printFreq(String str){
    int count[] = new int[26];                       // a-z frequency array

    for(int i = 0; i < str.length(); i++){           // loop each char
        count[str.charAt(i) - 'a']++;                // index = char - 'a'
    }

    for(int j = 0; j < 26; j++){                     // loop a-z
        if(count[j] > 0){                            // skip zero frequency
            System.out.println((char)(j+'a') + " " + count[j]); // print char + freq
        }
    }
}

//==================================================
// PROBLEM: Character Frequency
// Given a string str, print each character and
// its frequency in alphabetical order.
// Only print characters that appear at least once.
//
// Input:  str = "geeks"
// Output: e 2
//         g 1
//         k 1
//         s 1
//
// Constraints:
// 1 <= str.length() <= 10^5
// str contains only lowercase letters a-z
//==================================================

//==================================================
// TEST CASE 1
// Input:  "geeks"
// Output: e 2, g 1, k 1, s 1
//
// FILL
// i=0  g  →  {g:1}
// i=1  e  →  {g:1, e:1}
// i=2  e  →  {g:1, e:2}
// i=3  k  →  {g:1, e:2, k:1}
// i=4  s  →  {g:1, e:2, k:1, s:1}
//
// PRINT
// e 2 | g 1 | k 1 | s 1  ✅
//==================================================

//==================================================
// TEST CASE 2
// Input:  "hello"
// Output: e 1, h 1, l 2, o 1
//
// FILL
// i=0  h  →  {h:1}
// i=1  e  →  {h:1, e:1}
// i=2  l  →  {h:1, e:1, l:1}
// i=3  l  →  {h:1, e:1, l:2}
// i=4  o  →  {h:1, e:1, l:2, o:1}
//
// PRINT
// e 1 | h 1 | l 2 | o 1  ✅
//==================================================

//==================================================
// TEST CASE 3
// Input:  "aabbc"
// Output: a 2, b 2, c 1
//
// FILL
// i=0  a  →  {a:1}
// i=1  a  →  {a:2}
// i=2  b  →  {a:2, b:1}
// i=3  b  →  {a:2, b:2}
// i=4  c  →  {a:2, b:2, c:1}
//
// PRINT
// a 2 | b 2 | c 1  ✅
//==================================================

//==================================================
// TC = O(n)
// SC = O(26) = O(1)
