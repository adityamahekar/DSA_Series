
class Solution {
    
    int BinarySearch(int arr[], int x){
        int l = 0, r = arr.length;                // search range

        while(l < r){                             // binary search loop
            int m = (l + r) / 2;                  // middle index
            
            if(arr[m] <= x){ l = m + 1; }         // move right if value ≤ x
            else{ r = m; }                        // move left if value > x
        }
        return l;                                 // count of elements ≤ x
    }






    public int median(int[][] mat) {

        int r = mat.length, c = mat[0].length;    // rows and columns
        
        int min = mat[0][0], max = mat[0][c-1];   // initial min & max
        
        for(int i = 0; i < r; i++){                         // find global min & max
            if(min > mat[i][0]){ min = mat[i][0]; }
            if(max < mat[i][c-1]){ max = mat[i][c-1]; }
        }
        
        int medPos = (r * c + 1) / 2;             // median position

        while(min < max){                         // binary search on value range
            int mid = (min + max) / 2;
            int midPos = 0;

            for(int i = 0; i < r; i++){                       // count elements ≤ mid
                midPos += BinarySearch(mat[i], mid);
            }
            
            if(midPos < medPos){                  // median is larger
                min = mid + 1;
            }
            else{                                 // median is smaller or equal
                max = mid;
            }
        }
        return min;                               // final median
    }
}


