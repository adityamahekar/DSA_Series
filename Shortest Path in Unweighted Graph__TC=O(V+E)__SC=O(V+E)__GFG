class Solution {
    public int shortestPath(int V, int[][] edges, int src, int dest) {

        List<List<Integer>> adj = new ArrayList<>();                      // adjacency list

        for(int i=0;i<V;i++)
            adj.add(new ArrayList<>());                                   // empty list per node

        for(int[] edge: edges){
            adj.get(edge[0]).add(edge[1]);                                // u -> v
            adj.get(edge[1]).add(edge[0]);                                // v -> u (undirected)
        }

        int[] dist = new int[V];                                          // distance from src
        Arrays.fill(dist, -1);                                            // -1 = not visited

        Queue<Integer> q = new LinkedList<>();                            // BFS queue
        q.add(src);
        dist[src] = 0;                                                    // src distance is 0

        while(!q.isEmpty()){
            int node = q.poll();                                          // current node

            if(node == dest)
                return dist[node];                                        // reached dest

            for(int nei: adj.get(node)){
                if(dist[nei] == -1){                                      // not visited yet
                    dist[nei] = dist[node] + 1;                           // one more edge
                    q.add(nei);                                           // visit later
                }
            }
        }

        return -1;                                                        // no path found
    }
}

