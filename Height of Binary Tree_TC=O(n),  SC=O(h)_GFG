/* class Node { 
    int data; 
    Node left, right; 
    Node(int val) { 
        data = val; 
        left = right = null; 
    } 
} */

class Solution {
    public int height(Node root) {
        if(root == null){ return -1; }                                    // Base case: empty tree has height -1       return (-1 for edges)   (0 for node)
        else{ 
            return Math.max(height(root.left), height(root.right)) + 1;  // Recursively find max height of subtrees + 1
        }
    }
}

