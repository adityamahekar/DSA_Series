class kStacks {

                            // main array to store elements
    private int[] arr;      // Stores actual values of all k stacks
    int top[];              // top[i] = index of top element of stack i
    int next[];             // next[j] = index of next element below arr[j] OR next free slot
    int free_Top = 0;       // Index of first available free slot in array
    int j = 0;              // Temporary variable for index calculations
            
    public kStacks(int n, int k) {
        arr = new int[n];           // Allocate main array of size n
        top = new int[k];           // Allocate top array for k stacks
        next = new int[n];          // Allocate next array of size n
        
                                            // Initialize all k stacks as empty
        for(int i = 0; i < k; i++){
            top[i] = -1;                  // -1 represents empty stack
        }
        
                                                  // Initialize free list: 0 -> 1 -> 2 -> ... -> n-1 -> -1
        for(int i = 0; i < n - 1; i++){
            next[i] = i + 1;                      // Each slot points to next slot
        }
        next[n - 1] = -1;                         // Last slot points to null (-1)
    }

                                      // Push element x into stack i
    public void push(int x, int i) {
        j = free_Top;               // Get index of first free slot
        free_Top = next[j];         // Move free_Top to next available free slot
        next[j] = top[i];           // Link new element to current top of stack i
        top[i] = j;                 // Update top of stack i to new element index
        arr[j] = x;                 // Store value x at index j in main array
    }

                                    // Pop element from stack i
    public int pop(int i) {
        if(top[i] == -1){           // Check if stack i is empty
            return -1;              // Return -1 for underflow
        }
        
        j = top[i];                 // Get index of top element in stack i
        top[i] = next[j];           // Move top to next element below in stack
        next[j] = free_Top;         // Add popped slot to front of free list
        free_Top = j;               // Update free_Top to this newly freed slot
        
        return arr[j];              // Return the popped value
    }
    
                                     // Check if stack i is empty
    boolean isEmpty(int i){
        return top[i] == -1;        // Stack is empty if top index is -1
    }
}

