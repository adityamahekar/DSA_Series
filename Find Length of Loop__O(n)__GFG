/*
class Node {
    int data;
    Node next;

    Node(int x) {
        data = x;
        next = null;
    }
}
*/

class Solution {
    public int lengthOfLoop(Node head) {
        
        if (head == null || head.next == null) { return 0; }    // Base case: empty or single node
        
        Node slow = head, fast = head;
        
        
        // Step 1: Detect loop using Floyd's Cycle Detection
        while (fast != null && fast.next != null) {
            slow = slow.next;                       // Move slow by 1 step
            fast = fast.next.next;                  // Move fast by 2 steps
            
            if (slow == fast) {                     // Loop detected
                break;
            }
        }
        
        
        // Step 2: Check if loop actually exists
        if (slow != fast) {                         // No loop found
            return 0;
        }
        
        
        // Step 3: Count nodes in the loop
        Node curr = fast;                           // Start from meeting point
        int count = 1;                              // Count the starting node
        
        while (curr.next != fast) {                 // Traverse until we come back to start
            curr = curr.next;                       // Move to next node
            count++;                                // Increment counter
        }
        
        
        return count;                               // Return loop length
    }
}

//////////////////////// DRY RUN /////////////////////////////

CASE 1: LOOP EXISTS (length = 4)

Input: 1 -> 2 -> 3 -> 4 -> 5
            ^              |
            |______________|
        (pos = 2, loop: 2->3->4->5->2)


STEP 1: DETECT LOOP

Initial: slow = 1, fast = 1

Iter 1: slow=2, fast=3
Iter 2: slow=3, fast=5
Iter 3: slow=4, fast=3 (5->2, 2->3)
Iter 4: slow=5, fast=5  ← COLLISION at node 5!


STEP 2: COUNT LOOP NODES

curr = fast = 5, count = 1

While (curr.next != fast):

Iter 1: curr.next = 2 ≠ 5
        curr = 2, count = 2

Iter 2: curr.next = 3 ≠ 5
        curr = 3, count = 3

Iter 3: curr.next = 4 ≠ 5
        curr = 4, count = 4

Iter 4: curr.next = 5 == 5 → Stop!


RESULT: count = 4 ✓

Loop: 2 -> 3 -> 4 -> 5 -> 2 (4 nodes)


VISUAL:

        [2] -> [3] -> [4] -> [5]
         ^                   |
         |___________________|
              Loop (length 4)


