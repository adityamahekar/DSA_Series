class Node {
    int data;
    Node left, right;
    Node(int item){
        data = item;
        left = right = null;
    }
}

class Solution {
    ArrayList<Integer> preOrder(Node root) {

        ArrayList<Integer> list = new ArrayList<>();

        Stack<Node> st = new Stack<>();

        st.push(root);                                         // push root first

        while(!st.isEmpty()){
           Node cur = st.pop();                                 // pop top node

            list.add(cur.data);                                 // visit node
             if(cur.right != null){ st.push(cur.right); }        // push right first
            if(cur.left != null){ st.push(cur.left); }           // push left last so it pops first

        }

        return list;
    }
}

