class Solution {
    public ArrayList<Integer> calculateSpan(int[] arr) {

        ArrayList<Integer> list = new ArrayList<>();        // Result array to store spans
        ArrayDeque<Integer> s = new ArrayDeque<>();         // Stack to store indices of previous greater elements
        int n = arr.length;                                 // Size of input array
        int span;                                           // Variable to store current day's span
        
        s.push(0);                                          // Push first day's index
        list.add(1);                                        // First day always has span=1
        
        for(int i=1; i<n; i++){                             // Iterate from day 1 to n-1
            
            while(!s.isEmpty() && arr[s.peek()] <= arr[i]){ // Pop indices with price <= current price
                s.pop();
            }
            
            span = s.isEmpty() ? i+1 : i-s.peek();          // If stack empty: all previous <= current, else: distance to previous greater
            list.add(span);                                 // Add calculated span to result
            s.push(i);                                      // Push current day's index to stack
        }
        return list;                                        // Return final span array
    }
}

