/*
class Node
{
    int data;
    Node next;
    Node(int key)
    {
        data = key;
        next = null;
    }
}
*/

class Solution {
    public Node reverseKGroup(Node head, int k) {
    
        Node curr = head, prevFirst = null, next = null;   // curr: tracks current node, prevFirst: tail of previous group
        boolean isFirstPass = true;                         // Flag to update head only once
        
        while (curr != null) {                              // Process all groups
            int count = 0;                                  // Counter for k nodes
            Node First = curr, prev = null;                 // First: stores tail of current group after reversal
        
            if (head == null || k == 1) { return head; }    // Base case: empty list or k=1 (no reversal needed)
        
                                                            // Reverse k nodes iteratively
            while (curr != null && count < k) {
                next = curr.next;                           // Save next node before breaking link
                curr.next = prev;                           // Reverse: point current to previous
                prev = curr;                                // Move prev forward to current
                curr = next;                                // Move curr forward to next
                count++;                                    // Increment count
            }        
            
                                                            // Connect previous group to current reversed group
            if (isFirstPass) {                              // First group: update head pointer
                head = prev;                                // New head is the last node of first group
                isFirstPass = false;                        // Mark first pass as done
            }
            else {                                          // Subsequent groups: link previous tail to current head
                prevFirst.next = prev;                      // Connect previous group's tail to current group's head
            }
        
            prevFirst = First;                              // Update prevFirst to current group's tail (original first node)
        }
       
        return head;                                        // Return new head of modified list
    }
}

