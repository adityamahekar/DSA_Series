class Solution {                                                                  // greedy + DSU

    private int[] parent;                                                         // parent[i] = latest free slot <= i

    private int find(int x){                                                      // latest free slot
        if(parent[x] == x) return x;                                              // slot free
        return parent[x] = find(parent[x]);                                       // path compression
    }

    public ArrayList<Integer> jobSequencing(int[] deadline, int[] profit) {       // entry
        int n = deadline.length;                                                  // job count

        Integer[] order = new Integer[n];                                         // indices to sort

        for (int i = 0; i < n; i++) order[i] = i;                                 // 0..n-1

        Arrays.sort(order, (a, b) -> Integer.compare(profit[b], profit[a]));      // profit desc

        int maxDeadline = 0;                                                      // biggest deadline
        for (int d : deadline) maxDeadline = Math.max(maxDeadline, d);            // scan it

        parent = new int[maxDeadline + 1];                                        // slots 0..maxDeadline

        for (int i = 0; i <= maxDeadline; i++) parent[i] = i;                     // all slots free

        int count = 0, totalProfit = 0;                                           // answers

        for (int i : order) {                                                     // richest job first
            int slot = find(deadline[i]);                                         // latest free slot

            if (slot > 0) {                                                       // got a slot

                count++;                                                          // job taken
                totalProfit += profit[i];                                         // add profit
                parent[slot] = find(slot - 1);                                    // mark slot used
            }
        }

        return new ArrayList<>(List.of(count, totalProfit));                      // [jobs, profit]
    }
}

