/*
class Node {
    int data;
    Node next;

    Node(int x) {
        data = x;
        next = null;
    }
}
*/

class Solution {
    Node reverseList(Node head) {
        
        if (head == null) { return null; }              // Base case: empty list
        if (head.next == null) { return head; }         // Base case: single node
        
        
        Node rest_head = reverseList(head.next);        // Recursively reverse rest
        Node rest_tail = head.next;                     // Get tail of reversed rest
        
        rest_tail.next = head;                          // Link current node to end
        head.next = null;                               // Break old forward link
        
        return rest_head;                               // Return new head
    }
}

//////////////////////// DRY RUN /////////////////////////////

Input: 1 -> 2 -> 3 -> 4 -> null

ORIGINAL LIST (Before Recursion):

[1|•] -> [2|•] -> [3|•] -> [4|•] -> null
 ^
head


RECURSION STACK (Going Down):

Level 1: reverseList(1) called
         [1|•] -> [2|•] -> [3|•] -> [4|•] -> null
          ^
         head

Level 2: reverseList(2) called
         [1|•] -> [2|•] -> [3|•] -> [4|•] -> null
                  ^
                 head

Level 3: reverseList(3) called
         [1|•] -> [2|•] -> [3|•] -> [4|•] -> null
                           ^
                          head

Level 4: reverseList(4) called (BASE CASE)
         [1|•] -> [2|•] -> [3|•] -> [4|•] -> null
                                        ^
                                       head
         Returns: rest_head = 4


UNWINDING (Coming Back - Reversing Links):

--------------------------------------------------------------------------------
Step 5: Back at node 3 (head = 3)
--------------------------------------------------------------------------------
        
        rest_head = 4 (returned from recursion)
        rest_tail = head.next = 4
        
        Before link change:
        [1|•] -> [2|•] -> [3|•]    [4|•] -> null
                           ^         ^
                         head    rest_head
                                   ^
                               rest_tail
        
        Action: rest_tail.next = head  (4.next = 3)
                head.next = null       (3.next = null)
        
        After link change:
        [1|•] -> [2|•] -> [3|•] <- [4|•]    null
                           ^         ^
                         head    rest_head
                                   ^
                               rest_tail
        
        Returns: rest_head = 4


--------------------------------------------------------------------------------
Step 6: Back at node 2 (head = 2)
--------------------------------------------------------------------------------
        
        rest_head = 4 (returned from recursion)
        rest_tail = head.next = 3
        
        Before link change:
        [1|•] -> [2|•]    [3|•] <- [4|•]    null
                 ^         ^         ^
               head   rest_tail  rest_head
        
        Action: rest_tail.next = head  (3.next = 2)
                head.next = null       (2.next = null)
        
        After link change:
        [1|•] -> [2|•] <- [3|•] <- [4|•]    null
                 ^         ^         ^
               head   rest_tail  rest_head
        
        Returns: rest_head = 4


--------------------------------------------------------------------------------
Step 7: Back at node 1 (head = 1)
--------------------------------------------------------------------------------
        
        rest_head = 4 (returned from recursion)
        rest_tail = head.next = 2
        
        Before link change:
        [1|•]    [2|•] <- [3|•] <- [4|•]    null
         ^        ^         ^         ^
       head   rest_tail   (rest_head stays 4)
        
        Action: rest_tail.next = head  (2.next = 1)
                head.next = null       (1.next = null)
        
        After link change:
        [1|•] <- [2|•] <- [3|•] <- [4|•]    null
         ^        ^         ^         ^
       head   rest_tail              rest_head
        
        Returns: rest_head = 4 (NEW HEAD OF REVERSED LIST)


FINAL REVERSED LIST:

null <- [1|•] <- [2|•] <- [3|•] <- [4|•]
                                 ^
                              rest_head
                              (NEW HEAD)


Output: 4 -> 3 -> 2 -> 1 -> null


