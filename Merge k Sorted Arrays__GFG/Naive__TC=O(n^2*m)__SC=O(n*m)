class Solution {

    public ArrayList<Integer> mergeArrays(int[][] mat) {

        ArrayList<Integer> res = new ArrayList<>();

        for (int x : mat[0]) {                                    // first row into res
            res.add(x);
        }

        for (int i = 1; i < mat.length; i++) {                    // go through other rows

            ArrayList<Integer> temp = new ArrayList<>();          // merged result

            int p = 0;                                            // pointer on res
            int q = 0;                                            // pointer on row

            while (p < res.size() && q < mat[i].length) {         // both have elements

                if (res.get(p) <= mat[i][q]) {                    // res value smaller
                    temp.add(res.get(p));                         // take from res
                    p++;                                          // move p
                } else {
                    temp.add(mat[i][q]);                          // take from row
                    q++;                                          // move q
                }
            }

            while (p < res.size()) {                              // leftover of res
                temp.add(res.get(p));
                p++;
            }

            while (q < mat[i].length) {                           // leftover of row
                temp.add(mat[i][q]);
                q++;
            }

            res = temp;                                           // merged becomes res
        }

        return res;
    }
}

