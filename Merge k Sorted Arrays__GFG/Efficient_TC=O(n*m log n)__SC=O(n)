class Solution {

    class Node {
        int val;                                                  // value of element
        int row;                                                  // which array
        int col;                                                  // position in that array

        Node(int val, int row, int col) {
            this.val = val;
            this.row = row;
            this.col = col;
        }
    }

    public ArrayList<Integer> mergeArrays(int[][] mat) {

        int n = mat.length;                                       // number of arrays

        ArrayList<Integer> res = new ArrayList<>();

        PriorityQueue<Node> pq = new PriorityQueue<>(             // min heap on value
            (a, b) -> a.val - b.val
        );

        for (int i = 0; i < n; i++) {                             // first element of every array
            pq.add(new Node(mat[i][0], i, 0));
        }

        while (!pq.isEmpty()) {                                   // till heap is empty

            Node cur = pq.poll();                                 // smallest value

            res.add(cur.val);                                     // add to answer

            if (cur.col + 1 < mat[cur.row].length) {              // next element exists
                pq.add(new Node(
                    mat[cur.row][cur.col + 1],                    // next value of same array
                    cur.row,
                    cur.col + 1
                ));
            }
        }

        return res;
    }
}

