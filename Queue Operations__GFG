Queue Operations

ArrayDeque Implementation
=============================================================
ArrayDeque<Integer> q = new ArrayDeque<>();

=============================================================

// ✅ INSERT (Enqueue) - Add to REAR

q.add(10);        // Throws exception if full (rare)
q.offer(10);      // Returns false if full (safe)
q.addLast(10);    // Explicit rear add

=============================================================

// ✅ REMOVE (Dequeue) - Remove from FRONT  
q.remove();       // Throws exception if empty
q.poll();         // Returns null if empty (SAFE)
q.removeFirst();  // Explicit front remove
=============================================================

// ✅ GET FRONT (Peek Front)
q.peek();         // Returns null if empty (SAFE)
q.element();      // Throws if empty
q.getFirst();     // Returns front element
=============================================================

// ✅ GET REAR
q.getLast();      // Returns rear element

=============================================================
// ✅ CHECK EMPTY
q.isEmpty();      // Returns true/false
=============================================================
// ✅ SIZE
q.size();         // Number of elements

=============================================================
