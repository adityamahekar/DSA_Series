
Here's your code with aligned right-side comments:

```java
class MyHashMap {

    int size = 1000;                                                              // Total number of buckets in hash table
    List<int[]> table[];                                                          // Array of lists for separate chaining

    public MyHashMap() {
        table = new ArrayList[size];                                              // Initialize bucket array of size 1000

        for (int i = 0; i < size; i++) {                                          // Create empty list for each bucket
            table[i] = new ArrayList<>();
        }
    }

    public void put(int key, int value) {
        int idx = key % size;                                                     // Compute bucket index using modulo

        for (int p[] : table[idx]) {                                              // Search for existing key in bucket
            if (p[0] == key) {                                                    // Key already exists in map
                p[1] = value;                                                     // Update value in-place
                return;                                                           // Exit after update
            }
        }
        table[idx].add(new int[]{key, value});                                    // Key not found — insert new pair
    }

    public int get(int key) {
        int idx = key % size;                                                     // Compute bucket index using modulo

        for (int p[] : table[idx]) {                                              // Search through bucket chain
            if (p[0] == key) {                                                    // Key found in bucket
                return p[1];                                                      // Return associated value
            }
        }
        return -1;                                                                // Key not found — return -1
    }

    public void remove(int key) {
        int idx = key % size;                                                     // Compute bucket index using modulo

        for (int i = 0; i < table[idx].size(); i++) {                             // Iterate through bucket with index
            if (table[idx].get(i)[0] == key) {                                   // Key found at position i
                table[idx].remove(i);                                             // Remove the key-value pair
                return;                                                           // Exit after removal
            }
        }
    }
}

