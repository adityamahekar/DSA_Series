class Solution {
    public boolean areRotations(String s1, String s2) {
        if (s1.length() != s2.length()) {    // different lengths can't be rotations
            return false;
        }

        int n = s1.length();

        for (int j = 0; j < n; j++) {        // try every rotation offset 0..n-1
            boolean flag = true;

            for (int i = 0; i < n; i++) {    // compare all n characters
                if (s1.charAt(i) != s2.charAt((i + j) % n)) {  // s2 shifted by j
                    flag = false;            // mismatch found, stop checking
                    break;
                }
            }

            if (flag) return true;           // all n chars matched at offset j
        }

        return false;                        // no rotation matched
    }
}

