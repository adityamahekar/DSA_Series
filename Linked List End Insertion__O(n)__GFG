class Solution {
    public Node insertAtEnd(Node head, int x) {
        Node temp = new Node(x);        // create new node
        Node curr = head;               // traversal pointer
        Node prev = curr;               // tracks last node
        if (head == null) return temp;  // empty list edge case

        while (curr != null) {          // traverse till end
            prev = curr;                // save current
            curr = curr.next;           // move forward
        }

        prev.next = temp;               // link last node to new node
        return head;                    // head unchanged
    }
}


