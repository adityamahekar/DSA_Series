            temp = [0]
            temp.next = null
            temp.prev = null

    STEP 2: temp.next = head
            temp = [0] -> [1] <-> [2] <-> [3]

    STEP 3: head.prev = temp
            temp = [0] <-> [1] <-> [2] <-> [3]

    STEP 4: return temp (new head)

    Result: 0 <-> 1 <-> 2 <-> 3 <-> NULL  ✅
