class Solution {
    Node insertAtBeginning(Node head, int x) {
        Node temp = new Node(x);    // create new node

        if (head == null) {         // if list is empty
            return temp;            // new node is head
        }

        temp.next = head;           // new node points to old head
        head.prev = temp;           // old head's prev points to new node
        return temp;                // new node is new head
    }
}


