
class Solution {
    public ArrayList<Integer> boundaryTraversal(int mat[][]) {
        
        int n = mat.length;              // number of rows
        int m = mat[0].length;           // number of columns
        
        ArrayList<Integer> list = new ArrayList<>();   // store boundary elements
        
        for(int i = 0; i < m; i++){      // traverse top row (left → right)
            list.add(mat[0][i]);
        } 
        
        for(int i = 1; i < n; i++){      // traverse right column (top → bottom)
            list.add(mat[i][m-1]);
        }
        
        if(n > 1){                       // avoid duplicate if only one row
            for(int i = m-2; i >= 0; i--){   // traverse bottom row (right → left)
                list.add(mat[n-1][i]);
            }
        }
        
        if(m > 1){                       // avoid duplicate if only one column
            for(int i = n-2; i >= 1; i--){   // traverse left column (bottom → top)
                list.add(mat[i][0]);
            }
        }
        
        return list;                     // return boundary traversal
    }
}
