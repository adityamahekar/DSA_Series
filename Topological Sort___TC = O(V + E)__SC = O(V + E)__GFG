(Note: Kahn's algorithm here is linear in the graph size, not O(n log n). Every vertex enters the queue once and every edge is relaxed once, so it is O(V + E).)

//////////////////////// CODE ////////////////////////////////

class Solution {

    public ArrayList<Integer> topoSort(int V, int[][] edges) {

        ArrayList<ArrayList<Integer>> adj = new ArrayList<>();               // adjacency list

        for(int i=0;i<V;i++) adj.add(new ArrayList<>());                     // init every vertex

        int []indegree = new int[V];                                         // incoming edge count

        for(int e[]: edges){
            adj.get(e[0]).add(e[1]);                                         // edge u -> v
            indegree[e[1]]++;                                                // v gets a prereq
        }

        Queue<Integer> q = new LinkedList<>();                               // BFS queue

        for(int i=0;i<V;i++){
            if(indegree[i] == 0) q.add(i);                                   // sources first
        }

        ArrayList<Integer> res = new ArrayList<>();                          // final order

        while(!q.isEmpty()){
            int u = q.poll();                                                // take a source
            res.add(u);

            for(int v: adj.get(u)){                                          // relax neighbours
                if(--indegree[v] == 0) q.add(v);                             // free when indegree 0
            }
        }

        return res;

    }

}

