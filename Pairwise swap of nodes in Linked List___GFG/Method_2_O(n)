class Solution {
    public Node pairwiseSwap(Node head) {
        
        if (head == null || head.next == null) { 
            return head;                                          // Edge case: empty or single node
        }
        
        Node prev = head;                                         // First node of first pair
        Node cur = head.next.next;                                // Start of second pair
        head = head.next;                                         // New head will be second node
        head.next = prev;                                         // Complete first swap: 2->1
      
        // Process remaining pairs
        while (cur != null && cur.next != null) {
            prev.next = cur.next;                                 // Link previous pair to current
            prev = cur;                                           // Update prev to current pair's first node
            
            Node next = cur.next.next;                            // Save next pair's start
            cur.next.next = cur;                                  // Swap: second->first
            cur.next = next;                                      // Link first to next pair
            cur = next;                                           // Move to next pair
        }
        
        prev.next = cur;                                          // Handle odd node (if exists)
        
        return head;
    }
}

