class Solution {
    public Node pairwiseSwap(Node head) {

        if (head == null || head.next == null) { return head; }         // Edge case: empty or single node
        
        Node curr = head;
        
        while (curr != null && curr.next != null) {                     // Traverse in pairs
            
            int temp = curr.data;                                       // Swap data of current pair
            curr.data = curr.next.data;
            curr.next.data = temp;
            
            curr = curr.next.next;                                      // Move to next pair
        }
        
        return head;                                                    // Return modified head
    }
}

