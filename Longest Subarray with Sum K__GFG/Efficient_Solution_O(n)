

class Solution {
    public int longestSubarray(int[] arr, int k) {

    HashMap<Integer, Integer> hm = new HashMap<>();
    
    int res = 0, sum = 0;
    
    for(int i=0;i<arr.length;i++){
        sum += arr[i];
        
       if(sum == k){
           res = i+1;
       }
       
       if(!hm.containsKey(sum)){
           hm.put(sum,i);
       }
       
       if(hm.containsKey(sum-k)){
           res = Math.max(res,i - hm.get(sum-k));
       }
    }
    return res;
    }
}


