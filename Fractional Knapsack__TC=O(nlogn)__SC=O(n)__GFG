//////////////////////// CODE ////////////////////////////////

Note: items must be sorted by value/weight first — that is what the O(nlogn) is for.

class Solution {                                                                  // class starts
    public double fractionalKnapsack(int[] val, int[] wt, int capacity) {         // returns max value
        int n = val.length;                                                       // number of items
        Integer[] idx = new Integer[n];                                           // index array for sorting
        for (int i = 0; i < n; i++) idx[i] = i;                                   // fill indices 0..n-1
        Arrays.sort(idx, (a, b) -> Double.compare((double) val[b] / wt[b],        // sort by value/weight
                (double) val[a] / wt[a]));                                        // descending ratio
        double res = 0.0;                                                         // total value collected
        int c = capacity;                                                         // remaining capacity
        for (int i : idx) {                                                       // pick highest ratio first
            if (wt[i] <= c) {                                                     // whole item fits
                c -= wt[i];                                                       // reduce capacity
                res += val[i];                                                    // add full value
            } else {                                                              // item does not fit fully
                res += (double) val[i] * c / wt[i];                               // take only the fraction
                break;                                                            // bag is full, stop
            }                                                                     // end if-else
        }                                                                         // end loop
        return res;                                                               // maximum value
    }                                                                             // end method
}                                                                                 // end class

