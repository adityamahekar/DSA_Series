class SpecialQueue {
    Deque<Integer> dq = new ArrayDeque<>();     // Main queue for FIFO order
    Deque<Integer> smx = new ArrayDeque<>();    // Monotonic increasing deque for max
    Deque<Integer> smn = new ArrayDeque<>();    // Monotonic decreasing deque for min

    public SpecialQueue() {
        // Initialize empty deques for queue + min/max tracking
    }

    public void enqueue(int x) {
        // Insert element into the queue
        dq.offerLast(x);                                    // Add to main queue rear
        
        // Maintain smx: strictly increasing (front = max)
        while(!smx.isEmpty() && smx.peekLast() < x) 
            smx.pollLast();                                 // Remove smaller elements from rear
        smx.offerLast(x);                                   // Add current element
        
        // Maintain smn: strictly decreasing (front = min)
        while(!smn.isEmpty() && smn.peekLast() > x) 
            smn.pollLast();                                 // Remove larger elements from rear
        smn.offerLast(x);                                   // Add current element
    }

    public void dequeue() {
        // Remove element from the queue front
        if(!dq.isEmpty()) {
            if(smx.peekFirst() != null && smx.peekFirst().equals(dq.peekFirst()))  // If main queue front == max deque front
                smx.pollFirst();                                                    // Remove from max deque
            if(smn.peekFirst() != null && smn.peekFirst().equals(dq.peekFirst()))  // If main queue front == min deque front
                smn.pollFirst();                                                    // Remove from min deque
            dq.pollFirst();                                                         // Remove from main queue
        }
    }

    public int getFront() {
        // Get front element without removal
        return dq.peekFirst();          // Return main queue front
    }

    public int getMin() {
        // Get minimum element in O(1)
        return smn.peekFirst();         // Min always at front of monotonic decreasing deque
    }

    public int getMax() {
        // Get maximum element in O(1)
        return smx.peekFirst();         // Max always at front of monotonic increasing deque
    }
}

