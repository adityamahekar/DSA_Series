class SpecialStack {

    ArrayDeque<Integer> st = new ArrayDeque<>();                           // Main stack
    int min, t, res;                                                        // Min, temp, result

    public SpecialStack() {}

    public void push(int x) {
        if(st.isEmpty()){                                                   // First element
            min = x;
            st.push(x);
        }
        else if(x <= min){                                                  // New min found
            st.push(2*x - min);                                             // Push encoded value
            min = x;                                                         // Update min
        }
        else{
            st.push(x);                                                     // Push normally
        }
    }

    public void pop() {
        if(st.isEmpty()) return;                                            // Empty check
        int t = st.pop();                                                    // Pop top
        if(t <= min){                                                        // Was encoded
            res = min;                                                       // Save actual top
            min = 2*min - t;                                                 // Restore prev min
        }
    }

    public int peek() {
        if(st.isEmpty()) return -1;                                         // Empty check
        t = st.peek();                                                       // Get top
        return (t <= min) ? min : t;                                        // Decode if encoded
    }

    boolean isEmpty() {
        return st.isEmpty();                                                // Check if empty
    }

    public int getMin() {
        if(st.isEmpty()) return -1;                                         // Empty check
        return min;                                                          // Return current min
    }
}

