class SpecialStack {

    ArrayDeque<Integer> st = new ArrayDeque<>();                          // Main stack
    ArrayList<Integer> list = new ArrayList<>();                          // Min tracking list

    public SpecialStack() {}

    public void push(int x) {
        st.push(x);                                                        // Push to main stack
        list.add(x);                                                       // Add to list
    }

    public void pop() {
        if(st.isEmpty()){ return; }                                        // Empty check
        st.pop();                                                           // Pop main stack
        list.remove(list.size()-1);                                        // Remove last from list
    }

    public int peek() {
        if(st.isEmpty()){ return -1; }                                     // Empty check
        return st.peek();                                                   // Return top
    }

    boolean isEmpty() {
        return st.isEmpty();                                               // Check if empty
    }

    public int getMin() {
        if(st.isEmpty()){ return -1; }                                     // Empty check
        int min = Integer.MAX_VALUE;                                       // Init min
        for(int i: list){ min = Math.min(min, i); }                       // Scan entire list
        return min;                                                         // Return min
    }
}

