class SpecialStack {

    ArrayDeque<Integer> st = new ArrayDeque<>();                          // Main stack
    ArrayDeque<Integer> minSt = new ArrayDeque<>();                       // Min tracking stack

    public SpecialStack() {}

    public void push(int x) {
        st.push(x);                                                        // Push to main stack
        if(minSt.isEmpty() || x <= minSt.peek()){                         // Push to min stack if smaller or equal
            minSt.push(x);
        }
    }

    public void pop() {
        if(st.isEmpty()){ return; }                                        // Empty check
        int top = st.pop();                                                // Pop main stack
        if(top == minSt.peek()){                                           // If popped was min
            minSt.pop();                                                   // Remove from min stack too
        }
    }

    public int peek() {
        if(st.isEmpty()){ return -1; }                                     // Empty check
        return st.peek();                                                   // Return top
    }

    boolean isEmpty() {
        return st.isEmpty();                                               // Check if empty
    }

    public int getMin() {
        if(st.isEmpty()){ return -1; }                                     // Empty check
        return minSt.peek();                                               // Top of min stack is min
    }
}

