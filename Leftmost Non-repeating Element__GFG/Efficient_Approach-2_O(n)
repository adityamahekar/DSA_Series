
int nonRep(String Str){
    int count[] = new int[256];                         // Frequency array for all ASCII characters
    Arrays.fill(count,-1);                              // Initialize all positions with -1 (not seen)
    int res = Integer.MAX_VALUE;                        // Track minimum index among non-repeating

    for(int i=0;i<Str.length();i++){                    // Traverse string once
        if(count[Str.charAt(i)] == -1){                 // Character seen for first time
            count[Str.charAt(i)] = i;                   // Store its first occurrence index
        }
        else{                                           // Character seen before — it repeats
            count[Str.charAt(i)] = -2;                  // Mark as repeating with -2
        }
    }

    for(int i=0;i<256;i++){                             // Scan all ASCII positions
        if(count[i] > 0){                               // Value > 0 means seen exactly once
            res = Math.min(res, count[i]);              // Pick smallest index
        }
    }

    return (res == Integer.MAX_VALUE) ? -1 : res;       // Return result or -1 if none found
}

