
int nonRep(String Str){
    for(int i=0;i<Str.length();i++){                    // Pick each character one by one
        boolean flag = true;                            // Assume current character is non-repeating
        for(int j=0;j<Str.length();j++){                // Compare with every other character
            if(Str.charAt(i) == Str.charAt(j) && (i != j)){  // Same char at different index — repeats
                flag = false;                           // Mark as repeating
                break;                                  // No need to check further
            }
        }
        if(flag){                                       // flag still true — non-repeating found
            return i;                                   // Return index of first non-repeating character
        }
    }
    return -1;                                          // No non-repeating character found
}


