class Solution {
    
    boolean isDist(String s, int i, int j){       // check all chars unique in s[i..j]
        boolean visit[] = new boolean[256];        // 256 ASCII character tracker
        
        for(int k = i; k <= j; k++){              // loop from i to j
            if(visit[s.charAt(k)] == true){        // char already seen → not unique
                return false;                      // return false immediately
            }
            visit[s.charAt(k)] = true;             // mark char as visited
        }
        return true;                               // all chars are unique
    }
    
    public int longestUniqueSubstr(String s) {
        int res = 0;                               // stores maximum length found
        
        for(int i = 0; i < s.length(); i++){       // i = start index of substring
            for(int j = i; j < s.length(); j++){   // j = end index (fixed: start from i)
                if(isDist(s, i, j)){               // check if s[i..j] is unique
                    res = Math.max(res, j - i + 1);// update max if longer found
                }
            }
        }
        return res;                                // return longest unique length
    }
}

