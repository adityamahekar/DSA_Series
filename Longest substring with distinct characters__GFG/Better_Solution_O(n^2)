class Solution {
  public int longestUniqueSubstr(String s) {
    int n = s.length();                        // length of string
    int res = 0;                               // store max length

    for(int i = 0; i < n; i++){                // i = start index
        
        boolean visit[] = new boolean[256];    // 256 ASCII character tracker
        
        for(int j = i; j < n; j++){            // j = end index
            if(visit[s.charAt(j)] == true){    // char already seen → not unique
                break;                         // stop current substring
            }
            visit[s.charAt(j)] = true;         // mark char as visited
            res = Math.max(res, j - i + 1);    // update max length
        }
    }
    return res;                                // return longest unique length
  }
}

