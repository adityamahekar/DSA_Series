class Solution {
    int getKthFromLast(Node head, int k) {
        Node slow = head, fast = head;                                 // Two pointers at head
                                                                        
        for(int i = 0; i < k; i++) {                                   // Fast moves k steps ahead
            if(fast == null) return -1;                                // k > length
            fast = fast.next;
        }
                                                                        
        while(fast != null && fast.next != null) {                     // Move together
            slow = slow.next;                                          // Slow at kth from end when fast ends
            fast = fast.next;
        }
                                                                        
        return (slow != null) ? slow.data : -1;                        // Return result
    }
}

