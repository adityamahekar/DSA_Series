class Solution {
    int getKthFromLast(Node head, int k) {
        int count = 1;                                                 // Count total nodes
        Node curr = head;                                              // Start from head
        
        while(curr.next != null){                                      // Traverse to find length
            count++;                                                   // Increment count
            curr = curr.next;                                          // Move to next node
        }                                                             
        
        if(count < k){                                                 // Check if k > length
            return -1;                                                 // Return -1 if invalid
        }                                                             
        
        Node newCur = head;                                            // Reset pointer to head
        for(int i=1; i<=count-k; i++){                                 // Move (n-k) steps
            newCur = newCur.next;                                      // Reach kth from end
        }                                                             
        
        return newCur.data;                                            // Return kth node data
    }
}

