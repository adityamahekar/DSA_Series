class Solution {
    int getKthFromLast(Node head, int k) {
        if(head == null){                                              // Handle empty list
            return -1;
        }
        
        Node first = head, second = head;                              // Two pointers at head
        
        for(int i = 0; i < k; i++){                                    // First moves k steps ahead
            if(first == null){ return -1; }                            // k > length
            first = first.next;
        }
        
        while(first != null){                                          // Move together till first ends
            second = second.next;                                      // second at kth from end
            first = first.next;
        }
        
        return second.data;                                            // Return result
    }
}

