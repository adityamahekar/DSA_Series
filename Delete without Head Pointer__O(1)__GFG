/*
class Node
{
    int data ;
    Node next;
    Node(int d)
    {
        data = d;
        next = null;
    }
}
*/

class Solution {
    public void deleteNode(Node del_node) {
        
        // Copy data from next node to current node
        del_node.data = del_node.next.data;
        
        // Skip the next node (bypass it)
        del_node.next = del_node.next.next;
    }
}

//////////////////////// DRY RUN /////////////////////////////

CASE 1: Delete node with value 20

Input: 10 -> 20 -> 4 -> 30
             ^
          del_node


BEFORE DELETION:

[10|•] -> [20|•] -> [4|•] -> [30|•] -> null
          ^
       del_node


STEP 1: Copy next node's data

del_node.data = del_node.next.data
del_node.data = 4

[10|•] -> [4|•] -> [4|•] -> [30|•] -> null
          ^
       del_node
       (value changed from 20 to 4)


STEP 2: Skip the next node

del_node.next = del_node.next.next
del_node.next = 30

[10|•] -> [4|•] -----------> [30|•] -> null
          ^                    ^
       del_node            (orphaned node [4|•] will be garbage collected)


AFTER DELETION:

[10|•] -> [4|•] -> [30|•] -> null

Output: 10 -> 4 -> 30 ✓


