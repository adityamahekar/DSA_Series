class Solution {
    public ArrayList<Integer> bfs(ArrayList<ArrayList<Integer>> adj) {
     
        ArrayList<Integer> res = new ArrayList<Integer>();                  // stores bfs order
        
        boolean visit[] = new boolean[adj.size()];                          // tracks visited nodes
          
        Queue<Integer> q = new LinkedList<Integer>();                       // queue for level order
          
        visit[0] = true;                                                    // mark start visited
          
        q.add(0);                                                           // push start node
          
        while(!q.isEmpty()){                                                // run until queue empty
            int n = q.poll();                                               // take front node
              
            res.add(n);                                                     // add to result
            for(int j : adj.get(n)){                                        // go through neighbors
                  
                if(visit[j] == false){                                      // skip visited ones
                    visit[j] = true;                                        // mark visited early
                    q.add(j);                                               // push neighbor
                }
            }
              
        }
          
        return res;                                                         // return bfs order
    }
}

