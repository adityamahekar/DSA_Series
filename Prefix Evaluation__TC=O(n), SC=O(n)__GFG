class Solution {
    public int evaluatePrefix(String[] arr) {

        Stack<Integer> st = new Stack<>();               // Stack for operands
        
        for(int i = arr.length - 1; i >= 0; i--){          // Scan right to left
            String s = arr[i];
            
            if(s.equals("^") || 
               s.equals("*") || s.equals("/") ||
               s.equals("+") || s.equals("-") ){             // Operator found
                
                int a = st.pop();                               // Pop operand1
                int b = st.pop();                            // Pop operand2
                
                switch(s){                                         // Apply operation
                    case "*": st.push(a * b); break;                   // Multiply
                    case "+": st.push(a + b); break;                   // Add
                    case "-": st.push(a - b); break;                           // Subtract
                    case "^": st.push((int) Math.pow(a, b)); break;                    // Power
                    case "/": st.push((int) Math.floor((double) a / b)); break;           // Floor division
                }
            }
            else{                                               // Operand found
                st.push(Integer.parseInt(s));                  // Push number to stack
            }
        }
        return st.pop();                                       // Final result
    }
}

