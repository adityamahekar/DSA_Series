
class Solution {

    public boolean isSubSeq(String s1, String s2) {

        int n = s1.length(), m = s2.length();      // lengths of both strings

        int i = 0, j = 0;                          // pointers for s1 and s2

        while (i < n && j < m) {                   // traverse both strings

            if (s1.charAt(i) == s2.charAt(j)) {    // characters match
                i++;                               // move pointer in s1
                j++;                               // move pointer in s2
            } 
            else {
                j++;                               // move only in s2 to find next match
            }
        }

        if (i < n && j >= m) {                     // s1 not fully matched but s2 ended
            return false;                          // s1 is not a subsequence
        }

        return true;                               // all characters of s1 matched
    }
}

