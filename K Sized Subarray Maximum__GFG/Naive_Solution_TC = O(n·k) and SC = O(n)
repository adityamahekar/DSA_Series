class Solution {
    public ArrayList<Integer> maxOfSubarrays(int[] arr, int k) {
        ArrayList<Integer> list = new ArrayList<>();      // Result list for max values
        int n = arr.length;                               // Array length
        
        for(int i=0; i<n-k+1; i++){                       // Loop through all windows
            int mx = arr[i];                              // Initialize max with first element
            
            for(int j=i+1; j<i+k; j++){                   // Check remaining k-1 elements
                mx = Math.max(mx, arr[j]);                // Update max if larger found
            }
            
            list.add(mx);                                 // Add window max to result
        }
        
        return list;                                      // Return all window maximums
    }
}

