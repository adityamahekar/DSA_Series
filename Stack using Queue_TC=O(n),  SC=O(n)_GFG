class myStack {
    Queue<Integer> q = new LinkedList<>();      // Main queue for stack
    Queue<Integer> q2 = new LinkedList<>();     // Helper queue

    void push(int x) {
        while(!q.isEmpty()){                    // Move all q elements to q2
            q2.add(q.peek()); q.remove();
        }
        q.add(x);                               // Add new element to front
        while(!q2.isEmpty()){                   // Move back to q
            q.add(q2.peek()); q2.remove();
        }
    }

    void pop() {
        if(q.isEmpty()) return;                 // Empty check
        q.remove();                             // Remove front (top of stack)
    }

    int top() {
        if(q.isEmpty()) return -1;              // Empty → return -1
        return q.peek();                        // Return front element
    }

    int size() {
        return q.size();                        // Return queue size
    }
}

