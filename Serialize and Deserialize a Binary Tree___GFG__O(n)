class Node {
    int data;
    Node left;
    Node right;
    Node(int data) {
        this.data = data;
        left = right = null;
    }
}
class Solution {
    public ArrayList<Integer> serialize(Node root) {
        ArrayList<Integer> arr = new ArrayList<>();
        HELPserialize(root,arr);
        return arr;
    }

    public void HELPserialize(Node root, ArrayList<Integer> arr) {
        if(root == null){
            arr.add(null);                                     // null marker for missing child
            return;
        }
        arr.add(root.data);                                    // store current node value
        HELPserialize(root.left,arr);                          // recurse left subtree
        HELPserialize(root.right, arr);                        // recurse right subtree
    }

    int idx = 0;
    public Node deSerialize(ArrayList<Integer> arr) {
        if(idx == arr.size()){ return null; }                  // safety check for end of array

        Integer val = arr.get(idx);
        idx++;                                                 // move to next index

        if(val == null){ return null; }                        // null marker means no node here

        Node root = new Node(val);
        root.left = deSerialize(arr);                          // rebuild left subtree
        root.right = deSerialize(arr);                         // rebuild right subtree

        return root;
    }
};

