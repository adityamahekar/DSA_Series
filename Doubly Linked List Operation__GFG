class Node {
    int data;
    Node next;
    Node prev;

    Node(int data) {
        this.data = data;
        this.next = null;
        this.prev = null;
    }
}

class Main {
    public static void main(String[] args) {

        Node n1 = new Node(1);                    // create node 1
        Node n2 = new Node(2);                    // create node 2
        Node n3 = new Node(3);                    // create node 3

        Node head = n1;                           // head points to n1

        n1.next = n2;                             // 1 -> 2
        n2.prev = n1;                             // 1 <-> 2

        n2.next = n3;                             // 2 -> 3
        n3.prev = n2;                             // 2 <-> 3

        // print
        Node curr = head;
        while (curr != null) {
            System.out.print(curr.data + " -> ");
            curr = curr.next;
        }
        System.out.println("null");               // 1 -> 2 -> 3 -> null
    }
}


