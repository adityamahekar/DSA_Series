class Solution {

    int parent[];                                           // parent[i] = parent of node i; root points to itself

    int find(int x) {                                       // returns the root of the group that x belongs to

        if (parent[x] != x) parent[x] = find(parent[x]);   // go up; path compression flattens the tree
        return parent[x];                                  // x's root
    }

    public boolean isCycle(int V, int[][] edges) {

        parent = new int[V];                               // make the parent array

        for (int i = 0; i < V; i++) parent[i] = i;         // every node starts alone, as its own parent

        for (int[] e : edges) {                            // walk through each edge

            int ru = find(e[0]), rv = find(e[1]);          // find the root of both endpoints

            if (ru == rv) return true;                     // same root = same group = already connected = cycle

            parent[ru] = rv;                               // different groups, so merge them (union)
        }

        return false;                                      // no edge closed a loop, so no cycle
    }
}

