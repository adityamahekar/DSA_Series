class Solution {
    public Node reverse(Node head) {
        Node curr = head;
        Node temp = null;

        if (head == null || head.next == null) {    // edge case
            return head;
        }

        while (curr != null) {
            temp      = curr.prev;      // save prev
            curr.prev = curr.next;      // swap prev and next
            curr.next = temp;           // swap prev and next
            curr      = curr.prev;      // move forward (which is old next)
        }

        return temp.prev;               // temp.prev is new head
    }
}


//////////////////////// DRY RUN /////////////////////////////

    List  :  1 <-> 2 <-> 3 <-> NULL
    Goal  :  3 <-> 2 <-> 1 <-> NULL

    INITIAL:
        [.|-1-|.] <-> [.|-2-|.] <-> [.|-3-|.]
         curr                                    temp = null


    ITERATION 1: curr = [1]
        temp      = curr.prev = null
        curr.prev = curr.next = [2]
        curr.next = temp      = null
        curr      = curr.prev = [2]

        NULL <- [null|-1-|2] <-> [.|-2-|.] <-> [.|-3-|.]
                                  curr


    ITERATION 2: curr = [2]
        temp      = curr.prev = [1]
        curr.prev = curr.next = [3]
        curr.next = temp      = [1]
        curr      = curr.prev = [3]

        NULL <- [null|-1-|2] <-> [1|-2-|3] <-> [.|-3-|.]
                                                 curr


    ITERATION 3: curr = [3]
        temp      = curr.prev = [2]
        curr.prev = curr.next = null
        curr.next = temp      = [2]
        curr      = curr.prev = null

        NULL <- [null|-1-|2] <-> [1|-2-|3] <-> [2|-3-|null]
                                                              curr = null


    LOOP ENDS: curr = null

        temp = [2]
        return temp.prev = [3]   <-- new head ✅

    FINAL:
        [2|-3-|null] <-> [1|-2-|3] <-> [null|-1-|2]
         new head

        3 <-> 2 <-> 1 <-> NULL  ✅


    EDGE CASES:
        [null]        -> return null   ✅
        [null|-1-|null] -> return [1]  ✅


