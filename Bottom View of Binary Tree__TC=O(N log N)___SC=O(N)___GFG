/*
Definition for Node
class Node {
    int data;
    Node left;
    Node right;

    Node(int val) {
        data = val;
        left = right = null;
    }
}
*/

class Pair {
    Node node;                  // Tree node
    int hd;                     // Horizontal distance

    Pair(Node n, int h) {
        node = n;
        hd = h;
    }
}

class Solution {
    public ArrayList<Integer> bottomView(Node root) {

        ArrayList<Integer> ans = new ArrayList<>();       // Final answer

        if (root == null) return ans;                     // If tree is empty

        Queue<Pair> q = new LinkedList<>();               // BFS queue
        Map<Integer, Integer> mp = new TreeMap<>();       // HD -> node value

        q.add(new Pair(root, 0));                         // Root has HD 0

        while (!q.isEmpty()) {

            Pair p = q.poll();                            // Remove front pair

            Node curr = p.node;                           // Current node
            int hd = p.hd;                                // Current HD

            mp.put(hd, curr.data);                        // Update bottom node

            if (curr.left != null) {
                q.add(new Pair(curr.left, hd - 1));      // Left: HD - 1
            }

            if (curr.right != null) {
                q.add(new Pair(curr.right, hd + 1));     // Right: HD + 1
            }
        }

        ans.addAll(mp.values());                          // Get left to right

        return ans;                                       // Return answer
    }
}


