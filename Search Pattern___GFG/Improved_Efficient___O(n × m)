class Solution {
    ArrayList<Integer> search(String pat, String txt) {
        ArrayList<Integer> list = new ArrayList<>();

        int n = txt.length();                           // length of text
        int m = pat.length();                           // length of pattern

        for(int i = 0; i <= n - m;) {                  // i incremented manually
            int j;
            for(j = 0; j < m; j++) {                   // match pat with txt[i..i+m-1]
                if(pat.charAt(j) != txt.charAt(i+j)) { // mismatch found
                    break;                              // stop inner loop
                }
                if(j == m - 1) {                       // full match found
                    list.add(i);                        // store 0-based start index
                }
            }

            if(j == 0) {                               // mismatch at 1st char
                i++;                                   // move by 1
            } else if(j == m) {                        // full match
                i++;                                   // move by 1 for overlaps
            } else {                                   // partial mismatch
                i = i + j;                             // skip by j
            }
        }

        return list;                                    // return all match positions
    }
}

