class Solution {
    public int startStation(int[] gas, int[] cost) {

        int n = cost.length;                                                // Get number of stations
        
        for(int start = 0; start < n; start++){                             // Try each station as starting point
            int end = start;                                                // Current station position
            int cur_gas = 0;                                                // Current gas in tank
            
            while(true){
                cur_gas += (gas[end] - cost[end]);                          // Add gas at current station, subtract cost to next station
                
                if(cur_gas < 0) break;                                      // Ran out of gas, this start won't work
                
                end = (end + 1) % n;                                        // Move to next station (circular wrapping)
                
                if(start == end){
                    return start;                                           // Completed full circle, return starting station
                }
            }
        }
        
        return -1;                                                          // No valid starting station found
        
    }
}

