class Solution {
    public int startStation(int[] gas, int[] cost) {

        int n = cost.length;              // Total stations
        int start = 0;                    // Candidate starting station
        int prev_gas = 0, cur_gas = 0;    // Previous deficit, current balance
        
        for(int i = 0; i < n; i++){       // Traverse all stations once
               
            cur_gas += (gas[i] - cost[i]); // Add net gas at station i

            if(cur_gas < 0){               // Failed to reach station i+1
                prev_gas += cur_gas;       // Accumulate deficit
                start = i + 1;             // Try next station as start
                cur_gas = 0;               // Reset current balance
            } 
        }
        
       
        return ((cur_gas + prev_gas) >= 0) ? start : -1;                  // If total gas >= total cost, return start; else -1
    }
}

