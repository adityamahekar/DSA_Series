
public static String timeConversion(String s) {
    String mer  = s.substring(s.length() - 2);        // Extract AM/PM part
    int hr      = Integer.parseInt(s.substring(0, 2)); // Extract hour part
    String time = s.substring(2, s.length() - 2);     // Extract remaining time (:MM:SS)

    if (mer.equals("AM")) {                            // If time is AM
        if (hr == 12) {                                // 12AM → 00
            hr = 0;
        }
    } 
    else {                                             // If time is PM
        if (hr != 12) {                                // 1PM–11PM → add 12
            hr += 12;
        }
    }

    return ( (hr < 10 ? "0" + hr : hr) + time );       // Return formatted 24-hour time
}


