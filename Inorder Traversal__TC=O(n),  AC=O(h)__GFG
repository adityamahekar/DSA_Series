class Node {
    int data;                          // Stores the node's integer value
    Node left, right;                  // References to left and right children
    Node(int item){                    // Constructor to initialize node
        data = item;                   // Assigns the input value to data
        left = right = null;           // Sets both children to null initially
    }
}

class Solution {
    public ArrayList<Integer> inOrder(Node root) {

        ArrayList<Integer> list = new ArrayList<>();   // Creates list to store traversal result
        inOrder(root,list);                            // Calls helper method to fill the list
        return list;                                   // Returns the final inorder traversal
    }
    
    void inOrder(Node root,ArrayList<Integer> list){   // Recursive helper for inorder traversal
         
         if(root != null){                             // Base case: stop if node is null
            inOrder(root.left,list);                   // Recursively visit left subtree first
            list.add(root.data);                       // Add current node's data to list
            inOrder(root.right,list);                  // Recursively visit right subtree last
          }
    }
}

