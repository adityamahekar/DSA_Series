/*
class Node {
    int data;
    Node next;

    Node(int d) {
        data = d;
        next = null;
    }
}*/

class Solution {
                                                            // Helper: Reverse a linked list
    Node reverse(Node a) {
        Node prev = null, next = null;                      // Initialize pointers
        
        while (a != null) {                                 // Traverse until end
            next = a.next;                                  // Save next node
            a.next = prev;                                  // Reverse current pointer
            prev = a;                                       // Move prev to current
            a = next;                                       // Move current to next
        }
        
        return prev;                                        // Return new head of reversed list
    }
    
    public boolean isPalindrome(Node head) {
        
        if (head == null) { return true; }                      // Edge: empty list is palindrome
        
        Node slow = head, fast = head;                          // Initialize slow/fast pointers
        
        while (fast.next != null && fast.next.next != null) {  // While fast can move 2 steps
            slow = slow.next;                                   // Move slow by 1 step
            fast = fast.next.next;                              // Move fast by 2 steps
        }
                                                            // Now slow = middle (or end of first half for even length)
        
        Node rvs = reverse(slow.next);                      // Reverse second half starting from slow.next
        
        Node cur = head;                                    // Start from head of first half
        while (rvs != null) {                               // Traverse only reversed half
            if (cur.data != rvs.data) {
                return false;                               // Mismatch found → Not palindrome
            }
            
            cur = cur.next;                                 // Move first half pointer forward
            rvs = rvs.next;                                 // Move reversed half pointer forward
        }
        
        return true;                                        // All matched → Is palindrome
    }
}

//////////////////////// DRY RUN /////////////////////////////

Example 1: 1 -> 2 -> 1 -> 1 -> 2 -> 1  (Even length, Palindrome ✓)

--------------------------------- STEP 1: FIND MIDDLE ---------------------------------

Initial: slow=1, fast=1

Iteration 1:
  fast.next (2) != null ✓
  fast.next.next (1) != null ✓
  slow = 2, fast = 1 (third node)

Iteration 2:
  fast.next (1) != null ✓
  fast.next.next (2) != null ✓
  slow = 1 (third node), fast = 2 (fifth node)

Iteration 3:
  fast.next (1) != null ✓
  fast.next.next = null ✗
  Exit loop

Middle: slow = 1 (third node, end of first half)

List: 1 -> 2 -> 1 -> 1 -> 2 -> 1
                ↑
              slow


--------------------------------- STEP 2: REVERSE SECOND HALF ---------------------------------

slow.next = 1 (fourth node)
Reverse: 1 -> 2 -> 1

Before: 1 -> 2 -> 1
After:  1 -> 2 -> 1 (reversed)

rvs = 1 (last node becomes new head)

Full List Now:
1 -> 2 -> 1 -> 1 <- 2 <- 1
                ↑    ↑
              slow  rvs (reversed head)


--------------------------------- STEP 3: COMPARE ---------------------------------

cur = 1 (head), rvs = 1 (reversed head)

Iteration 1:
  cur.data (1) == rvs.data (1) ✓
  cur = 2, rvs = 2

Iteration 2:
  cur.data (2) == rvs.data (2) ✓
  cur = 1, rvs = 1

Iteration 3:
  cur.data (1) == rvs.data (1) ✓
  cur = 1, rvs = null

rvs = null → Exit loop

Return TRUE ✓


--------------------------------- VISUAL ---------------------------------

Original:     1 → 2 → 1 → 1 → 2 → 1
              ↑           ↑
            head        slow

After Reverse:
First Half:   1 → 2 → 1
Second Half:  1 ← 2 ← 1  (reversed)
              ↑
            rvs

Compare:      1=1, 2=2, 1=1  ✓


