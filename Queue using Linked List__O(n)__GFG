// Node class
class Node {
    int data;                    // Stores the data value
    Node next;                   // Points to next node

    Node(int new_data) {
        data = new_data;         // Assign data value
        next = null;             // Initialize next as null
    }
}

// Queue class using linked list
class myQueue {
    int c;                       // Tracks current size
    Node f, r;                   // f: front pointer, r: rear pointer

    public myQueue() {
        c = 0;                   // Initialize size to 0
        f = r = null;            // Both pointers null (empty queue)
    }

    public boolean isEmpty() {
        return r == null;        // Empty if rear is null
    }

    public void enqueue(int x) {
        Node t = new Node(x);    // Create new node with value x
        
        if (r == null) {         // First element case
            r = f = t;           // Both front & rear point to new node
        } else {
            r.next = t;          // Link current rear to new node
            r = t;               // Update rear to new node
        }
        c++;                     // Increment size
    }

    public void dequeue() {
        if (f == null) return;   // Empty queue, do nothing
        
        f = f.next;              // Move front to next node
        
        if (f == null) {         // Queue became empty
            r = null;            // Set rear to null
        }
        c--;                     // Decrement size
    }

    public int getFront() {
        if (f == null) return -1;// Empty queue return -1
        return f.data;           // Return front node data
    }

    public int size() {
        return c;                // Return current size counter
    }
}

