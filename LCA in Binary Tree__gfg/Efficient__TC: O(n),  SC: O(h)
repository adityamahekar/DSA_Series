/*
Definition for Node
class Node {
    int data;
    Node left;
    Node right;

    Node(int val) {
        this.data = val;
        left = right = null;
    }
}
*/                     // Node class definition

class Solution {
    Node lca(Node root, int n1, int n2) {
        
        if(root == null){
            return null;
        }
        
        if(root.data == n1 || root.data == n2){
            return root;
        }
        
        Node lca1 = lca(root.left, n1, n2);
        Node lca2 = lca(root.right, n1, n2);
        
        if(lca1 != null && lca2 != null){
            return root;          // current node is LCA
        }
        
        if(lca1 != null){
            return lca1;          // LCA in left subtree
        }
        else{
            return lca2;          // LCA in right subtree
        }
    }
}

//////////////////////// DRY RUN /////////////////////////////
Example 1:  

Tree:

      1
    /   \
   2     3
  / \   / \
 4   5 6   7

n1 = 4, n2 = 5 → LCA = 2.

