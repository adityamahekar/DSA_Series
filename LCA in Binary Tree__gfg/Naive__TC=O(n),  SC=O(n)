/*
Definition for Node
class Node {
    int data;
    Node left;
    Node right;

    Node(int val) {
        this.data = val;
        left = right = null;
    }
}
*/                     // Node class definition (for reference)

class Solution {
    
    boolean findPath(Node root, ArrayList<Node> p, int n){
        if(root == null){ return false; }                                   // base case
        
        p.add(root);                                                         // add current node
        
        if(root.data == n){ return true; }                                   // found
        
        if(findPath(root.left,p,n) || findPath(root.right,p,n)){ return true; } // search children
        
        p.remove(p.size()-1);                                                // backtrack
        
        return false;                                                         // not found
    }
    
    Node lca(Node root, int n1, int n2) {
        
        ArrayList<Node> path1 = new ArrayList<>();                           // path to n1
        ArrayList<Node> path2 = new ArrayList<>();                           // path to n2
        
        if(findPath(root,path1,n1) == false  ||  findPath(root,path2,n2) == false){
            return null;                                                     // one node not found
        }
        
        int i;
        for(i=0;i<path1.size() && i<path2.size();i++){
            if(path1.get(i) != path2.get(i)){
                break;                                                       // paths diverge
            }
        }
        
        return path1.get(i-1);                                                // last common node
    }
}                     

