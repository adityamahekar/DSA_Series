class Solution {

    int lps(String str, int n) {                                   // longest prefix-suffix of length n

        for (int len = n - 1; len > 0; len--) {                   // try lengths n-1 down to 1
            boolean flag = true;
            for (int i = 0; i < len; i++) {                        // compare prefix[0..len] vs suffix[n-len..n]
                if (str.charAt(i) != str.charAt(n - len + i)) {   // mismatch → try smaller len
                    flag = false;
                    break;
                }
            }
            if (flag) {
                return len;                                        // first match = longest → return
            }
        }
        return 0;                                                  // no prefix-suffix match found
    }

    int getLPSLength(String s) {
        int n = s.length();
        int res = 0;

        for (int i = 0; i < n; i++) {
            res = Math.max(res, lps(s, n));                        // get LPS for full string (i unused — bug)
        }

        return res;                                                // O(n^3) time  O(1) space
    }
}

