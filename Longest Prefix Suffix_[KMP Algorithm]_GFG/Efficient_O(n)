class Solution {
    int getLPSLength(String s) {
 
        int n = s.length();
        int lps[] = new int[n];                                    // lps[i] = length of longest prefix=suffix in s[0..i]
 
        int i = 1, len = 0;                                        // i=current  len=current prefix-suffix length
        lps[0] = 0;                                                // single char has no prefix=suffix
 
        while (i < n) {
 
            if (s.charAt(i) == s.charAt(len)) {                    // chars match → extend prefix-suffix
                len++;
                lps[i] = len;                                      // store length at i
                i++;
 
            } else {
 
                if (len == 0) {                                    // no prefix to fall back to
                    lps[i] = 0;                                    // no prefix=suffix at i
                    i++;
                } else {
                    len = lps[len - 1];                            // fall back: try shorter prefix-suffix
                }                                                  // do not increment i, retry with new len
            }
        }
 
        return lps[n - 1];                                         // TC=O(N)  SC=O(N)
    }
}

