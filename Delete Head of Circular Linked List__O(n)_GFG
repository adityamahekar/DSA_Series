/*
class Node {
    int data;
    Node next;
    Node(int x) {
        data = x;
        next = null;
    }
}
*/

class Solution {
    Node deleteNode(Node head, int key) {

        if (head == null || head.next == null) {    // empty or single node
            return null;
        }

        Node curr = head;

        while (curr.next != head) {                 // reach last node
            curr = curr.next;
        }

        curr.next = head.next;                      // last node skips head → points to new head

        return curr.next;                                // return new Head
    }
}


