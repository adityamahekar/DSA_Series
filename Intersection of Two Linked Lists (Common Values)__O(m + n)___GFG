/* structure of list Node:

class Node
{
    int data;
    Node next;

    Node(int a)
        {
            data = a;
            next = null;
        }
}

*/

class Solution {
    public Node findIntersection(Node head1, Node head2) {
        
        if (head1 == null || head2 == null) { return null; }    // Edge case: empty list
        
        HashSet<Integer> set = new HashSet<>();                 // Store values from list2
        Node curr = head2;
        
        while (curr != null) {                                  // Build HashSet from list2
            set.add(curr.data);                                 // Add value to set
            curr = curr.next;
        }
        
        Node cur2 = head1;
        Node s = null, st = null;                               // s = tail, st = head of result
        
        while (cur2 != null) {                                  // Traverse list1
                                                                  
            if (set.contains(cur2.data)) {                      // Common value found
                Node newNode = new Node(cur2.data);             // Create new node
                
                if (st == null) {                               // First common node
                    st = newNode;
                    s = newNode;
                } else {                                        // Append to result
                    s.next = newNode;
                    s = newNode;
                }
            }
            
            cur2 = cur2.next;
        }
        
        if (s != null) { s.next = null; }                       // Terminate result list
        
        return st;                                              // Return head of result
    }
}

