
int countDist(int arr[]) {
    int n   = arr.length;                // total number of elements
    int res = 0;                         // count of distinct elements

    for (int i = 0; i < n; i++) {
        boolean flag = false;            // assume current element is distinct

        for (int j = 0; j < i; j++) {
            if (arr[i] == arr[j]) {      // duplicate found in previous elements
                flag = true;             // mark as duplicate
                break;                   // no need to check further
            }
        }

        if (flag == false) {             // if not a duplicate
            res++;                       // count it as distinct
        }
    }                                    // fixed: return was inside for loop

    return res;                          // output => number of distinct elements
}


