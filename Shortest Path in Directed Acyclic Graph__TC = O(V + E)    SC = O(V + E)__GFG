class Solution {
    public ArrayList<Integer> shortestPath(int V, int[][] edges) {
        List<List<int[]>> adj = new ArrayList<>();                // adjacency list
        for (int i = 0; i < V; i++) adj.add(new ArrayList<>());   // empty lists
        int[] indeg = new int[V];                                 // in-degree count
        for (int[] e : edges) {
            adj.get(e[0]).add(new int[]{e[1], e[2]});             // u -> v with wt
            indeg[e[1]]++;                                        // count in-edge
        }
        Deque<Integer> q = new ArrayDeque<>();                    // topo queue
        for (int i = 0; i < V; i++) if (indeg[i] == 0) q.add(i);  // start nodes
        int INF = Integer.MAX_VALUE;                              // unreachable mark
        int[] dist = new int[V];
        Arrays.fill(dist, INF);                                   // all INF
        dist[0] = 0;                                              // source distance
        while (!q.isEmpty()) {
            int u = q.poll();                                     // topo order
            for (int[] e : adj.get(u)) {
                if (dist[u] != INF)                               // relax edge
                    dist[e[0]] = Math.min(dist[e[0]], dist[u] + e[1]);
                if (--indeg[e[0]] == 0) q.add(e[0]);              // next ready
            }
        }
        ArrayList<Integer> res = new ArrayList<>();
        for (int d : dist) res.add(d == INF ? -1 : d);            // INF -> -1
        return res;
    }
}

