/*
class Node {
    int data;
    Node left, right;

    public Node(int data){
        this.data = data;
    }
}
*/

class Solution {
    public static int findMax(Node root) {
        if(root == null){
            return Integer.MIN_VALUE;                                         // Base case: null returns MIN_VALUE
        }
        
        return  Math.max(root.data, Math.max(findMax(root.left),findMax(root.right)));            // Max of current, left subtree, right subtree
        
    }

    public static int findMin(Node root) {
        
        if(root == null){
            return Integer.MAX_VALUE;                                         // Base case: null returns MAX_VALUE
        }
        
        
        return  Math.min(root.data,Math.min(findMin(root.left),findMin(root.right)));    // Min of current, left subtree, right subtree
    }
}

//////////////////////// DRY RUN /////////////////////////////

Example: Binary Tree

       2
      / \
     7   5
      \   \
       6   9
      / \  /
     1  11 4

findMax(2):
  ├─ findMax(7):
  │   ├─ findMax(null) → MIN_VALUE
  │   ├─ findMax(6):
  │   │   ├─ findMax(1) → 1
  │   │   └─ findMax(11) → 11
  │   │   max(6, max(1,11)) = 11
  │   └─ max(7, max(MIN,11)) = 11
  ├─ findMax(5):
  │   ├─ findMax(null) → MIN_VALUE
  │   └─ findMax(9):
  │       └─ findMax(4) → 4
  │       max(9, max(MIN,4)) = 9
  └─ max(2, max(11,9)) = 11

Output: findMax = 11, findMin = 1

//////////////////////// QUESTION ////////////////////////////

Max and min element in Binary Tree
Given a Binary Tree, find maximum and minimum elements in it.

Example:

-----------------------------------------------------------

Input:
       2
      / \
     7   5
      \   \
       6   9
      / \  /
     1  11 4

Output: 11 1
Explanation: Max = 11, Min = 1

-----------------------------------------------------------

Input:
       6
      / \
     5   8
    /
   2

Output: 8 2
Explanation: Max = 8, Min = 2

-----------------------------------------------------------

Constraints:
• 1 <= number of nodes <= 10^5
• 1 <= data of a node <= 10^5

