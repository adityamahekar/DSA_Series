class Solution {
    public boolean isCyclic(int V, int[][] edges) {

        List<List<Integer>> adj = new ArrayList<>();     // will hold adjacency list for V nodes

        for(int i=0;i<V;i++)
            adj.add(new ArrayList<>());                  // give each node its own empty list

        int[] indeg = new int[V];                        // indeg[i] = incoming edges of i, start 0

        for(int[] e : edges){                            // read every edge [u, v]
            adj.get(e[0]).add(e[1]);                     // record u -> v in the graph
            indeg[e[1]]++;                               // v gained one incoming edge
        }

        Deque<Integer> q = new ArrayDeque<>();           // queue of nodes ready to remove

        for(int i=0;i<V;i++)
            if(indeg[i] == 0) q.add(i);                  // start with nodes that nothing points to

        int processed = 0;                               // how many nodes we've removed

        while(!q.isEmpty()){                             // keep going while nodes remain
            int u = q.poll();                            // take out a ready node
            processed++;                                 // count it as removed

            for(int v : adj.get(u)){                     // look at all u -> v edges
                if(--indeg[v] == 0)                      // edge gone; if v has no incoming left
                    q.add(v);                            // it's now ready too
            }
        }

        return processed != V;                           // removed all => no cycle; else cycle
    }
}

