class Solution {
    int getMiddle(Node head) {
        if (head == null) {                    // Empty list check
            return 0;                          // Return 0 (or -1 for error)
        }

        Node slow = head;                      // Slow pointer (moves 1 step)
        Node fast = head;                      // Fast pointer (moves 2 steps)

        // Move fast 2 steps, slow 1 step until fast reaches end
        while (fast != null && fast.next != null) {
            slow = slow.next;                  // Move slow by 1
            fast = fast.next.next;             // Move fast by 2
        }

        return slow.data;                      // Slow is at middle
    }
}


