class Solution {

    public int countNodes(Node root) {

        if (root == null) return 0;                         // Empty tree

        int lh = 0, rh = 0;                                // Left and right heights

        Node cur = root;                                   // Current node

        while (cur != null) {
            lh++;                                         // Count left height
            cur = cur.left;                                // Move left
        }

        cur = root;                                        // Reset to root

        while (cur != null) {
            rh++;                                         // Count right height
            cur = cur.right;                               // Move right
        }

        if (lh == rh) {
            return (int)Math.pow(2, lh) - 1;               // Perfect tree
        }

        return 1 + countNodes(root.left) + countNodes(root.right); // Count both subtrees
    }
}


