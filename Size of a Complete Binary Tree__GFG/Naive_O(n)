////////////////////////  CODE  ////////////////////////////

class Solution {
    public int countNodes(Node root) {                    // main function
        if (root == null) {                                // base case
            return 0;                                      // empty tree
        }
        else return 1 + countNodes(root.left)              // count left
                       + countNodes(root.right);            // count right
    }
}

////////////////////////  DRY RUN  ////////////////////////////

        1
       / \
      2   3
     / \  /
    4  5 6

countNodes(1)
 ├─ countNodes(2)
 │    ├─ countNodes(4) → 1
 │    └─ countNodes(5) → 1
 │    = 1+1+1 = 3
 ├─ countNodes(3)
 │    ├─ countNodes(6) → 1
 │    └─ countNodes(null) → 0
 │    = 1+1+0 = 2
 
Total = 1 + 3 + 2 = 6


